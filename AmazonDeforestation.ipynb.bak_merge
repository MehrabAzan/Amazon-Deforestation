   ],
   "source": [
    "# Slide figure: label frequency (log scale), deck style\n",
    "# Import dependency: import matplotlib as mpl\n",
    "import matplotlib as mpl\n",
    "# Import dependency: import matplotlib.patches as mpatches\n",
    "import matplotlib.patches as mpatches\n",
    "\n",
    "# Run this pipeline step\n",
    "deck_style()\n",
    "# Define function `deck_group`\n",
    "def deck_group(l):\n",
    "    # Conditional branch\n",
    "    if l in WEATHER_EDA: return \"weather\"\n",
    "    # Conditional branch\n",
    "    if l in DEFOR_EDA: return \"deforestation\"\n",
    "    # Conditional branch\n",
    "    if l in RARE_EDA: return \"other rare\"\n",
    "    # Return result to caller\n",
    "    return \"common land\"\n",
    "\n",
    "# Set `deckColor` = {\"weather\": DECK[\"sky\"], \"common land\": DECK[\"moss\"],\n",
    "deckColor = {\"weather\": DECK[\"sky\"], \"common land\": DECK[\"moss\"],\n",
    "             # Continuation of the multi-line expression\n",
    "             \"deforestation\": DECK[\"orange\"], \"other rare\": DECK[\"sand\"]}\n",
    "# Set `order` = sorted(labelsEda, key=lambda l: freqEda[Leda[l]])\n",
