    "# Check that this path exists\n",
    "expChans = {n: ch for n, ch in expChans.items() if os.path.exists(f\"{runs}/{n}.pt\")}\n",
    "# Set `targets` = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"agr…\n",
    "targets = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"agriculture\"]\n",
    "           # Continuation of the multi-line expression\n",
    "           if l in labels]\n",
    "# Conditional branch\n",
    "if not expChans:\n",
    "    # Stop with an error when setup/data is invalid\n",
    "    raise SystemExit(\"No ResNet checkpoints found. Train C (and D if TIFs) in 04 first.\")\n"
