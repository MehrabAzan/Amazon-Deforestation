   "source": [
    "# RGB / NIR / NDVI side-by-side for a clear forest+water+cleared chip (EDA bands slide)\n",
    "if metaEda.get(\"jpg_mode\"):\n",
    "    # Log to notebook output\n",
    "    print(\"JPG cache — skipping RGB/NIR/NDVI band panel.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Define `natural_rgb`\n",
    "    def natural_rgb(x, lo=2, hi=98, gamma=0.9):\n",
    "        # Execute: \"\"\"Per-chip percentile stretch of RGB for display only.\"\"\"\n",
    "        \"\"\"Per-chip percentile stretch of RGB for display only.\"\"\"\n",
    "        # Assign `img` ← rgb_chip(x)\n",
    "        img = rgb_chip(x)\n",
    "        # Assign `out` ← np.empty_like(img)\n",
    "        out = np.empty_like(img)\n",
    "        # Loop over items\n",
    "        for c in range(3):\n",
    "            # Assign `a, b` ← np.percentile(img[..., c], [lo, hi])\n",
    "            a, b = np.percentile(img[..., c], [lo, hi])\n",
    "            # Assign `out[..., c]` ← np.clip((img[..., c] - a) / (b - a + 1e-6), 0, 1)\n",
    "            out[..., c] = np.clip((img[..., c] - a) / (b - a + 1e-6), 0, 1)\n",
    "        # Return value to caller\n",
    "        return out ** gamma\n",
    "\n",
    "    # Define `nir_view`\n",
    "    def nir_view(x, lo=2, hi=98):\n",
    "        # Assign `\"\"\"Stretched NIR band (bright` ← strong vegetation reflectance).\"\"\"\n",
    "        \"\"\"Stretched NIR band (bright = strong vegetation reflectance).\"\"\"\n",
    "        # Assign `v` ← np.asarray(x[3], dtype=np.float32)\n",
    "        v = np.asarray(x[3], dtype=np.float32)\n",
    "        # Assign `a, b` ← np.percentile(v, [lo, hi])\n",
    "        a, b = np.percentile(v, [lo, hi])\n",
    "        # Return value to caller\n",
    "        return np.clip((v - a) / (b - a + 1e-6), 0, 1)\n",
    "\n",
    "    # Define `band_candidates`\n",
    "    def band_candidates():\n",
    "        # Assign `has` ← lambda l: Yeda[:, Leda[l]] == 1 if l in Leda else np.zeros(Neda, …\n",
    "        has = lambda l: Yeda[:, Leda[l]] == 1 if l in Leda else np.zeros(Neda, dtype=bool)\n",
    "        # Assign `cleared` ← has(\"agriculture\") | has(\"bare_ground\")\n",
    "        cleared = has(\"agriculture\") | has(\"bare_ground\")\n",
    "        # Return value to caller\n",
    "        return np.where(has(\"clear\") & has(\"primary\") & has(\"water\") & cleared & (Yeda.sum(1) <= 5))[0]\n",
    "\n",
    "    # Assign `cand` ← band_candidates()\n",
    "    cand = band_candidates()\n",
    "    # If-branch\n",
    "    if len(cand) == 0:\n",
    "        # Log to notebook output\n",
    "        print(\"No suitable band-panel chip found.\")\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Assign `rngEda` ← np.random.RandomState(0)\n",
    "        rngEda = np.random.RandomState(0)\n",
    "        # Assign `i` ← int(rngEda.choice(cand))\n",
    "        i = int(rngEda.choice(cand))\n",
    "        # Assign `x` ← Xeda[i]\n",
    "        x = Xeda[i]\n",
    "        # Assign `nd` ← ndvi_chip(x)\n",
    "        nd = ndvi_chip(x)\n",
    "        # Execute: deck_style()\n",
    "        deck_style()\n",
    "        # Assign `fig, axes` ← plt.subplots(1, 3, figsize=(15, 5.9))\n",
    "        fig, axes = plt.subplots(1, 3, figsize=(15, 5.9))\n",
    "        # Execute: axes[0].imshow(natural_rgb(x))\n",
    "        axes[0].imshow(natural_rgb(x))\n",
    "        # Assign `axes[1].imshow(nir_view(x), cmap` ← \"gray\")\n",
    "        axes[1].imshow(nir_view(x), cmap=\"gray\")\n",
    "        # Assign `lo, hi` ← np.percentile(nd, [2, 98])\n",
    "        lo, hi = np.percentile(nd, [2, 98])\n",
    "        # Assign `im` ← axes[2].imshow(nd, cmap=\"RdYlGn\", vmin=lo, vmax=hi)\n",
    "        im = axes[2].imshow(nd, cmap=\"RdYlGn\", vmin=lo, vmax=hi)\n",
    "        # Execute: axes[0].set_title(\"RGB\"); axes[1].set_title(\"Near-infrared\"); axes[2].set_title(\"NDVI\")\n",
    "        axes[0].set_title(\"RGB\"); axes[1].set_title(\"Near-infrared\"); axes[2].set_title(\"NDVI\")\n",
    "        # Loop over items\n",
    "        for ax in axes:\n",
    "            # Execute: ax.set_xticks([]); ax.set_yticks([])\n",
    "            ax.set_xticks([]); ax.set_yticks([])\n",
    "        # Assign `fig.suptitle(f\"{namesEda[i]}: RGB vs NIR vs NDVI\", color` ← DECK[\"text\"])\n",
    "        fig.suptitle(f\"{namesEda[i]}: RGB vs NIR vs NDVI\", color=DECK[\"text\"])\n",
    "        # Execute: save_eda(fig, \"eda_rgb_nir_ndvi.png\"); plt.show(); plt.close()\n",
    "        save_eda(fig, \"eda_rgb_nir_ndvi.png\"); plt.show(); plt.close()\n"
   ]
  },
