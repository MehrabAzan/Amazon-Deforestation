    "labels = json.load(open(f\"{cache}/labels.json\"))\n",
    "# Set `nLabels` = len(labels)\n",
    "nLabels = len(labels)\n",
    "\n",
    "# Define function `load_split`\n",
    "def load_split(idx, chans, chunk=2000):\n",
    "    # Run this pipeline step\n",
    "    \"\"\"Copy the chosen channels of the chosen tiles into RAM (float16).\"\"\"\n",
    "    # Set `out` = torch.empty((len(idx), len(chans), xAll.shape[2], xAll.shape[3]), dtyp…\n",
    "    out = torch.empty((len(idx), len(chans), xAll.shape[2], xAll.shape[3]), dtype=torch.float16)\n",
    "    # Iterate over this sequence\n",
    "    for s in range(0, len(idx), chunk):\n",
    "        # Set `part` = np.asarray(xAll[idx[s:s + chunk]])[:, chans]\n",
    "        part = np.asarray(xAll[idx[s:s + chunk]])[:, chans]\n",
    "        # Set `out[s:s + chunk]` = torch.from_numpy(part)\n",
    "        out[s:s + chunk] = torch.from_numpy(part)\n",
    "    # Return result to caller\n",
    "    return out\n"
