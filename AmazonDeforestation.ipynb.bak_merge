    "# Labels-per-chip, weather shares, and weather×land co-occurrence (EDA §6)\n",
    "perChip = Yeda.sum(1)  # number of positive labels on each chip\n",
    "# Assign `fig, axes` ← plt.subplots(1, 3, figsize=(17, 4.8), gridspec_kw={\"width_ratios\"…\n",
    "fig, axes = plt.subplots(1, 3, figsize=(17, 4.8), gridspec_kw={\"width_ratios\": [1, 0.8, 1.6]})\n",
    "\n",
    "# Panel 1: histogram of how many labels appear on each chip\n",
    "ks, cnt = np.unique(perChip, return_counts=True)\n",
    "# Assign `axes[0].bar(ks, cnt, color` ← GROUP_COLOR[\"common\"])\n",
    "axes[0].bar(ks, cnt, color=GROUP_COLOR[\"common\"])\n",
    "# Execute: axes[0].set_xlabel(\"labels on the chip\"); axes[0].set_ylabel(\"chips\"); axes[0].set_xticks(\n",
    "axes[0].set_xlabel(\"labels on the chip\"); axes[0].set_ylabel(\"chips\"); axes[0].set_xticks(ks)\n",
    "# Execute: axes[0].set_title(f\"Multi-label: {np.mean(perChip > 1):.0%} of chips have 2+ labels\")\n",
    "axes[0].set_title(f\"Multi-label: {np.mean(perChip > 1):.0%} of chips have 2+ labels\")\n",
    "\n",
    "# Panel 2: weather class counts (exactly one weather label per chip in Planet Amazon)\n",
    "wc = [Yeda[:, Leda[w]].sum() for w in WEATHER_EDA]\n",
    "# Assign `axes[1].bar(WEATHER_EDA, wc, color` ← GROUP_COLOR[\"weather\"])\n",
    "axes[1].bar(WEATHER_EDA, wc, color=GROUP_COLOR[\"weather\"])\n",
    "# Loop over items\n",
    "for x, v in enumerate(wc):\n",
    "    # Assign `axes[1].text(x, v, f\"{v / Neda:.0%}\", ha` ← \"center\", va=\"bottom\")\n",
    "    axes[1].text(x, v, f\"{v / Neda:.0%}\", ha=\"center\", va=\"bottom\")\n",
    "# Assign `axes[1].set_ylim(top` ← max(wc) * 1.15 if wc else 1)\n",
    "axes[1].set_ylim(top=max(wc) * 1.15 if wc else 1)\n",
    "# Assign `axes[1].set_title(\"Weather label shares\"); axes[1].tick_params(axis` ← \"x\", rotation=30)\n",
    "axes[1].set_title(\"Weather label shares\"); axes[1].tick_params(axis=\"x\", rotation=30)\n",
    "\n",
    "# Panel 3: for each weather, how often each land label appears (%)\n",
    "land = sorted(COMMON_EDA, key=lambda l: -freqEda[Leda[l]]) + sorted(RARE_EDA, key=lambda l: -freqEda[Leda[l]])\n",
    "# Assign `M` ← np.array([[Yeda[Yeda[:, Leda[w]] == 1, Leda[l]].mean() * 100 for …\n",
    "M = np.array([[Yeda[Yeda[:, Leda[w]] == 1, Leda[l]].mean() * 100 for l in land] for w in WEATHER_EDA]) if WEATHER_EDA and land else np.zeros((1, 1))\n",
    "# Assign `im` ← axes[2].imshow(M, cmap=\"Greens\", vmin=0, vmax=100, aspect=\"auto\")\n",
    "im = axes[2].imshow(M, cmap=\"Greens\", vmin=0, vmax=100, aspect=\"auto\")\n",
    "# Assign `axes[2].set_xticks(range(len(land))); axes[2].set_xticklabels(land, rotation` ← 60, ha=\"right\", fontsize=9)\n",
    "axes[2].set_xticks(range(len(land))); axes[2].set_xticklabels(land, rotation=60, ha=\"right\", fontsize=9)\n",
    "# Execute: axes[2].set_yticks(range(len(WEATHER_EDA))); axes[2].set_yticklabels(WEATHER_EDA)\n",
    "axes[2].set_yticks(range(len(WEATHER_EDA))); axes[2].set_yticklabels(WEATHER_EDA)\n",
    "# Execute: axes[2].set_title(\"% of weather chips that also have each land label\")\n",
    "axes[2].set_title(\"% of weather chips that also have each land label\")\n",
    "# Assign `fig.colorbar(im, ax` ← axes[2], fraction=0.046)\n",
    "fig.colorbar(im, ax=axes[2], fraction=0.046)\n",
    "# Execute: plt.tight_layout(); save_eda(fig, \"eda_weather_land.png\"); plt.show(); plt.close()\n",
    "plt.tight_layout(); save_eda(fig, \"eda_weather_land.png\"); plt.show(); plt.close()\n"
