   ],
   "source": [
    "# Head-to-head comparison questions (subset of Ladder_Evaluation QUESTIONS)\n",
    "if \"ORDER\" in dir() and ORDER:\n",
    "    # Assign `QUESTIONS` ← {\n",
    "    QUESTIONS = {\n",
    "        # Continues prior expression: \"Input channels (does NIR / NDVI help?)\": [\n",
    "        \"Input channels (does NIR / NDVI help?)\": [\n",
    "            # Continues prior expression: (\"scratch_none_rgb\", \"scratch_none_rgbnv\", \"Scratch CNN: + NIR + NDVI\")\n",
    "            (\"scratch_none_rgb\", \"scratch_none_rgbnv\", \"Scratch CNN: + NIR + NDVI\"),\n",
    "            # Continues prior expression: (\"r18_imnet_rgb\", \"r18_imnet_rgbn\", \"ResNet-18 ImageNet: + NIR\")\n",
    "            (\"r18_imnet_rgb\", \"r18_imnet_rgbn\", \"ResNet-18 ImageNet: + NIR\"),\n",
    "        ],\n",
    "        # Continues prior expression: \"Architecture and pretraining\": [\n",
    "        \"Architecture and pretraining\": [\n",
    "            # Continues prior expression: (\"scratch_none_rgb\", \"r18_none_rgb\", \"ResNet-18 vs scratch (both untrained)\")\n",
    "            (\"scratch_none_rgb\", \"r18_none_rgb\", \"ResNet-18 vs scratch (both untrained)\"),\n",
    "            # Continues prior expression: (\"r18_none_rgb\", \"r18_imnet_rgb\", \"ImageNet pretraining vs none\")\n",
    "            (\"r18_none_rgb\", \"r18_imnet_rgb\", \"ImageNet pretraining vs none\"),\n",
    "            # Continues prior expression: (\"r18_imnet_rgb\", \"r18_s2_rgb_s2rgb\", \"Sentinel-2 RGB-only vs ImageNet\")\n",
    "            (\"r18_imnet_rgb\", \"r18_s2_rgb_s2rgb\", \"Sentinel-2 RGB-only vs ImageNet\"),\n",
    "            # Continues prior expression: (\"r18_imnet_rgb\", \"effb0_imnet_rgb\", \"EfficientNet-B0 vs ResNet-18\")\n",
    "            (\"r18_imnet_rgb\", \"effb0_imnet_rgb\", \"EfficientNet-B0 vs ResNet-18\"),\n",
    "        ],\n",
    "        # Continues prior expression: \"Resolution / progressive\": [\n",
    "        \"Resolution / progressive\": [\n",
    "            # Continues prior expression: (\"r18_imnet_rgb\", \"r18_imnet_rgb_256\", \"256 px vs 128 px (ImageNet)\")\n",
    "            (\"r18_imnet_rgb\", \"r18_imnet_rgb_256\", \"256 px vs 128 px (ImageNet)\"),\n",
    "            # Continues prior expression: (\"r18_imnet_rgb\", \"r18_imnet_rgb_prog3\", \"Progressive 128→256 vs 128\")\n",
    "            (\"r18_imnet_rgb\", \"r18_imnet_rgb_prog3\", \"Progressive 128→256 vs 128\"),\n",
    "        ],\n",
    "    }\n",
    "\n",
    "    # Define `boot_defor`\n",
    "    def boot_defor(a, b, split=\"test\", n=N_BOOT):\n",
    "        # Execute: \"\"\"Bootstrap mean difference in deforestation F2 (B - A).\"\"\"\n",
    "        \"\"\"Bootstrap mean difference in deforestation F2 (B - A).\"\"\"\n",
    "        # If-branch\n",
    "        if a not in RUN or b not in RUN:\n",
    "            # Return value to caller\n",
    "            return None\n",
    "        # Assign `ya` ← RUN[a][\"ty\" if split == \"test\" else \"vy\"]\n",
    "        ya = RUN[a][\"ty\" if split == \"test\" else \"vy\"]\n",
    "        # Assign `pa` ← evaluate(a)[\"pred\"][split]\n",
    "        pa = evaluate(a)[\"pred\"][split]\n",
    "        # Assign `pb` ← evaluate(b)[\"pred\"][split]\n",
    "        pb = evaluate(b)[\"pred\"][split]\n",
    "        # Assign `rng` ← np.random.RandomState(0)\n",
    "        rng = np.random.RandomState(0)\n",
    "        # Assign `diffs` ← []\n",
    "        diffs = []\n",
    "        # Assign `idx` ← np.arange(len(ya))\n",
    "        idx = np.arange(len(ya))\n",
    "        # Loop over items\n",
    "        for _ in range(n):\n",
    "            # Assign `samp` ← rng.choice(idx, len(idx), replace=True)\n",
    "            samp = rng.choice(idx, len(idx), replace=True)\n",
    "            # Define `f2`\n",
    "            def f2(y, pred):\n",
    "                # Assign `yb, pr` ← y.astype(bool), pred.astype(bool)\n",
    "                yb, pr = y.astype(bool), pred.astype(bool)\n",
    "                # Assign `tp` ← (pr & yb).sum(0); fp = (pr & ~yb).sum(0); fn = (~pr & yb).sum(0)\n",
    "                tp = (pr & yb).sum(0); fp = (pr & ~yb).sum(0); fn = (~pr & yb).sum(0)\n",
    "                # Assign `f` ← 5 * tp / (5 * tp + 4 * fn + fp + 1e-9)\n",
    "                f = 5 * tp / (5 * tp + 4 * fn + fp + 1e-9)\n",
    "                # Return value to caller\n",
    "                return float(np.nanmean(f[DI])) if DI else float(\"nan\")\n",
    "            # Execute: diffs.append(f2(ya[samp], pb[samp]) - f2(ya[samp], pa[samp]))\n",
    "            diffs.append(f2(ya[samp], pb[samp]) - f2(ya[samp], pa[samp]))\n",
    "        # Assign `diffs` ← np.array(diffs)\n",
    "        diffs = np.array(diffs)\n",
    "        # Return value to caller\n",
    "        return dict(diff=float(diffs.mean()), ci_low=float(np.percentile(diffs, 2.5)), ci_high=float(np.percentile(diffs, 97.5)))\n",
    "\n",
    "    # Assign `rows` ← []\n",
    "    rows = []\n",
    "    # Loop over items\n",
    "    for q, pairs in QUESTIONS.items():\n",
    "        # Loop over items\n",
    "        for a, b, lab in pairs:\n",
    "            # If-branch\n",
    "            if a in RUN and b in RUN:\n",
    "                # Assign `bt` ← boot_defor(a, b)\n",
    "                bt = boot_defor(a, b)\n",
    "                # Assign `rows.append(dict(question` ← q, comparison=lab, **bt))\n",
    "                rows.append(dict(question=q, comparison=lab, **bt))\n",
    "                # Log to notebook output\n",
    "                print(f\"{lab}: Δdefor_F2={bt['diff']:+.3f} [{bt['ci_low']:+.3f}, {bt['ci_high']:+.3f}]\")\n",
    "            # Else branch\n",
    "            else:\n",
    "                # Log to notebook output\n",
    "                print(f\"skip (missing run): {lab}\")\n",
    "    # If-branch\n",
    "    if rows:\n",
    "        # Assign `pd.DataFrame(rows).to_csv(f\"{evalOut}/head_to_head.csv\", index` ← False)\n",
    "        pd.DataFrame(rows).to_csv(f\"{evalOut}/head_to_head.csv\", index=False)\n",
    "# Else branch\n",
    "else:\n",
    "    # Log to notebook output\n",
    "    print(\"No ladder runs — skip QUESTIONS comparisons.\")\n"
   ]
  },
