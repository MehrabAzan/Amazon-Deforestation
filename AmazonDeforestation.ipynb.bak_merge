    "jpgsQuick = glob.glob(f\"{raw}/**/train-jpg/*.jpg\", recursive=True)\n",
    "# Conditional branch\n",
    "if not jpgsQuick:\n",
    "    # Find matching files under the data root\n",
    "    jpgsQuick = glob.glob(f\"{raw}/**/*.jpg\", recursive=True)\n",
    "# Conditional branch\n",
    "if len(jpgsQuick) > 1000:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(f\"Local JPG dataset detected ({len(jpgsQuick)} files) — skipping any remote/Kaggle download.\")\n",
    "# Fallback when earlier conditions were false\n",
    "else:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"No large local JPG set found. Copy Kaggle train-jpg + train_v2.csv into AMAZON_RAW, then re-run.\")\n"
