    "]\n",
    "# Assign `group2` ← (\n",
    "group2 = (\n",
    "    # Continues prior expression: with_seeds(dict(arch=\"resnet18\", pretrain=\"none\", chans=RGB))\n",
    "    with_seeds(dict(arch=\"resnet18\", pretrain=\"none\", chans=RGB))\n",
    "  # Continues prior expression: + [dict(arch=\"resnet18\", pretrain=\"none\", chans=RGBN)\n",
    "  + [dict(arch=\"resnet18\", pretrain=\"none\", chans=RGBN),\n",
    "     # Continues prior expression: dict(arch=\"resnet18\", pretrain=\"none\", chans=RGB, epochs=28)\n",
    "     dict(arch=\"resnet18\", pretrain=\"none\", chans=RGB, epochs=28),\n",
    "     # Continues prior expression: dict(arch=\"resnet18\", pretrain=\"none\", chans=RGBN, epochs=28)]\n",
    "     dict(arch=\"resnet18\", pretrain=\"none\", chans=RGBN, epochs=28)]\n",
    ")\n",
    "# Assign `IMNET` ← dict(arch=\"resnet18\", pretrain=\"imagenet\", chans=RGB)\n",
    "IMNET = dict(arch=\"resnet18\", pretrain=\"imagenet\", chans=RGB)\n",
    "# Assign `group3` ← (\n",
    "group3 = (\n",
    "    # Continues prior expression: with_seeds(IMNET)\n",
    "    with_seeds(IMNET)\n",
    "  # Continues prior expression: + [dict(IMNET, chans=RGBN)\n",
