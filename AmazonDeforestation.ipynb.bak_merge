    "# Set `hasBoth` = \"C_resnet_rgb\" in data and \"D_resnet_nir_ndvi\" in data\n",
    "hasBoth = \"C_resnet_rgb\" in data and \"D_resnet_nir_ndvi\" in data\n",
    "# Iterate over this sequence\n",
    "for lab in targets:\n",
    "    # Set `j` = labels.index(lab)\n",
    "    j = labels.index(lab)\n",
    "    # Set `truth` = y[:, j] == 1\n",
    "    truth = y[:, j] == 1\n",
    "    # Conditional branch\n",
    "    if hasBoth:\n",
    "        # Set `cData, dData` = data[\"C_resnet_rgb\"], data[\"D_resnet_nir_ndvi\"]\n",
    "        cData, dData = data[\"C_resnet_rgb\"], data[\"D_resnet_nir_ndvi\"]\n",
    "        # Set `fixed` = np.where(truth & ~cData[\"pred\"][:, j] & dData[\"pred\"][:, j])[0][:3]\n",
    "        fixed = np.where(truth & ~cData[\"pred\"][:, j] & dData[\"pred\"][:, j])[0][:3]\n",
    "        # Set `both` = np.where(truth & ~cData[\"pred\"][:, j] & ~dData[\"pred\"][:, j])[0][:2]\n",
    "        both = np.where(truth & ~cData[\"pred\"][:, j] & ~dData[\"pred\"][:, j])[0][:2]\n",
    "        # Set `picks` = [(\"D fixes C\", i) for i in fixed] + [(\"both miss\", i) for i in both]\n",
    "        picks = [(\"D fixes C\", i) for i in fixed] + [(\"both miss\", i) for i in both]\n",
    "        # Set `modelNames` = [\"C_resnet_rgb\", \"D_resnet_nir_ndvi\"]\n",
    "        modelNames = [\"C_resnet_rgb\", \"D_resnet_nir_ndvi\"]\n",
    "        # Set `titles` = [\"RGB-only model\", \"NIR+NDVI model\"]\n",
    "        titles = [\"RGB-only model\", \"NIR+NDVI model\"]\n",
    "        # Set `ncols` = 3\n",
    "        ncols = 3\n",
    "    # Fallback when earlier conditions were false\n",
    "    else:\n",
    "        # Set `n0` = ref\n",
    "        n0 = ref\n",
    "        # Set `miss` = np.where(truth & ~data[n0][\"pred\"][:, j])[0][:3]\n",
    "        miss = np.where(truth & ~data[n0][\"pred\"][:, j])[0][:3]\n",
    "        # Set `hit` = np.where(truth & data[n0][\"pred\"][:, j])[0][:2]\n",
    "        hit = np.where(truth & data[n0][\"pred\"][:, j])[0][:2]\n",
    "        # Set `picks` = [(\"model miss\", i) for i in miss] + [(\"model hit\", i) for i in hit]\n",
    "        picks = [(\"model miss\", i) for i in miss] + [(\"model hit\", i) for i in hit]\n",
    "        # Set `modelNames` = [n0]\n",
    "        modelNames = [n0]\n",
    "        # Set `titles` = [\"RGB Grad-CAM\"]\n",
    "        titles = [\"RGB Grad-CAM\"]\n",
    "        # Set `ncols` = 2\n",
    "        ncols = 2\n",
    "    # Conditional branch\n",
    "    if not picks:\n",
    "        # Skip to next loop iteration\n",
    "        continue\n",
    "    # Create matplotlib figure/axes\n",
    "    fig, axes = plt.subplots(len(picks), ncols, figsize=(3 * ncols, 2.7 * len(picks)),\n",
    "                             # Keyword/field `squeeze`\n",
    "                             squeeze=False)\n",
    "    # Iterate over this sequence\n",
    "    for r, (kind, i) in enumerate(picks):\n",
    "        # Set `gi` = int(testIdx[i])\n",
    "        gi = int(testIdx[i])\n",
    "        # Set `base` = rgb_view(gi)\n",
    "        base = rgb_view(gi)\n",
    "        # Draw or configure plot elements\n",
    "        axes[r][0].imshow(base)\n",
    "        # Draw or configure plot elements\n",
    "        axes[r][0].set_title(f\"{kind} ({lab})\", fontsize=8)\n",
    "        # Iterate over this sequence\n",
    "        for c, n in enumerate(modelNames, start=1):\n",
    "            # Set `cam` = gradcam(models[n], prep(gi, n), j)\n",
    "            cam = gradcam(models[n], prep(gi, n), j)\n",
    "            # Draw or configure plot elements\n",
    "            axes[r][c].imshow(base)\n",
    "            # Draw or configure plot elements\n",
    "            axes[r][c].imshow(cam, cmap=\"jet\", alpha=0.45)\n",
    "            # Draw or configure plot elements\n",
    "            axes[r][c].set_title(titles[c - 1], fontsize=8)\n",
    "        # Iterate over this sequence\n",
    "        for a in axes[r]:\n",
    "            # Run this pipeline step\n",
    "            a.axis(\"off\")\n",
    "    # Run this pipeline step\n",
    "    plt.tight_layout()\n",
    "    # Save figure PNG for the report/deck\n",
    "    plt.savefig(f\"{figDir}/fig_gradcam_{lab}.png\", dpi=200)\n",
    "    # Render the figure in the notebook UI\n",
