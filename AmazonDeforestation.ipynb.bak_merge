    "# Load NumPy array (often memory-mapped)\n",
    "sp = np.load(f\"{cache}/splits.npz\")\n",
    "# Set `tr, va, te` = sp[\"train\"], sp[\"val\"], sp[\"test\"]\n",
    "tr, va, te = sp[\"train\"], sp[\"val\"], sp[\"test\"]\n",
    "# Load NumPy array (often memory-mapped)\n",
    "st = np.load(f\"{cache}/stats.npz\")\n",
    "# Set `chanMean, chanStd` = st[\"mean\"], st[\"std\"]\n",
