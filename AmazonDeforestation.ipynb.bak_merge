    "    run(name, cfg)\n",
    "    # Load JSON metadata from disk\n",
    "    hist = json.load(open(f\"{runs}/{name}_history.json\"))\n",
    "    # Print status / metrics to the notebook\n",
    "    say(f\"[{name}] best val macro F2@0.2 = {max(h['val_macro_f2_at_0_2'] for h in hist):.4f}\")\n"
   ]
