    "# Define function `block`\n",
    "def block(i, o):\n",
    "    # Return result to caller\n",
    "    return nn.Sequential(\n",
    "        # Keyword/field `nn.Conv2d(i, o, 3, padding`\n",
    "        nn.Conv2d(i, o, 3, padding=1, bias=False), nn.BatchNorm2d(o), nn.ReLU(True),\n",
    "        # Keyword/field `nn.Conv2d(o, o, 3, padding`\n",
    "        nn.Conv2d(o, o, 3, padding=1, bias=False), nn.BatchNorm2d(o), nn.ReLU(True),\n",
    "        # Continuation of the multi-line expression\n",
    "        nn.MaxPool2d(2))\n",
    "\n",
    "# Define class `ScratchCNN`\n",
    "class ScratchCNN(nn.Module):\n",
    "    # Define function `__init__`\n",
    "    def __init__(self, cIn, nOut):\n",
    "        # Run this pipeline step\n",
    "        super().__init__()\n",
    "        # Set `self.features` = nn.Sequential(block(cIn, 32), block(32, 64)\n",
    "        self.features = nn.Sequential(block(cIn, 32), block(32, 64),\n",
    "                                      # Continuation of the multi-line expression\n",
    "                                      block(64, 128), block(128, 256))\n",
    "        # Set `self.head` = nn.Sequential(nn.AdaptiveAvgPool2d(1), nn.Flatten()\n",
    "        self.head = nn.Sequential(nn.AdaptiveAvgPool2d(1), nn.Flatten(),\n",
    "                                  # Continuation of the multi-line expression\n",
    "                                  nn.Dropout(0.3), nn.Linear(256, nOut))\n",
    "    # Define function `forward`\n",
    "    def forward(self, x):\n",
    "        # Return result to caller\n",
    "        return self.head(self.features(x))\n",
    "\n",
    "# Define function `build_model`\n",
    "def build_model(arch, cIn, pretrained=True):\n",
    "    # Conditional branch\n",
    "    if arch == \"scratch\":\n",
    "        # Return result to caller\n",
    "        return ScratchCNN(cIn, nLabels)\n",
    "    # Set `w` = torchvision.models.ResNet34_Weights.IMAGENET1K_V1 if pretrained else N…\n",
    "    w = torchvision.models.ResNet34_Weights.IMAGENET1K_V1 if pretrained else None\n",
    "    # Set `m` = torchvision.models.resnet34(weights=w)\n",
    "    m = torchvision.models.resnet34(weights=w)\n",
    "    # Set `old` = m.conv1\n",
    "    old = m.conv1\n",
    "    # Set `new` = nn.Conv2d(cIn, 64, 7, 2, 3, bias=False)\n",
    "    new = nn.Conv2d(cIn, 64, 7, 2, 3, bias=False)\n",
    "    # Enter a context manager (auto-closes resources)\n",
    "    with torch.no_grad():\n",
    "        # Conditional branch\n",
    "        if w is not None:\n",
    "            # Set `new.weight[:, :3]` = old.weight\n",
    "            new.weight[:, :3] = old.weight\n",
    "            # Conditional branch\n",
    "            if cIn > 3:\n",
    "                # Set `extra` = old.weight.mean(1, keepdim=True).repeat(1, cIn - 3, 1, 1)\n",
    "                extra = old.weight.mean(1, keepdim=True).repeat(1, cIn - 3, 1, 1)\n",
    "                # Set `new.weight[:, 3:]` = extra\n",
    "                new.weight[:, 3:] = extra\n",
    "    # Set `m.conv1` = new\n",
    "    m.conv1 = new\n",
    "    # Set `m.fc` = nn.Linear(m.fc.in_features, nLabels)\n",
    "    m.fc = nn.Linear(m.fc.in_features, nLabels)\n",
    "    # Return result to caller\n",
    "    return m\n"
   ]
  },
