   "outputs": [],
   "source": [
    "# Define function `dihedral`\n",
    "def dihedral(x, k):\n",
    "    # Conditional branch\n",
    "    if k >= 4:\n",
    "        # Set `x` = x.flip(3)\n",
    "        x = x.flip(3)\n",
    "    # Return result to caller\n",
    "    return torch.rot90(x, k % 4, (2, 3))\n",
    "\n",
    "# Define function `augment`\n",
    "def augment(x):\n",
    "    # Set `ks` = torch.randint(0, 8, (x.size(0),), device=x.device)\n",
    "    ks = torch.randint(0, 8, (x.size(0),), device=x.device)\n",
    "    # Set `out` = torch.empty_like(x)\n",
    "    out = torch.empty_like(x)\n",
    "    # Iterate over this sequence\n",
    "    for k in range(8):\n",
    "        # Set `m` = ks == k\n",
    "        m = ks == k\n",
    "        # Conditional branch\n",
    "        if m.any():\n",
    "            # Set `out[m]` = dihedral(x[m], k)\n",
    "            out[m] = dihedral(x[m], k)\n",
    "    # Return result to caller\n",
    "    return out\n",
    "\n",
    "# Decorator for the function below\n",
    "@torch.no_grad()\n",
    "# Define function `predict`\n",
    "def predict(model, xs, mean, std, tta=False, bs=256):\n",
    "    # Run this pipeline step\n",
    "    model.eval()\n",
    "    # Set `probs` = []\n",
    "    probs = []\n",
    "    # Iterate over this sequence\n",
    "    for s in range(0, len(xs), bs):\n",
    "        # Set `xb` = (xs[s:s + bs].to(device).float() - mean) / std\n",
    "        xb = (xs[s:s + bs].to(device).float() - mean) / std\n",
    "        # Set `views` = range(8) if tta else [0]\n",
    "        views = range(8) if tta else [0]\n",
    "        # Set `p` = 0\n",
    "        p = 0\n",
    "        # Iterate over this sequence\n",
    "        for k in views:\n",
    "            # Enter a context manager (auto-closes resources)\n",
    "            with torch.autocast(\"cuda\", dtype=torch.float16, enabled=device == \"cuda\"):\n",
    "                # Set `p` = p + torch.sigmoid(model(dihedral(xb, k)).float())\n",
    "                p = p + torch.sigmoid(model(dihedral(xb, k)).float())\n",
    "        # Run this pipeline step\n",
    "        probs.append((p / len(views)).cpu().numpy())\n",
    "    # Return result to caller\n",
    "    return np.concatenate(probs)\n",
    "\n",
    "# Define function `macro_f2`\n",
    "def macro_f2(y, p, thr=0.2):\n",
    "    # Return result to caller\n",
    "    return fbeta_score(y, (p >= thr).astype(int), beta=2, average=\"macro\", zero_division=0)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "aa037f01",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define function `run`\n",
    "def run(name, cfg):\n",
    "    # Run this pipeline step\n",
    "    seed_all(seed)\n",
    "    # Set `chans` = cfg[\"chans\"]\n",
    "    chans = cfg[\"chans\"]\n",
    "    # Set `mean` = torch.tensor(chanMean[chans], device=device).view(1, -1, 1, 1).float()\n",
    "    mean = torch.tensor(chanMean[chans], device=device).view(1, -1, 1, 1).float()\n",
    "    # Set `std` = torch.tensor(chanStd[chans], device=device).view(1, -1, 1, 1).float()\n",
    "    std = torch.tensor(chanStd[chans], device=device).view(1, -1, 1, 1).float()\n",
    "    # Set `xtr, xva, xte` = (load_split(i, chans) for i in (tr, va, te))\n",
    "    xtr, xva, xte = (load_split(i, chans) for i in (tr, va, te))\n",
    "    # Set `ytr, yva, yte` = y[tr].astype(np.float32), y[va], y[te]\n",
    "    ytr, yva, yte = y[tr].astype(np.float32), y[va], y[te]\n",
    "    # Set `ytrT` = torch.from_numpy(ytr)\n",
    "    ytrT = torch.from_numpy(ytr)\n",
    "    # Set `model` = build_model(cfg[\"arch\"], len(chans), pretrained=cfg.get(\"pretrained\", …\n",
    "    model = build_model(cfg[\"arch\"], len(chans), pretrained=cfg.get(\"pretrained\", True)).to(device)\n",
    "    # Set `freq` = ytr.mean(0)\n",
    "    freq = ytr.mean(0)\n",
    "    # Clamp values into a valid range\n",
    "    posW = torch.tensor(np.clip(np.sqrt((1 - freq) / np.maximum(freq, 1e-6)), 1, 10), dtype=torch.float32)\n",
    "    # Set `crit` = nn.BCEWithLogitsLoss(pos_weight=posW.to(device))\n",
    "    crit = nn.BCEWithLogitsLoss(pos_weight=posW.to(device))\n",
    "    # Set `steps` = int(np.ceil(len(tr) / batch))\n",
    "    steps = int(np.ceil(len(tr) / batch))\n",
    "    # Set `opt` = torch.optim.AdamW(model.parameters(), lr=cfg[\"lr\"], weight_decay=1e-4)\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=cfg[\"lr\"], weight_decay=1e-4)\n",
    "    # Set `sched` = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=cfg[\"lr\"], epochs=epoc…\n",
    "    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=cfg[\"lr\"], epochs=epochs,\n",
    "                                                # Keyword/field `steps_per_epoch`\n",
    "                                                steps_per_epoch=steps)\n",
    "    # CUDA / GPU related call\n",
    "    scaler = torch.amp.GradScaler(\"cuda\", enabled=device == \"cuda\")\n",
    "    # Set `w` = (ytr * (np.maximum(freq, 1e-6)[None, :] ** -0.5)).max(1)\n",
    "    w = (ytr * (np.maximum(freq, 1e-6)[None, :] ** -0.5)).max(1)\n",
    "    # Set `w` = torch.from_numpy(w / w.sum())\n",
    "    w = torch.from_numpy(w / w.sum())\n",
    "    # Set `hist, best, bestState` = [], -1.0, None\n",
    "    hist, best, bestState = [], -1.0, None\n",
    "    # Iterate over this sequence\n",
    "    for ep in range(epochs):\n",
    "        # Run this pipeline step\n",
    "        model.train()\n",
    "        # Set `t0` = time.time()\n",
    "        t0 = time.time()\n",
    "        # Set `order` = torch.multinomial(w, len(tr), replacement=True) if oversample \\\n",
    "        order = torch.multinomial(w, len(tr), replacement=True) if oversample \\\n",
    "            else torch.randperm(len(tr))  # shuffle all train indices when not oversampling\n",
    "            # Run this pipeline step\n",
    "        # Set `tot` = 0.0\n",
    "        tot = 0.0\n",
    "        # Iterate over this sequence\n",
    "        for s in range(0, len(order), batch):\n",
    "            # Set `b` = order[s:s + batch]\n",
    "            b = order[s:s + batch]\n",
    "            # Set `xb` = (xtr[b].to(device).float() - mean) / std\n",
    "            xb = (xtr[b].to(device).float() - mean) / std\n",
    "            # Set `yb` = ytrT[b].to(device)\n",
    "            yb = ytrT[b].to(device)\n",
    "            # Set `xb` = augment(xb)\n",
    "            xb = augment(xb)\n",
    "            # Reset gradients before the next step\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "            # Enter a context manager (auto-closes resources)\n",
    "            with torch.autocast(\"cuda\", dtype=torch.float16, enabled=device == \"cuda\"):\n",
    "                # Set `logits` = model(xb)\n",
    "                logits = model(xb)\n",
    "            # Set `loss` = crit(logits.float(), yb)\n",
    "            loss = crit(logits.float(), yb)\n",
    "            # Backpropagate loss gradients\n",
    "            scaler.scale(loss).backward()\n",
    "            # Apply one optimizer/scheduler step\n",
    "            scaler.step(opt)\n",
    "            # Run this pipeline step\n",
    "            scaler.update()\n",
    "            # Apply one optimizer/scheduler step\n",
    "            sched.step()\n",
    "            # Set `tot +` = loss.item() * len(b)\n",
    "            tot += loss.item() * len(b)\n",
    "        # Set `pv` = predict(model, xva, mean, std)\n",
    "        pv = predict(model, xva, mean, std)\n",
    "        # Set `f2` = macro_f2(yva, pv)\n",
    "        f2 = macro_f2(yva, pv)\n",
    "        # Set `hist.append(dict(epoch` = ep + 1, train_loss=tot / len(tr), val_macro_f2_at_0_2=f2))\n",
    "        hist.append(dict(epoch=ep + 1, train_loss=tot / len(tr), val_macro_f2_at_0_2=f2))\n",
    "        # Print status / metrics to the notebook\n",
    "        print(f\"[{name}] epoch {ep + 1}/{epochs} loss {tot / len(tr):.4f} \"\n",
    "              # String entry in this collection\n",
    "              f\"val macroF2@0.2 {f2:.4f} ({time.time() - t0:.0f}s)\")\n",
    "        # Conditional branch\n",
    "        if f2 > best:\n",
    "            # Set `best` = f2\n",
    "            best = f2\n",
    "            # Set `bestState` = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n",
    "            bestState = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n",
    "    # Run this pipeline step\n",
    "    model.load_state_dict(bestState)\n",
    "    # Run this pipeline step\n",
    "    torch.save(bestState, f\"{out}/{name}.pt\")\n",
    "    # Set `pv, pt` = predict(model, xva, mean, std, tta), predict(model, xte, mean, std, tt…\n",
    "    pv, pt = predict(model, xva, mean, std, tta), predict(model, xte, mean, std, tta)\n",
    "    # Persist NumPy array(s) to the cache\n",
    "    np.savez_compressed(f\"{out}/{name}_probs.npz\", val_probs=pv, val_y=yva, test_probs=pt,\n",
    "                        # Keyword/field `test_y`\n",
    "                        test_y=yte, val_idx=va, test_idx=te)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump(hist, open(f\"{out}/{name}_history.json\", \"w\"))\n",
    "    # Conditional branch\n",
    "    if globals().get(\"makeFigs\", True):\n",
    "        # Create matplotlib figure/axes\n",
    "        fig, ax = plt.subplots(1, 2, figsize=(10, 3.5))\n",
    "        # Run this pipeline step\n",
    "        ax[0].plot([h[\"train_loss\"] for h in hist])\n",
    "        # Run this pipeline step\n",
    "        ax[0].set_title(\"Training loss\")\n",
    "        # Run this pipeline step\n",
    "        ax[1].plot([h[\"val_macro_f2_at_0_2\"] for h in hist])\n",
    "        # Run this pipeline step\n",
    "        ax[1].set_title(\"Validation macro F2 (threshold 0.2)\")\n",
    "        # Iterate over this sequence\n",
    "        for a in ax:\n",
    "            # Run this pipeline step\n",
    "            a.set_xlabel(\"epoch\")\n",
    "        # Run this pipeline step\n",
    "        plt.tight_layout()\n",
