      "                      comparison  mean_macro_F2_diff  ci_low  ci_high         verdict\n",
      "NDVI effect, scratch CNN (B - A)             -0.0117 -0.0265   0.0032 not significant\n",
      "     NDVI effect, ResNet (D - C)             -0.0304 -0.0482  -0.0110      clear loss\n",
      "  Transfer learning, RGB (C - A)              0.0301  0.0111   0.0493      clear gain\n",
      "Transfer learning, +NDVI (D - B)              0.0118 -0.0049   0.0286 not significant\n"
     ]
    }
   ],
   "source": [
    "# Read path/config from environment\n",
    "root = os.environ.get(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")\n",
    "\n",
    "# Fix RNG seed for reproducibility\n",
    "rng = np.random.RandomState(0)\n",
    "\n",
    "# Define function `boot_diff`\n",
    "def boot_diff(a, b, reps=1000):\n",
    "    # Set `y, pa, pb` = store[a][\"y\"], store[a][\"pred\"], store[b][\"pred\"]\n",
    "    y, pa, pb = store[a][\"y\"], store[a][\"pred\"], store[b][\"pred\"]\n",
    "    # Set `diffs` = []\n",
    "    diffs = []\n",
    "    # Iterate over this sequence\n",
    "    for _ in range(reps):\n",
    "        # Set `i` = rng.randint(0, len(y), len(y))\n",
    "        i = rng.randint(0, len(y), len(y))\n",
    "        # Run this pipeline step\n",
    "        diffs.append(f2_per_label(y[i], pb[i]).mean() - f2_per_label(y[i], pa[i]).mean())\n",
    "    # Return result to caller\n",
    "    return np.mean(diffs), np.percentile(diffs, 2.5), np.percentile(diffs, 97.5)\n",
    "\n",
    "# Set `pairs` = [\n",
    "pairs = [\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"A_scratch_rgb\", \"B_scratch_nir_ndvi\", \"NDVI effect, scratch CNN (B - A)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"C_resnet_rgb\", \"D_resnet_nir_ndvi\", \"NDVI effect, ResNet (D - C)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"A_scratch_rgb\", \"C_resnet_rgb\", \"Transfer learning, RGB (C - A)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"B_scratch_nir_ndvi\", \"D_resnet_nir_ndvi\", \"Transfer learning, +NDVI (D - B)\"),\n",
    "]\n",
    "# Set `bootRows` = []\n",
    "bootRows = []\n",
    "# Iterate over this sequence\n",
    "for a, b, label in pairs:\n",
    "    # Conditional branch\n",
    "    if a in store and b in store:\n",
    "        # Set `m, lo, hi` = boot_diff(a, b)\n",
    "        m, lo, hi = boot_diff(a, b)\n",
    "        # Set `verdict` = \"clear gain\" if lo > 0 else (\"clear loss\" if hi < 0 else \"not signific…\n",
    "        verdict = \"clear gain\" if lo > 0 else (\"clear loss\" if hi < 0 else \"not significant\")\n",
    "        # Run this pipeline step\n",
    "        bootRows.append(dict(\n",
    "            # Keyword/field `comparison`\n",
    "            comparison=label, mean_macro_F2_diff=m, ci_low=lo, ci_high=hi, verdict=verdict\n",
    "        # Continuation of the multi-line expression\n",
    "        ))\n",
    "# Set `boot` = pd.DataFrame(bootRows)\n",
    "boot = pd.DataFrame(bootRows)\n",
    "# Conditional branch\n",
    "if len(boot):\n",
    "    # Ensure output directory exists\n",
    "    os.makedirs(f\"{root}/results\", exist_ok=True)\n",
    "    # Export a metrics/label table as CSV\n",
    "    boot.to_csv(f\"{root}/results/bootstrap_pairs.csv\", index=False)\n",
    "    # Export a metrics/label table as CSV\n",
    "    boot.to_csv(f\"{figDir}/bootstrap_differences.csv\", index=False)\n",
    "    # Print status / metrics to the notebook\n",
    "    print(boot.round(4).to_string(index=False))\n"
   ]
  },
