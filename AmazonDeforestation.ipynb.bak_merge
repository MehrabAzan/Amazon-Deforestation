   ],
   "source": [
    "# Oversampling effect on rare deforestation labels (EDA § slide figure)\n",
    "trEda = spEda[\"train\"]\n",
    "# Assign `ytr` ← Yeda[trEda].astype(float)\n",
    "ytr = Yeda[trEda].astype(float)\n",
    "# Label frequency in the training split\n",
    "f = ytr.mean(0).clip(1e-6, None)\n",
    "# Per-chip sampling weight = max over its labels of f ** -0.5 (rarest label wins)\n",
    "w = (ytr * f ** -0.5).max(1)\n",
    "# Assign `p` ← w / w.sum()\n",
    "p = w / w.sum()\n",
    "# Expected positive counts per epoch with vs without oversampling\n",
    "seenWith = len(trEda) * (ytr * p[:, None]).sum(0)\n",
    "# Assign `seenWithout` ← ytr.sum(0)\n",
    "seenWithout = ytr.sum(0)\n",
    "# Assign `posW` ← np.clip(np.sqrt((1 - f) / f), 1, 10)\n",
    "posW = np.clip(np.sqrt((1 - f) / f), 1, 10)\n",
    "\n",
    "# Assign `show` ← [l for l in DEFOR_EDA if l in Leda]\n",
    "show = [l for l in DEFOR_EDA if l in Leda]\n",
    "# If-branch\n",
    "if not show:\n",
    "    # Log to notebook output\n",
    "    print(\"No deforestation labels found — skip oversampling figure.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Execute: deck_style()\n",
    "    deck_style()\n",
    "    # Assign `nice` ← [{\"slash_burn\": \"slash-and-burn\", \"artisinal_mine\": \"artisanal mi…\n",
    "    nice = [{\"slash_burn\": \"slash-and-burn\", \"artisinal_mine\": \"artisanal mine\"}.get(l, l.replace(\"_\", \" \")) for l in show]\n",
    "    # Assign `yy` ← np.arange(len(show))[::-1]\n",
    "    yy = np.arange(len(show))[::-1]\n",
    "    # Assign `fig, ax` ← plt.subplots(figsize=(11, 5.6))\n",
    "    fig, ax = plt.subplots(figsize=(11, 5.6))\n",
    "    # Assign `b0` ← ax.barh(yy + 0.2, [seenWithout[Leda[l]] for l in show], 0.38, col…\n",
    "    b0 = ax.barh(yy + 0.2, [seenWithout[Leda[l]] for l in show], 0.38, color=DECK[\"muted\"], label=\"without oversampling\")\n",
    "    # Assign `b1` ← ax.barh(yy - 0.2, [seenWith[Leda[l]] for l in show], 0.38, color=…\n",
    "    b1 = ax.barh(yy - 0.2, [seenWith[Leda[l]] for l in show], 0.38, color=DECK[\"orange\"], label=\"with oversampling\")\n",
    "    # Loop over items\n",
    "    for bars in (b0, b1):\n",
    "        # Loop over items\n",
    "        for b in bars:\n",
    "            # Execute: ax.text(b.get_width() + 40, b.get_y() + b.get_height() / 2, f\"{b.get_width():,.0f}\"\n",
    "            ax.text(b.get_width() + 40, b.get_y() + b.get_height() / 2, f\"{b.get_width():,.0f}\",\n",
    "                    # Field/kwarg `va`\n",
    "                    va=\"center\", fontsize=14, color=DECK[\"text\"])\n",
    "    # Execute: ax.set_yticks(yy); ax.set_yticklabels(nice)\n",
    "    ax.set_yticks(yy); ax.set_yticklabels(nice)\n",
    "    # Execute: ax.set_xlabel(\"expected training chips with the label, per epoch\")\n",
    "    ax.set_xlabel(\"expected training chips with the label, per epoch\")\n",
    "    # Assign `ax.legend(frameon` ← False); ax.set_title(\"Oversampling lifts rare deforestation label…\n",
    "    ax.legend(frameon=False); ax.set_title(\"Oversampling lifts rare deforestation labels each epoch\")\n",
    "    # Execute: save_eda(fig, \"eda_oversampling_defor.png\"); plt.show(); plt.close()\n",
    "    save_eda(fig, \"eda_oversampling_defor.png\"); plt.show(); plt.close()\n",
    "    # Log to notebook output\n",
    "    print(\"pos_weight (loss) for deforestation labels:\", {l: float(posW[Leda[l]]) for l in show})\n"
   ]
  },
