   ],
   "source": [
    "# Ladder eval deck figures (rare-per-split, seed spread, forest plots, look-alike)\n",
    "# Needs ladder evaluation cells above (ORDER, RUN, evaluate, seed_groups, boot_defor, DEFOR/DI).\n",
    "# Conditional branch\n",
    "if \"ORDER\" not in dir() or not ORDER:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"No ladder runs loaded — skip eval deck figures.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Import dependency: import matplotlib as mpl\n",
    "    import matplotlib as mpl\n",
    "    # Conditional branch\n",
    "    if \"DECK\" not in dir():\n",
    "        # Set `DECK` = dict(bg=\"\n",
    "        DECK = dict(bg=\"#15301B\", panel=\"#1F4426\", text=\"#E8EDE3\", muted=\"#A9BBA3\",\n",
    "                    # Keyword/field `grid`\n",
    "                    grid=\"#3A5E40\", moss=\"#97BC62\", orange=\"#E8923A\", sky=\"#8FB8C9\", sand=\"#D8C9A3\")\n",
    "    # Set `niceEv` = {\"selective_logging\": \"selective logging\", \"slash_burn\": ...\n",
    "    niceEv = {\"selective_logging\": \"selective logging\", \"slash_burn\": \"slash-and-burn\",\n",
    "              # Continuation of the multi-line expression\n",
    "              \"artisinal_mine\": \"artisanal mine\", \"conventional_mine\": \"conventional mine\",\n",
    "              # Run this pipeline step\n",
    "              \"blooming\": \"blooming\"}\n",
    "    # Run this pipeline step\n",
    "    mpl.rcParams.update({\"figure.facecolor\": DECK[\"bg\"], \"axes.facecolor\": DECK[\"bg\"],\n",
    "                         # Continuation of the multi-line expression\n",
    "                         \"savefig.facecolor\": DECK[\"bg\"], \"text.color\": DECK[\"text\"],\n",
    "                         # Run this pipeline step\n",
    "                         \"axes.labelcolor\": DECK[\"text\"], \"xtick.color\": DECK[\"text\"],\n",
    "                         # Run this pipeline step\n",
    "                         \"ytick.color\": DECK[\"text\"], \"axes.titlecolor\": DECK[\"text\"],\n",
    "                         # Run this pipeline step\n",
    "                         \"axes.spines.top\": False, \"axes.spines.right\": False,\n",
    "                         # Run this pipeline step\n",
    "                         \"savefig.dpi\": 200, \"savefig.bbox\": \"tight\", \"font.size\": 14})\n",
    "\n",
    "    # Rare deforestation labels in each split\n",
    "    yAll = np.load(f\"{evalCache}/Y.npy\")\n",
    "    # Set `spl` = np.load(f\"{evalCache}/splits.npz\")\n",
    "    spl = np.load(f\"{evalCache}/splits.npz\")\n",
    "    # Conditional branch\n",
    "    if DI:\n",
    "        # Set `counts` = {s: yAll[spl[s]][:, DI].sum(0) for s in (\"train\", \"val\", ...\n",
    "        counts = {s: yAll[spl[s]][:, DI].sum(0) for s in (\"train\", \"val\", \"test\")}\n",
    "        # Assign `fig, ax` ← plt.subplots(figsize=(11, 5.4))\n",
    "        fig, ax = plt.subplots(figsize=(11, 5.4))\n",
    "        # Set `x` = np.arange(len(DEFOR)); w = 0.27\n",
    "        x = np.arange(len(DEFOR)); w = 0.27\n",
    "        # Iterate over this sequence\n",
    "        for k, (s, col, name) in enumerate([(\"train\", DECK[\"muted\"], \"train\"),\n",
    "                                            # Continuation of the multi-line expression\n",
    "                                            (\"val\", DECK[\"moss\"], \"validation\"),\n",
    "                                            # Continuation of the multi-line expression\n",
    "                                            (\"test\", DECK[\"orange\"], \"test\")]):\n",
    "            # Set `bars` = ax.bar(x + (k - 1) * w, counts[s], w, color=col, label=f\"...\n",
    "            bars = ax.bar(x + (k - 1) * w, counts[s], w, color=col, label=f\"{name} ({len(spl[s]):,} chips)\")\n",
    "            # Iterate over this sequence\n",
    "            for b in bars:\n",
    "                # Draw or configure plot elements\n",
    "                ax.text(b.get_x() + b.get_width() / 2, b.get_height() + 3, f\"{int(b.get_height())}\",\n",
    "                        # Keyword/field `ha`\n",
    "                        ha=\"center\", va=\"bottom\", fontsize=14, color=DECK[\"text\"])\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xticks(x); ax.set_xticklabels([niceEv.get(l, l) for l in DEFOR], fontsize=15)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_ylabel(\"chips with this label\"); ax.legend(frameon=False, loc=\"upper right\")\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_ylim(top=max(counts[\"train\"]) * 1.18); ax.grid(axis=\"y\", alpha=0.4); ax.set_axisbelow(True)\n",
    "        # Save, show, and close the figure\n",
    "        fig.tight_layout(); fig.savefig(f\"{evalOut}/deck_10a_rare_per_split.png\"); plt.show(); plt.close()\n",
    "\n",
    "    # Seed spread on test deforestation F2\n",
    "    seedNames = {\"r18_none_rgb\": \"ResNet-18, no pretraining\", \"r18_imnet_rgb\": \"ResNet-18, ImageNet\",\n",
    "                 # Continuation of the multi-line expression\n",
    "                 \"r18_s2_rgb_s2rgb\": \"ResNet-18, Sentinel-2 RGB\", \"r18_imnet_rgb_256\": \"ImageNet, 256 px\",\n",
    "                 # Run this pipeline step\n",
    "                 \"r18_imnet_rgb_prog3\": \"ImageNet, progressive\"}\n",
    "    # Set `groups` = seed_groups() if \"seed_groups\" in dir() else {}\n",
    "    groups = seed_groups() if \"seed_groups\" in dir() else {}\n",
    "    # Set `plotted` = [(b, lab) for b, lab in seedNames.items() if b in groups]\n",
    "    plotted = [(b, lab) for b, lab in seedNames.items() if b in groups]\n",
    "    # Conditional branch\n",
    "    if plotted:\n",
    "        # Assign `fig, ax` ← plt.subplots(figsize=(11, 4.8))\n",
    "        fig, ax = plt.subplots(figsize=(11, 4.8))\n",
    "        # Iterate over this sequence\n",
    "        for k, (base, label) in enumerate(plotted):\n",
    "            # Set `v` = np.array([evaluate(r)[\"test\"][\"defor_F2\"] for r in groups...\n",
    "            v = np.array([evaluate(r)[\"test\"][\"defor_F2\"] for r in groups[base]])\n",
    "            # Set `y` = len(plotted) - 1 - k\n",
    "            y = len(plotted) - 1 - k\n",
    "            # Draw or configure plot elements\n",
    "            ax.plot([v.min(), v.max()], [y, y], color=DECK[\"muted\"], lw=3, solid_capstyle=\"round\")\n",
    "            # Draw or configure plot elements\n",
    "            ax.scatter(v, [y] * len(v), s=110, color=DECK[\"orange\"], zorder=3, edgecolor=DECK[\"bg\"])\n",
    "            # Draw or configure plot elements\n",
    "            ax.scatter([v.mean()], [y], marker=\"|\", s=500, color=DECK[\"text\"], zorder=4)\n",
    "            # Draw or configure plot elements\n",
    "            ax.text(v.max() + 0.006, y, f\"{v.mean():.3f} ± {v.std(ddof=1):.3f}\", va=\"center\", fontsize=14)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_yticks(range(len(plotted))); ax.set_yticklabels([lab for _, lab in plotted][::-1], fontsize=15)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xlabel(\"test deforestation F2 (dots = seeds; tick = mean)\")\n",
    "        # Set `lo, hi` = ax.get_xlim(); ax.set_xlim(lo, hi + 0.04)\n",
    "        lo, hi = ax.get_xlim(); ax.set_xlim(lo, hi + 0.04)\n",
    "        # Draw or configure plot elements\n",
    "        ax.grid(axis=\"x\", alpha=0.4); ax.set_axisbelow(True)\n",
    "        # Save, show, and close the figure\n",
    "        fig.tight_layout(); fig.savefig(f\"{evalOut}/deck_10b_seed_spread.png\"); plt.show(); plt.close()\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Print status / metrics to the notebook\n",
    "        print(\"No multi-seed groups for seed-spread figure.\")\n",
    "\n",
    "    # Forest plots via boot_defor\n",
    "    def forest_plot(rows, fname):\n",
    "        # Set `items` = [r for r in rows if isinstance(r, str) or (isinstance(r, ...\n",
    "        items = [r for r in rows if isinstance(r, str) or (isinstance(r, tuple) and r[0] in RUN and r[1] in RUN)]\n",
    "        # Conditional branch\n",
    "        if not items:\n",
    "            # Print status / metrics to the notebook\n",
    "            print(\"No rows available for\", fname); return\n",
    "        # Assign `fig, ax` ← plt.subplots(figsize=(11, 0.55 * len(items) + 1.2))\n",
    "        fig, ax = plt.subplots(figsize=(11, 0.55 * len(items) + 1.2))\n",
    "        # Set `y` = len(items) - 1\n",
    "        y = len(items) - 1\n",
    "        # Set `ylabels, yticks` = [], []\n",
    "        ylabels, yticks = [], []\n",
    "        # Iterate over this sequence\n",
    "        for r in items:\n",
    "            # Conditional branch\n",
    "            if isinstance(r, str):\n",
    "                # Draw or configure plot elements\n",
    "                ax.text(-0.02, y, r, transform=ax.get_yaxis_transform(), ha=\"right\", va=\"center\",\n",
    "                        # Keyword/field `fontsize`\n",
    "                        fontsize=15, fontweight=\"bold\", color=DECK[\"orange\"])\n",
    "                # Update `y` -= 1; continue\n",
    "                y -= 1; continue\n",
    "            # Set `a, b, label` = r\n",
    "            a, b, label = r\n",
    "            # Set `bt` = boot_defor(a, b, \"test\")\n",
    "            bt = boot_defor(a, b, \"test\")\n",
    "            # Conditional branch\n",
    "            if bt is None:\n",
    "                # Update `y` -= 1; continue\n",
    "                y -= 1; continue\n",
    "            # Set `col` = DECK[\"moss\"] if bt[\"ci_low\"] > 0 else DECK[\"orange\"] if b...\n",
    "            col = DECK[\"moss\"] if bt[\"ci_low\"] > 0 else DECK[\"orange\"] if bt[\"ci_high\"] < 0 else DECK[\"muted\"]\n",
    "            # Draw or configure plot elements\n",
    "            ax.plot([bt[\"ci_low\"], bt[\"ci_high\"]], [y, y], color=col, lw=3, solid_capstyle=\"round\")\n",
    "            # Draw or configure plot elements\n",
    "            ax.scatter([bt[\"diff\"]], [y], s=110, color=col, zorder=3, edgecolor=DECK[\"bg\"])\n",
    "            # Draw or configure plot elements\n",
    "            ax.text(bt[\"ci_high\"] + 0.006, y, f\"{bt['diff']:+.3f}\", va=\"center\", fontsize=14, color=col)\n",
    "            # Run this pipeline step\n",
    "            ylabels.append(label); yticks.append(y); y -= 1\n",
    "        # Draw or configure plot elements\n",
    "        ax.axvline(0, color=DECK[\"text\"], lw=1, ls=\"--\", alpha=0.7)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_yticks(yticks); ax.set_yticklabels(ylabels, fontsize=14)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_ylim(-0.7, len(items) - 0.3)\n",
    "        # Set `lo, hi` = ax.get_xlim(); ax.set_xlim(lo, hi + 0.03)\n",
    "        lo, hi = ax.get_xlim(); ax.set_xlim(lo, hi + 0.03)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xlabel(\"change in test deforestation F2 (95% interval)\")\n",
    "        # Draw or configure plot elements\n",
    "        ax.grid(axis=\"x\", alpha=0.4); ax.set_axisbelow(True)\n",
    "        # Save, show, and close the figure\n",
    "        fig.tight_layout(); fig.savefig(f\"{evalOut}/{fname}\"); plt.show(); plt.close()\n",
    "\n",
    "    # Run this pipeline step\n",
    "    forest_plot([\n",
    "        # Continuation of the multi-line expression\n",
    "        \"Pretraining\",\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_none_rgb\", \"r18_imnet_rgb\", \"ImageNet vs. no pretraining\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_none_rgb_e28\", \"r18_imnet_rgb\", \"ImageNet vs. no pretraining at 28 epochs\"),\n",
    "        # Run this pipeline step\n",
    "        \"Training length\",\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"scratch_none_rgb\", \"scratch_none_rgb_e28\", \"Scratch CNN: 28 vs. 14 epochs\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_none_rgb\", \"r18_none_rgb_e28\", \"ResNet-18 untrained: 28 vs. 14 epochs\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    ], \"deck_11_what_matters.png\")\n",
    "    # Run this pipeline step\n",
    "    forest_plot([\n",
    "        # Continuation of the multi-line expression\n",
    "        \"Near-infrared\",\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"scratch_none_rgb\", \"scratch_none_rgbnv\", \"Scratch CNN: + NIR + NDVI\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_none_rgb\", \"r18_none_rgbn\", \"ResNet-18 untrained: + NIR\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_imnet_rgb\", \"r18_imnet_rgbn\", \"ResNet-18 ImageNet: + NIR\"),\n",
    "        # Run this pipeline step\n",
    "        \"Resolution and architecture\",\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_imnet_rgb\", \"r18_imnet_rgb_256\", \"256 px vs. 128 px\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_imnet_rgb\", \"r18_imnet_rgb_prog3\", \"Progressive vs. 128 px\"),\n",
    "        # Continuation of the multi-line expression\n",
    "        (\"r18_imnet_rgb\", \"effb0_imnet_rgb\", \"EfficientNet-B0 vs. ResNet-18\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    ], \"deck_12_what_didnt.png\")\n",
    "\n",
    "    # Look-alike pair: selective_logging missed as blooming vs true blooming\n",
    "    if FINAL in RUN and \"selective_logging\" in labelsEv and \"blooming\" in labelsEv:\n",
    "        # Set `pair` = None\n",
    "        pair = None  # or (loggingIdx, bloomingIdx)\n",
    "        # Set `xLook` = np.load(f\"{evalCache}/X.npy\", mmap_mode=\"r\")\n",
    "        xLook = np.load(f\"{evalCache}/X.npy\", mmap_mode=\"r\")\n",
    "        # Set `r` = RUN[FINAL]; ty, tp, tidx = r[\"ty\"].astype(bool), r[\"tp\"],...\n",
    "        r = RUN[FINAL]; ty, tp, tidx = r[\"ty\"].astype(bool), r[\"tp\"], r[\"tidx\"]\n",
    "        # Set `pred` = evaluate(FINAL)[\"pred\"][\"test\"].astype(bool)\n",
    "        pred = evaluate(FINAL)[\"pred\"][\"test\"].astype(bool)\n",
    "        # Set `ja, jb` = labelsEv.index(\"selective_logging\"), labelsEv.index(\"bloo...\n",
    "        ja, jb = labelsEv.index(\"selective_logging\"), labelsEv.index(\"blooming\")\n",
    "        # Set `jc` = labelsEv.index(\"clear\") if \"clear\" in labelsEv else None\n",
    "        jc = labelsEv.index(\"clear\") if \"clear\" in labelsEv else None\n",
    "        # Conditional branch\n",
    "        if pair is None:\n",
    "            # Set `c1` = np.where(ty[:, ja] & ~pred[:, ja] & pred[:, jb] & ~ty[:, ...\n",
    "            c1 = np.where(ty[:, ja] & ~pred[:, ja] & pred[:, jb] & ~ty[:, jb])[0]\n",
    "            # Conditional branch\n",
    "            if not len(c1):\n",
    "                # Set `c1` = np.where(ty[:, ja] & ~pred[:, ja] & ~ty[:, jb])[0]\n",
    "                c1 = np.where(ty[:, ja] & ~pred[:, ja] & ~ty[:, jb])[0]\n",
    "            # Set `c1` = c1[np.argsort(-tp[c1, jb])] if len(c1) else c1\n",
    "            c1 = c1[np.argsort(-tp[c1, jb])] if len(c1) else c1\n",
    "            # Set `mask2` = ty[:, jb] & pred[:, jb] & ~ty[:, ja]\n",
    "            mask2 = ty[:, jb] & pred[:, jb] & ~ty[:, ja]\n",
    "            # Conditional branch\n",
    "            if jc is not None: mask2 = mask2 & ty[:, jc]\n",
    "            # Set `c2` = np.where(mask2)[0]\n",
    "            c2 = np.where(mask2)[0]\n",
    "            # Set `c2` = c2[np.argsort(-tp[c2, jb])] if len(c2) else c2\n",
    "            c2 = c2[np.argsort(-tp[c2, jb])] if len(c2) else c2\n",
    "            # Conditional branch\n",
    "            if len(c1) and len(c2):\n",
    "                # Set `pair` = (int(tidx[c1[0]]), int(tidx[c2[0]]))\n",
    "                pair = (int(tidx[c1[0]]), int(tidx[c2[0]]))\n",
    "                # Set `k1, k2` = c1[0], c2[0]\n",
    "                k1, k2 = c1[0], c2[0]\n",
    "            # Else branch\n",
    "            else:\n",
    "                # Print status / metrics to the notebook\n",
    "                print(\"No suitable look-alike chips; set pair=(loggingIdx, bloomingIdx).\")\n",
    "                # Set `pair` = None\n",
    "                pair = None\n",
    "        # Else branch\n",
    "        else:\n",
    "            # Set `k1, k2` = [int(np.where(tidx == i)[0][0]) for i in pair]\n",
    "            k1, k2 = [int(np.where(tidx == i)[0][0]) for i in pair]\n",
    "        # Conditional branch\n",
    "        if pair is not None:\n",
    "            # Define function `natural_rgb_look`\n",
    "            def natural_rgb_look(x, lo=2, hi=98, gamma=0.9):\n",
    "                # Set `img` = np.transpose(np.asarray(x[:3], dtype=np.float32), (1, 2, 0))\n",
    "                img = np.transpose(np.asarray(x[:3], dtype=np.float32), (1, 2, 0))\n",
    "                # Set `out` = np.empty_like(img)\n",
    "                out = np.empty_like(img)\n",
    "                # Iterate over this sequence\n",
    "                for c in range(3):\n",
    "                    # Set `lo_, hi_` = np.percentile(img[..., c], [lo, hi])\n",
    "                    lo_, hi_ = np.percentile(img[..., c], [lo, hi])\n",
    "                    # Run this pipeline step\n",
    "                    out[..., c] = np.clip((img[..., c] - lo_) / (hi_ - lo_ + 1e-6), 0, 1)\n",
    "                # Return result to caller\n",
    "                return out ** gamma\n",
    "            # Assign `fig, axes` ← plt.subplots(1, 2, figsize=(9, 5.1))\n",
    "            fig, axes = plt.subplots(1, 2, figsize=(9, 5.1))\n",
    "            # Iterate over this sequence\n",
    "            for ax, k, head, sub, col in [\n",
    "                    # Continuation of the multi-line expression\n",
    "                    (axes[0], k1, \"True: selective logging\",\n",
    "                     # Continuation of the multi-line expression\n",
    "                     f\"blooming p = {tp[k1, jb]:.2f}, selective logging p = {tp[k1, ja]:.2f}\", DECK[\"orange\"]),\n",
    "                    # Continuation of the multi-line expression\n",
    "                    (axes[1], k2, \"True: blooming\", f\"blooming p = {tp[k2, jb]:.2f}\", DECK[\"moss\"])]:\n",
    "                # Draw or configure plot elements\n",
    "                ax.imshow(natural_rgb_look(xLook[int(tidx[k])])); ax.set_xticks([]); ax.set_yticks([])\n",
    "                # Iterate over this sequence\n",
    "                for sp in ax.spines.values():\n",
    "                    # Run this pipeline step\n",
    "                    sp.set_visible(True); sp.set_color(col); sp.set_linewidth(4)\n",
    "                # Draw or configure plot elements\n",
    "                ax.set_title(head, fontsize=16, color=col, fontweight=\"bold\", pad=24)\n",
    "                # Draw or configure plot elements\n",
    "                ax.text(0.5, 1.02, sub, transform=ax.transAxes, ha=\"center\", va=\"bottom\",\n",
    "                        # Keyword/field `fontsize`\n",
    "                        fontsize=12, color=DECK[\"text\"])\n",
    "            # Save, show, and close the figure\n",
    "            fig.tight_layout(); fig.savefig(f\"{evalOut}/deck_lookalike.png\"); plt.show(); plt.close()\n",
    "            # Print status / metrics to the notebook\n",
    "            print(\"look-alike chips (cache indices):\", pair)\n"
   ]
  }
