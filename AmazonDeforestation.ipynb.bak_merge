   ],
   "source": [
    "# Set `counts` = pd.Series(y.sum(0), index=labels).sort_values(ascending=False)\n",
    "counts = pd.Series(y.sum(0), index=labels).sort_values(ascending=False)\n",
    "# Set `table` = pd.DataFrame({\"tiles\": counts, \"percent\": (100 * counts / len(df)).rou…\n",
    "table = pd.DataFrame({\"tiles\": counts, \"percent\": (100 * counts / len(df)).round(2)})\n",
    "# Export a metrics/label table as CSV\n",
    "table.to_csv(f\"{figDir}/label_counts.csv\")\n",
    "# Create matplotlib figure/axes\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "# Set `cols` = [\"#FF8A3D\" if p < 1 else \"#3FB6A8\" for p in table[\"percent\"]]\n",
    "cols = [\"#FF8A3D\" if p < 1 else \"#3FB6A8\" for p in table[\"percent\"]]\n",
    "# Draw or configure plot elements\n",
    "ax.bar(table.index, table[\"tiles\"], color=cols)\n",
    "# Draw or configure plot elements\n",
    "ax.set_yscale(\"log\")\n",
    "# Draw or configure plot elements\n",
    "ax.set_ylabel(\"Number of tiles (log scale)\")\n",
    "# Draw or configure plot elements\n",
    "ax.set_title(\"Label frequency (orange = under 1% of tiles)\")\n",
    "# Set `plt.xticks(rotation` = 60, ha=\"right\")\n",
    "plt.xticks(rotation=60, ha=\"right\")\n",
    "# Run this pipeline step\n",
    "plt.tight_layout()\n",
    "# Save figure PNG for the report/deck\n",
    "plt.savefig(f\"{figDir}/fig_label_counts.png\", dpi=200)\n",
    "# Render the figure in the notebook UI\n",
    "plt.show()\n",
    "# Close figure to release memory\n",
    "plt.close()\n",
    "# Set `co` = y.T.astype(float) @ y.astype(float)\n",
    "co = y.T.astype(float) @ y.astype(float)\n",
    "# Set `co` = co / np.diag(co)[:, None]\n",
    "co = co / np.diag(co)[:, None]\n",
    "# Create matplotlib figure/axes\n",
    "fig, ax = plt.subplots(figsize=(8, 7))\n",
    "# Set `im` = ax.imshow(co, cmap=\"Greens\", vmin=0, vmax=1)\n",
    "im = ax.imshow(co, cmap=\"Greens\", vmin=0, vmax=1)\n",
    "# Draw or configure plot elements\n",
    "ax.set_xticks(range(17))\n",
    "# Draw or configure plot elements\n",
    "ax.set_xticklabels(labels, rotation=70, ha=\"right\")\n",
    "# Draw or configure plot elements\n",
    "ax.set_yticks(range(17))\n",
    "# Draw or configure plot elements\n",
    "ax.set_yticklabels(labels)\n",
    "# Draw or configure plot elements\n",
    "ax.set_title(\"Label co-occurrence: P(column | row)\")\n",
    "# Run this pipeline step\n",
    "plt.colorbar(im)\n",
    "# Run this pipeline step\n",
    "plt.tight_layout()\n",
    "# Save figure PNG for the report/deck\n",
    "plt.savefig(f\"{figDir}/fig_label_cooccurrence.png\", dpi=200)\n",
    "# Render the figure in the notebook UI\n",
    "plt.show()\n",
    "# Close figure to release memory\n",
    "plt.close()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "e696669b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Tiles used: 40479\n"
     ]
    }
   ],
   "source": [
    "# Fix RNG seed for reproducibility\n",
    "rng = np.random.RandomState(seed)\n",
    "# Set `keep` = np.arange(len(df))\n",
    "keep = np.arange(len(df))\n",
    "# Conditional branch\n",
    "if subset and subset < len(df):\n",
    "    # Set `rareIdx` = [labels.index(l) for l in labels if counts[l] < 1000]\n",
    "    rareIdx = [labels.index(l) for l in labels if counts[l] < 1000]\n",
    "    # Set `isRare` = y[:, rareIdx].any(1)\n",
    "    isRare = y[:, rareIdx].any(1)\n",
    "    # Set `others` = np.where(~isRare)[0]\n",
    "    others = np.where(~isRare)[0]\n",
    "    # Set `need` = max(subset - int(isRare.sum()), 0)\n",
    "    need = max(subset - int(isRare.sum()), 0)\n",
    "    # Set `keep` = np.sort(np.concatenate([np.where(isRare)[0], rng.choice(others, need, …\n",
    "    keep = np.sort(np.concatenate([np.where(isRare)[0], rng.choice(others, need, False)]))\n",
    "# Set `y` = y[keep]\n",
    "y = y[keep]\n",
    "# Set `names` = [names[i] for i in keep]\n",
    "names = [names[i] for i in keep]\n",
    "# Set `nTiles` = len(names)\n",
    "nTiles = len(names)\n",
    "# Print status / metrics to the notebook\n",
    "print(\"Tiles used:\", nTiles)\n",
    "\n",
    "# Define function `image_path`\n",
    "def image_path(n):\n",
    "    # Return result to caller\n",
    "    return os.path.join(paths[\"tif_dir\"], n + imageExt)\n",
    "\n",
    "# Define function `read_image`\n",
    "def read_image(n):\n",
    "    # Run this pipeline step\n",
    "    \"\"\"Return float32 HxWxC. TIF: 4 bands; JPG: 3-band RGB (OpenCV BGR->RGB).\"\"\"\n",
    "    # Set `path` = image_path(n)\n",
    "    path = image_path(n)\n",
    "    # Conditional branch\n",
    "    if jpgMode:\n",
    "        # OpenCV image operation\n",
    "        bgr = cv2.imread(path, cv2.IMREAD_COLOR)\n",
    "        # Conditional branch\n",
    "        if bgr is None:\n",
    "            # Stop with an error when setup/data is invalid\n",
    "            raise FileNotFoundError(path)\n",
    "        # Return result to caller\n",
    "        return cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB).astype(np.float32)\n",
    "    # Use tifffile for GeoTIFF I/O\n",
    "    a = tifffile.imread(path).astype(np.float32)\n",
    "    # Conditional branch\n",
    "    if a.ndim == 3 and a.shape[0] == 4 and a.shape[-1] != 4:\n",
    "        # Set `a` = np.transpose(a, (1, 2, 0))\n",
    "        a = np.transpose(a, (1, 2, 0))\n",
    "    # Return result to caller\n",
    "    return a\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "1495e76d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Chosen band order: BGRN -> forest NDVI should be highest, water lowest\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 8 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Set `samp` = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "samp = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "# Set `raw` = np.stack([read_image(names[i]) for i in samp])\n",
    "raw = np.stack([read_image(names[i]) for i in samp])\n",
    "# Set `ys` = y[samp]\n",
    "ys = y[samp]\n",
    "# Set `prim` = ys[:, labels.index(\"primary\")] == 1\n",
    "prim = ys[:, labels.index(\"primary\")] == 1\n",
    "# Set `open_` = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels.index(\"bare_…\n",
    "open_ = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels.index(\"bare_ground\")] == 1)\n",
    "# Set `prim, open_` = prim & ~open_, open_ & ~prim\n",
    "prim, open_ = prim & ~open_, open_ & ~prim\n",
    "\n",
    "# Conditional branch\n",
    "if jpgMode:\n",
    "    # Set `bandOrder` = \"RGB_JPG\"\n",
    "    bandOrder = \"RGB_JPG\"\n",
    "    # Set `bandMap` = dict(r=0, g=1, b=2, nir=None)\n",
    "    bandMap = dict(r=0, g=1, b=2, nir=None)\n",
    "    # Set `nBands` = 3\n",
    "    nBands = 3\n",
    "    # Set `tileMean` = raw.reshape(len(samp), -1, nBands).mean(1)\n",
    "    tileMean = raw.reshape(len(samp), -1, nBands).mean(1)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"order\": bandOrder, \"r\": 0, \"g\": 1, \"b\": 2, \"nir\": None, \"jpg_mode\": True},\n",
    "              # Continuation of the multi-line expression\n",
    "              open(f\"{cache}/order.json\", \"w\"))\n",
    "    # Robust band min/max via percentiles\n",
    "    lo = np.percentile(raw.reshape(-1, nBands), 1, axis=0)\n",
    "    # Robust band min/max via percentiles\n",
    "    hi = np.percentile(raw.reshape(-1, nBands), 99, axis=0)\n",
    "    # Set `lo5` = np.concatenate([lo, [0.0, 0.0]])\n",
    "    lo5 = np.concatenate([lo, [0.0, 0.0]])\n",
    "    # Set `hi5` = np.concatenate([hi, [1.0, 1.0]])\n",
    "    hi5 = np.concatenate([hi, [1.0, 1.0]])\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"lo\": lo5.tolist(), \"hi\": hi5.tolist(), \"jpg_mode\": True},\n",
    "              # Continuation of the multi-line expression\n",
    "              open(f\"{cache}/band_stats.json\", \"w\"))\n",
    "    # Set `lo, hi` = lo5, hi5\n",
    "    lo, hi = lo5, hi5\n",
    "# Fallback when earlier conditions were false\n",
    "else:\n",
    "    # Set `nBands` = 4\n",
    "    nBands = 4\n",
    "    # Set `tileMean` = raw.reshape(len(samp), -1, 4).mean(1)\n",
    "    tileMean = raw.reshape(len(samp), -1, 4).mean(1)\n",
    "    # Set `ratio` = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "    ratio = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "    # Set `orders` = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=1, r=0, nir=3…\n",
    "    orders = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=1, r=0, nir=3)}\n",
    "    # Set `bandOrder` = \"BGRN\"\n",
    "    bandOrder = \"BGRN\"\n",
    "    # Conditional branch\n",
    "    if ratio[0] > 1.15 * ratio[2]:\n",
    "        # Set `bandOrder` = \"RGBN\"\n",
    "        bandOrder = \"RGBN\"\n",
    "    # Set `bandMap` = orders[bandOrder]\n",
    "    bandMap = orders[bandOrder]\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"Chosen band order:\", bandOrder, \"-> forest NDVI should be highest, water lowest\")\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"order\": bandOrder, **bandMap, \"jpg_mode\": False}, open(f\"{cache}/order.json\", \"w\"))\n",
    "    # Robust band min/max via percentiles\n",
    "    lo = np.percentile(raw.reshape(-1, 4), 1, axis=0)\n",
    "    # Robust band min/max via percentiles\n",
    "    hi = np.percentile(raw.reshape(-1, 4), 99, axis=0)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"lo\": lo.tolist(), \"hi\": hi.tolist(), \"jpg_mode\": False},\n",
    "              # Continuation of the multi-line expression\n",
    "              open(f\"{cache}/band_stats.json\", \"w\"))\n",
    "\n",
    "# Create matplotlib figure/axes\n",
    "fig, axes = plt.subplots(2, 4, figsize=(10, 5))\n",
    "# Iterate over this sequence\n",
    "for r, grp in enumerate([np.where(prim)[0][:4], np.where(open_)[0][:4]]):\n",
    "    # Iterate over this sequence\n",
    "    for c, k in enumerate(grp):\n",
    "        # Conditional branch\n",
    "        if jpgMode:\n",
    "            # Clamp values into a valid range\n",
    "            img = np.stack([np.clip((raw[k][..., bandMap[x]] - lo[bandMap[x]]) / (hi[bandMap[x]] - lo[bandMap[x]] + 1e-6),\n",
    "                                    # Continuation of the multi-line expression\n",
    "                                    0, 1) for x in (\"r\", \"g\", \"b\")], -1) ** 0.8\n",
    "        # Fallback when earlier conditions were false\n",
    "        else:\n",
    "            # Clamp values into a valid range\n",
    "            img = np.stack([np.clip((raw[k][..., bandMap[x]] - lo[bandMap[x]]) / (hi[bandMap[x]] - lo[bandMap[x]] + 1e-6),\n",
    "                                    # Continuation of the multi-line expression\n",
    "                                    0, 1) for x in (\"r\", \"g\", \"b\")], -1) ** 0.8\n",
    "        # Draw or configure plot elements\n",
    "        axes[r][c].imshow(img)\n",
    "        # Draw or configure plot elements\n",
    "        axes[r][c].axis(\"off\")\n",
    "        # Draw or configure plot elements\n",
    "        axes[r][c].set_title([\"forest\", \"cleared\"][r], fontsize=9)\n",
    "# Run this pipeline step\n",
