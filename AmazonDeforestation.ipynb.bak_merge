   ],
   "source": [
    "# Ladder evaluation: load runs + metric helpers (adapted from Ladder_Evaluation_v2)\n",
    "import re\n",
    "\n",
    "# Paths (same defaults as the ladder training section)\n",
    "evalRuns = os.environ.get(\"AMAZON_LADDER_RUNS\", f\"{os.environ.get('AMAZON_ROOT_TIF', os.environ.get('AMAZON_ROOT', '/mnt/c/Users/legen/amazon_project'))}/ladder_runs\")\n",
    "# Assign `evalCache` ← os.environ.get(\"AMAZON_ROOT_TIF\", os.environ.get(\"AMAZON_ROOT\", \"…\n",
    "evalCache = os.environ.get(\"AMAZON_ROOT_TIF\", os.environ.get(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")) + \"/cache\"\n",
    "# Assign `evalOut` ← f\"{evalRuns}/eval_shared\"\n",
    "evalOut = f\"{evalRuns}/eval_shared\"\n",
    "# Assign `os.makedirs(evalOut, exist_ok` ← True)\n",
    "os.makedirs(evalOut, exist_ok=True)\n",
    "# Assign `N_BOOT` ← 1000\n",
    "N_BOOT = 1000\n",
    "# Assign `REFERENCE` ← \"r18_imnet_rgb\"\n",
    "REFERENCE = \"r18_imnet_rgb\"\n",
    "# Assign `FINAL` ← \"r18_imnet_rgb\"\n",
    "FINAL = \"r18_imnet_rgb\"\n",
    "\n",
    "# Display helper outside Jupyter\n",
    "try:\n",
    "    # Execute: display\n",
    "    display\n",
    "# Catch import/runtime errors\n",
    "except NameError:\n",
    "    # Assign `display` ← lambda df: print(df.to_string() if hasattr(df, \"to_string\") else …\n",
    "    display = lambda df: print(df.to_string() if hasattr(df, \"to_string\") else df)\n",
    "\n",
    "# If-branch\n",
    "if not os.path.exists(f\"{evalCache}/labels.json\"):\n",
    "    # Log to notebook output\n",
    "    print(f\"Missing labels at {evalCache}/labels.json — build the TIF cache first.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Assign `labelsEv` ← json.load(open(f\"{evalCache}/labels.json\"))\n",
    "    labelsEv = json.load(open(f\"{evalCache}/labels.json\"))\n",
    "    # Assign `WEATHER` ← [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in …\n",
    "    WEATHER = [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in labelsEv]\n",
    "    # Assign `DEFOR` ← [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\",…\n",
    "    DEFOR = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"conventional_mine\"] if l in labelsEv]\n",
    "    # Assign `WI` ← [labelsEv.index(l) for l in WEATHER]\n",
    "    WI = [labelsEv.index(l) for l in WEATHER]\n",
    "    # Assign `LI` ← [j for j in range(len(labelsEv)) if j not in WI]\n",
    "    LI = [j for j in range(len(labelsEv)) if j not in WI]\n",
    "    # Assign `DI` ← [labelsEv.index(l) for l in DEFOR]\n",
    "    DI = [labelsEv.index(l) for l in DEFOR]\n",
    "\n",
    "    # Discover finished runs\n",
    "    RUN = {}\n",
    "    # Assign `ORDER` ← []\n",
    "    ORDER = []\n",
    "    # Loop over items\n",
    "    for p in sorted(glob.glob(f\"{evalRuns}/*_probs.npz\")):\n",
    "        # Assign `name` ← os.path.basename(p)[:-10]\n",
    "        name = os.path.basename(p)[:-10]\n",
    "        # Assign `metaPath` ← f\"{evalRuns}/{name}_settings.json\"\n",
    "        metaPath = f\"{evalRuns}/{name}_settings.json\"\n",
    "        # Assign `d` ← np.load(p)\n",
    "        d = np.load(p)\n",
    "        # Assign `RUN[name]` ← {\n",
    "        RUN[name] = {\n",
    "            # Dict entry `\"probs\"`\n",
    "            \"probs\": d,\n",
    "            # Dict entry `\"ty\"`\n",
    "            \"ty\": d[\"test_y\"], \"tp\": d[\"test_probs\"], \"tidx\": d[\"test_idx\"],\n",
    "            # Dict entry `\"vy\"`\n",
    "            \"vy\": d[\"val_y\"], \"vp\": d[\"val_probs\"],\n",
    "            # Dict entry `\"meta\"`\n",
    "            \"meta\": json.load(open(metaPath)) if os.path.exists(metaPath) else {},\n",
    "        }\n",
    "        # Execute: ORDER.append(name)\n",
    "        ORDER.append(name)\n",
    "    # Log to notebook output\n",
    "    print(f\"Loaded {len(ORDER)} ladder runs from {evalRuns}\")\n",
    "\n",
    "    # Assign `GRID` ← np.arange(0.02, 0.81, 0.01)\n",
    "    GRID = np.arange(0.02, 0.81, 0.01)\n",
    "    THRESHOLDS = \"shared\"  # or \"per_label\"\n",
    "\n",
    "    # Define `tune`\n",
    "    def tune(y, p):\n",
    "        # Execute: \"\"\"Land-label thresholds on validation; weather uses argmax (no threshold).\"\"\"\n",
    "        \"\"\"Land-label thresholds on validation; weather uses argmax (no threshold).\"\"\"\n",
    "        # Assign `thr` ← np.full(p.shape[1], np.nan)\n",
    "        thr = np.full(p.shape[1], np.nan)\n",
    "        # If-branch\n",
    "        if THRESHOLDS == \"shared\":\n",
    "            # Assign `scores` ← []\n",
    "            scores = []\n",
    "            # Loop over items\n",
    "            for t in GRID:\n",
    "                # Assign `pred` ← p[:, LI] >= t\n",
    "                pred = p[:, LI] >= t\n",
    "                # Assign `pos` ← y[:, LI] == 1\n",
    "                pos = y[:, LI] == 1\n",
    "                # Assign `tp` ← (pred & pos).sum(0); fp = (pred & ~pos).sum(0); fn = (~pred & pos…\n",
    "                tp = (pred & pos).sum(0); fp = (pred & ~pos).sum(0); fn = (~pred & pos).sum(0)\n",
    "                # Execute: scores.append(np.mean(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)))\n",
    "                scores.append(np.mean(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)))\n",
    "            # Assign `thr[LI]` ← GRID[int(np.argmax(scores))]\n",
    "            thr[LI] = GRID[int(np.argmax(scores))]\n",
    "            # Return value to caller\n",
    "            return thr\n",
    "        # Loop over items\n",
    "        for j in LI:\n",
    "            # Assign `pred` ← p[:, j:j + 1] >= GRID[None, :]\n",
    "            pred = p[:, j:j + 1] >= GRID[None, :]\n",
    "            # Assign `pos` ← y[:, j:j + 1] == 1\n",
    "            pos = y[:, j:j + 1] == 1\n",
    "            # Assign `tp` ← (pred & pos).sum(0); fp = (pred & ~pos).sum(0); fn = (~pred & pos…\n",
    "            tp = (pred & pos).sum(0); fp = (pred & ~pos).sum(0); fn = (~pred & pos).sum(0)\n",
    "            # Assign `thr[j]` ← GRID[(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)).argmax()]\n",
    "            thr[j] = GRID[(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)).argmax()]\n",
    "        # Return value to caller\n",
    "        return thr\n",
    "\n",
    "    # Define `predict`\n",
    "    def predict(p, thr):\n",
    "        # Execute: \"\"\"Exactly one weather label (argmax) + every land label above its threshold.\"\"\"\n",
    "        \"\"\"Exactly one weather label (argmax) + every land label above its threshold.\"\"\"\n",
    "        # Assign `pred` ← np.zeros(p.shape, dtype=bool)\n",
    "        pred = np.zeros(p.shape, dtype=bool)\n",
    "        # If-branch\n",
    "        if WI:\n",
    "            # Assign `pred[np.arange(len(p)), np.array(WI)[p[:, WI].argmax(1)]]` ← True\n",
    "            pred[np.arange(len(p)), np.array(WI)[p[:, WI].argmax(1)]] = True\n",
    "        # Assign `pred[:, LI]` ← p[:, LI] >= thr[LI]\n",
    "        pred[:, LI] = p[:, LI] >= thr[LI]\n",
    "        # Return value to caller\n",
    "        return pred\n",
    "\n",
    "    # Define `metrics_ev`\n",
    "    def metrics_ev(y, p, pred):\n",
    "        # Execute: \"\"\"Summary metrics used in the ladder eval tables.\"\"\"\n",
    "        \"\"\"Summary metrics used in the ladder eval tables.\"\"\"\n",
    "        # Assign `yb, pr` ← y.astype(bool), pred.astype(bool)\n",
    "        yb, pr = y.astype(bool), pred.astype(bool)\n",
    "        # Assign `tp` ← (pr & yb).sum(0); fp = (pr & ~yb).sum(0); fn = (~pr & yb).sum(0)\n",
    "        tp = (pr & yb).sum(0); fp = (pr & ~yb).sum(0); fn = (~pr & yb).sum(0)\n",
    "        # Assign `f2` ← 5 * tp / (5 * tp + 4 * fn + fp + 1e-9)\n",
    "        f2 = 5 * tp / (5 * tp + 4 * fn + fp + 1e-9)\n",
    "        # Assign `out` ← {\n",
    "        out = {\n",
    "            # Dict entry `\"macro_F2\"`\n",
    "            \"macro_F2\": float(np.nanmean(f2)),\n",
    "            # Dict entry `\"land_macro_F2\"`\n",
    "            \"land_macro_F2\": float(np.nanmean(f2[LI])) if LI else float(\"nan\"),\n",
    "            # Dict entry `\"defor_F2\"`\n",
    "            \"defor_F2\": float(np.nanmean(f2[DI])) if DI else float(\"nan\"),\n",
    "            # Dict entry `\"defor_precision\"`\n",
    "            \"defor_precision\": float(np.nanmean(tp[DI] / (tp[DI] + fp[DI] + 1e-9))) if DI else float(\"nan\"),\n",
    "            # Dict entry `\"defor_recall\"`\n",
    "            \"defor_recall\": float(np.nanmean(tp[DI] / (tp[DI] + fn[DI] + 1e-9))) if DI else float(\"nan\"),\n",
    "            # Dict entry `\"samples_F2\"`\n",
    "            \"samples_F2\": float(fbeta_score(yb, pr, beta=2, average=\"samples\", zero_division=0)),\n",
    "            # Dict entry `\"hamming_loss\"`\n",
    "            \"hamming_loss\": float((pr != yb).mean()),\n",
    "        }\n",
    "        # If-branch\n",
    "        if DI:\n",
    "            # Assign `out[\"defor_PR_AUC\"]` ← float(np.mean([average_precision_score(yb[:, j], p[:, j]) for j i…\n",
    "            out[\"defor_PR_AUC\"] = float(np.mean([average_precision_score(yb[:, j], p[:, j]) for j in DI]))\n",
    "        # Return value to caller\n",
    "        return out\n",
    "\n",
    "    # Define `evaluate`\n",
    "    def evaluate(name):\n",
    "        # Execute: \"\"\"Tune on val, predict on test/val, return metrics + preds.\"\"\"\n",
    "        \"\"\"Tune on val, predict on test/val, return metrics + preds.\"\"\"\n",
    "        # Assign `r` ← RUN[name]\n",
    "        r = RUN[name]\n",
    "        # Assign `thr` ← tune(r[\"vy\"], r[\"vp\"])\n",
    "        thr = tune(r[\"vy\"], r[\"vp\"])\n",
    "        # Assign `predTe` ← predict(r[\"tp\"], thr)\n",
    "        predTe = predict(r[\"tp\"], thr)\n",
    "        # Assign `predVa` ← predict(r[\"vp\"], thr)\n",
    "        predVa = predict(r[\"vp\"], thr)\n",
    "        # Return value to caller\n",
    "        return {\n",
    "            # Dict entry `\"thr\"`\n",
    "            \"thr\": thr,\n",
    "            # Dict entry `\"test\"`\n",
    "            \"test\": metrics_ev(r[\"ty\"], r[\"tp\"], predTe),\n",
    "            # Dict entry `\"val\"`\n",
    "            \"val\": metrics_ev(r[\"vy\"], r[\"vp\"], predVa),\n",
    "            # Dict entry `\"pred\"`\n",
    "            \"pred\": {\"test\": predTe, \"val\": predVa},\n",
    "        }\n",
    "\n",
    "    # Define `family`\n",
    "    def family(name):\n",
    "        # Execute: \"\"\"Readable model family from the run name.\"\"\"\n",
    "        \"\"\"Readable model family from the run name.\"\"\"\n",
    "        # Execute: if name.startswith(\"scratch\"): return \"Scratch CNN\"\n",
    "        if name.startswith(\"scratch\"): return \"Scratch CNN\"\n",
    "        # Execute: if name.startswith(\"effb0\"): return \"EfficientNet-B0 (ImageNet)\"\n",
    "        if name.startswith(\"effb0\"): return \"EfficientNet-B0 (ImageNet)\"\n",
    "        # Execute: if \"_s2rgb\" in name: return \"ResNet-18 Sentinel-2 RGB-only\"\n",
    "        if \"_s2rgb\" in name: return \"ResNet-18 Sentinel-2 RGB-only\"\n",
    "        # Return value to caller\n",
    "        return {\"r18_none\": \"ResNet-18 no pretraining\", \"r18_imnet\": \"ResNet-18 ImageNet\",\n",
    "                # Dict entry `\"r18_s2\"`\n",
    "                \"r18_s2\": \"ResNet-18 Sentinel-2 13-band\", \"r34_imnet\": \"ResNet-34 ImageNet\"\n",
    "                # Continues prior expression: }.get(\"_\".join(name.split(\"_\")[:2]), \"other\")\n",
    "                }.get(\"_\".join(name.split(\"_\")[:2]), \"other\")\n",
    "\n",
    "    # If-branch\n",
    "    if ORDER:\n",
    "        # Assign `rows` ← []\n",
