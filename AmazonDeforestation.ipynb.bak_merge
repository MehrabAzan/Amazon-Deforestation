     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Tiles: 40479 | labels: ['agriculture', 'artisinal_mine', 'bare_ground', 'blooming', 'blow_down', 'clear', 'cloudy', 'conventional_mine', 'cultivation', 'habitation', 'haze', 'partly_cloudy', 'primary', 'road', 'selective_logging', 'slash_burn', 'water']\n"
     ]
    }
   ],
   "source": [
    "# Load the Planet label CSV\n",
    "df = pd.read_csv(paths[\"csv\"])\n",
    "# Set `tagLists` = df[\"tags\"].str.split()\n",
    "tagLists = df[\"tags\"].str.split()\n",
    "# Set `labels` = sorted({t for tl in tagLists for t in tl})\n",
    "labels = sorted({t for tl in tagLists for t in tl})\n",
    "# Assert an invariant (fail fast if violated)\n",
    "assert len(labels) == 17, labels\n",
    "# Set `y` = np.zeros((len(df), 17), dtype=np.uint8)\n",
    "y = np.zeros((len(df), 17), dtype=np.uint8)\n",
    "# Iterate over this sequence\n",
    "for i, tl in enumerate(tagLists):\n",
    "    # Iterate over this sequence\n",
    "    for t in tl:\n",
    "        # Set `y[i, labels.index(t)]` = 1\n",
    "        y[i, labels.index(t)] = 1\n",
    "# Set `names` = df[\"image_name\"].tolist()\n",
    "names = df[\"image_name\"].tolist()\n",
    "# Print status / metrics to the notebook\n",
    "print(\"Tiles:\", len(df), \"| labels:\", labels)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "38f7ccd8",
   "metadata": {},
   "outputs": [
