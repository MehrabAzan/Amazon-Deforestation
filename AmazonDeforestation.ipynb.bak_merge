   "source": [
    "# Ladder Grad-CAM deck: ImageNet vs no-pretraining on the same deforestation chips\n",
    "# Needs ladder settings cell (rl, ladderRuns, ladderRoot128) and finished r18_* runs.\n",
    "# Distinct from matched C-vs-D Grad-CAM earlier in the notebook.\n",
    "# Set `runLadderCam` = True\n",
    "runLadderCam = True\n",
    "# Set `camModels` = {\"ImageNet (final)\": \"r18_imnet_rgb\", \"No pretraining\": \"...\n",
    "camModels = {\"ImageNet (final)\": \"r18_imnet_rgb\", \"No pretraining\": \"r18_none_rgb\"}\n",
    "# Set `camLabels` = [\"slash_burn\", \"selective_logging\"]\n",
    "camLabels = [\"slash_burn\", \"selective_logging\"]\n",
    "# Set `nHit, nMiss` = 1, 1\n",
    "nHit, nMiss = 1, 1\n",
    "# Set `camChips` = None\n",
    "camChips = None  # or [(chipIdx, label), ...]\n",
    "\n",
    "# Conditional branch\n",
    "if not runLadderCam:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"Skipped ladder Grad-CAM (set runLadderCam=True).\")\n",
    "# Alternate conditional branch\n",
    "elif \"rl\" not in dir():\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"Run the ladder training settings cell first.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Set `missing` = [r for r in camModels.values() if not os.path.exists(f\"{l...\n",
    "    missing = [r for r in camModels.values() if not os.path.exists(f\"{ladderRuns}/{r}.pt\")]\n",
    "    # Conditional branch\n",
    "    if missing:\n",
    "        # Print status / metrics to the notebook\n",
    "        print(\"Missing ladder weights:\", missing)\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Import dependency: import matplotlib as mpl\n",
    "        import matplotlib as mpl\n",
    "        # Import dependency: import torch.nn.functional as F\n",
    "        import torch.nn.functional as F\n",
    "        # Run this pipeline step\n",
    "        os.environ[\"LADDER_OFFLINE_TEST\"] = \"1\"\n",
    "        # Set `deckCam` = dict(bg=\"\n",
    "        deckCam = dict(bg=\"#15301B\", text=\"#E8EDE3\", muted=\"#A9BBA3\", moss=\"#97BC62\", orange=\"#E8923A\")\n",
    "        # Run this pipeline step\n",
    "        mpl.rcParams.update({\"figure.facecolor\": deckCam[\"bg\"], \"axes.facecolor\": deckCam[\"bg\"],\n",
    "                             # Continuation of the multi-line expression\n",
    "                             \"savefig.facecolor\": deckCam[\"bg\"], \"text.color\": deckCam[\"text\"],\n",
    "                             # Run this pipeline step\n",
    "                             \"font.size\": 14, \"savefig.dpi\": 200, \"savefig.bbox\": \"tight\"})\n",
    "        # Set `niceCam` = {\"slash_burn\": \"slash-and-burn\", \"selective_logging\": \"se...\n",
    "        niceCam = {\"slash_burn\": \"slash-and-burn\", \"selective_logging\": \"selective logging\",\n",
    "                   # Continuation of the multi-line expression\n",
    "                   \"artisinal_mine\": \"artisanal mine\", \"conventional_mine\": \"conventional mine\"}\n",
    "        # Set `c128` = f\"{ladderRoot128}/cache\"\n",
    "        c128 = f\"{ladderRoot128}/cache\"\n",
    "        # Set `labelsCam` = json.load(open(f\"{c128}/labels.json\"))\n",
    "        labelsCam = json.load(open(f\"{c128}/labels.json\"))\n",
    "        # Set `yCam` = np.load(f\"{c128}/Y.npy\")\n",
    "        yCam = np.load(f\"{c128}/Y.npy\")\n",
    "        # Set `stCam` = np.load(f\"{c128}/stats.npz\")\n",
    "        stCam = np.load(f\"{c128}/stats.npz\")\n",
    "        # Set `xCam` = np.load(f\"{c128}/X.npy\", mmap_mode=\"r\")\n",
    "        xCam = np.load(f\"{c128}/X.npy\", mmap_mode=\"r\")\n",
    "        # Set `namesCam` = json.load(open(f\"{c128}/names.json\"))\n",
    "        namesCam = json.load(open(f\"{c128}/names.json\"))\n",
    "\n",
    "        # Define function `load_ladder_model`\n",
    "        def load_ladder_model(run):\n",
    "            # Set `meta` = json.load(open(f\"{ladderRuns}/{run}_settings.json\"))\n",
    "            meta = json.load(open(f\"{ladderRuns}/{run}_settings.json\"))\n",
    "            # Set `s` = rl.full_settings({k: meta[k] for k in rl.DEFAULTS if k in...\n",
    "            s = rl.full_settings({k: meta[k] for k in rl.DEFAULTS if k in meta})\n",
    "            # Set `m` = rl.build_model(s, len(labelsCam))\n",
    "            m = rl.build_model(s, len(labelsCam))\n",
    "            # Run this pipeline step\n",
    "            m.load_state_dict(torch.load(f\"{ladderRuns}/{run}.pt\", map_location=\"cpu\"))\n",
    "            # Return result to caller\n",
    "            return m.eval(), s\n",
    "\n",
    "        # Define function `ladder_gradcam`\n",
    "        def ladder_gradcam(model, s, i, label):\n",
    "            # Set `ch` = s[\"chans\"]\n",
    "            ch = s[\"chans\"]\n",
    "            # Set `x` = torch.tensor(np.asarray(xCam[i][ch], dtype=np.float32))[N...\n",
    "            x = torch.tensor(np.asarray(xCam[i][ch], dtype=np.float32))[None]\n",
    "            # Set `x` = (x - torch.tensor(stCam[\"mean\"][ch]).view(1, -1, 1, 1)) /...\n",
    "            x = (x - torch.tensor(stCam[\"mean\"][ch]).view(1, -1, 1, 1)) / torch.tensor(stCam[\"std\"][ch]).view(1, -1, 1, 1)\n",
    "            # Set `acts` = {}\n",
    "            acts = {}\n",
    "            # Set `layer` = model.features[6]\n",
    "            layer = model.features[6]  # ResNet layer3 (8x8 at 128 px)\n",
    "            # Set `h` = layer.register_forward_hook(lambda mod, inp, out: acts.__...\n",
    "            h = layer.register_forward_hook(lambda mod, inp, out: acts.__setitem__(\"a\", out))\n",
    "            # Set `logit` = model(x)[0, labelsCam.index(label)]\n",
    "            logit = model(x)[0, labelsCam.index(label)]\n",
    "            # Run this pipeline step\n",
    "            h.remove()\n",
    "            # Set `A` = acts[\"a\"]\n",
    "            A = acts[\"a\"]\n",
    "            # Set `g` = torch.autograd.grad(logit, A)[0]\n",
    "            g = torch.autograd.grad(logit, A)[0]\n",
    "            # Set `cam` = F.relu((g.mean((2, 3), keepdim=True) * A).sum(1, keepdim=...\n",
    "            cam = F.relu((g.mean((2, 3), keepdim=True) * A).sum(1, keepdim=True))\n",
    "            # Set `cam` = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", al...\n",
    "            cam = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=False)[0, 0].detach().numpy()\n",
    "            # Return result to caller\n",
    "            return cam / (cam.max() + 1e-8), float(torch.sigmoid(logit.detach()))\n",
    "\n",
    "        # Define function `natural_rgb_cam`\n",
    "        def natural_rgb_cam(i, lo=2, hi=98):\n",
    "            # Set `img` = np.transpose(np.asarray(xCam[i][:3], dtype=np.float32), (...\n",
    "            img = np.transpose(np.asarray(xCam[i][:3], dtype=np.float32), (1, 2, 0))\n",
    "            # Set `out` = np.empty_like(img)\n",
    "            out = np.empty_like(img)\n",
    "            # Iterate over this sequence\n",
    "            for c in range(3):\n",
    "                # Set `a, b` = np.percentile(img[..., c], [lo, hi])\n",
    "                a, b = np.percentile(img[..., c], [lo, hi])\n",
    "                # Run this pipeline step\n",
    "                out[..., c] = np.clip((img[..., c] - a) / (b - a + 1e-6), 0, 1)\n",
    "            # Return result to caller\n",
    "            return out ** 0.9\n",
    "\n",
    "        # Set `modelsCam` = {k: load_ladder_model(r) for k, r in camModels.items()}\n",
    "        modelsCam = {k: load_ladder_model(r) for k, r in camModels.items()}\n",
    "        # Set `chips` = camChips\n",
    "        chips = camChips\n",
    "        # Conditional branch\n",
    "        if chips is None:\n",
    "            # Set `d` = np.load(f\"{ladderRuns}/{list(camModels.values())[0]}_prob...\n",
    "            d = np.load(f\"{ladderRuns}/{list(camModels.values())[0]}_probs.npz\")\n",
    "            # Set `tp, ty, tidx` = d[\"test_probs\"], d[\"test_y\"], d[\"test_idx\"]\n",
    "            tp, ty, tidx = d[\"test_probs\"], d[\"test_y\"], d[\"test_idx\"]\n",
    "            # Set `chips` = []\n",
    "            chips = []\n",
    "            # Iterate over this sequence\n",
    "            for l in camLabels:\n",
    "                # Set `j` = labelsCam.index(l)\n",
    "                j = labelsCam.index(l)\n",
    "                # Set `pos` = np.where(ty[:, j] == 1)[0]\n",
    "                pos = np.where(ty[:, j] == 1)[0]\n",
    "                # Set `order` = pos[np.argsort(-tp[pos, j])]\n",
    "                order = pos[np.argsort(-tp[pos, j])]\n",
    "                # Update `chips` += [(int(tidx[k]), l, \"found\") for k in order[:nHit]]\n",
    "                chips += [(int(tidx[k]), l, \"found\") for k in order[:nHit]]\n",
    "                # Update `chips` += [(int(tidx[k]), l, \"missed\") for k in order[::-1][\n",
    "                chips += [(int(tidx[k]), l, \"missed\") for k in order[::-1][:nMiss]]\n",
    "        # Else branch\n",
    "        else:\n",
    "            # Set `chips` = [(i, l, \"\") for i, l in chips]\n",
    "            chips = [(i, l, \"\") for i, l in chips]\n",
    "\n",
    "        # Set `cols` = 1 + len(modelsCam)\n",
    "        cols = 1 + len(modelsCam)\n",
    "        # Assign `fig, axes` ← plt.subplots(len(chips), cols, figsize=(3.4 * cols, 3.5 *...\n",
    "        fig, axes = plt.subplots(len(chips), cols, figsize=(3.4 * cols, 3.5 * len(chips)), squeeze=False)\n",
    "        # Iterate over this sequence\n",
    "        for r, (i, l, kind) in enumerate(chips):\n",
    "            # Set `rgb` = natural_rgb_cam(i)\n",
    "            rgb = natural_rgb_cam(i)\n",
    "            # Draw or configure plot elements\n",
    "            axes[r, 0].imshow(rgb)\n",
    "            # Draw or configure plot elements\n",
    "            axes[r, 0].set_ylabel(f\"{niceCam.get(l, l)}\\n({kind} by final)\" if kind else niceCam.get(l, l),\n",
    "                                  # Keyword/field `fontsize`\n",
    "                                  fontsize=13, color=deckCam[\"orange\"], fontweight=\"bold\")\n",
    "            # Iterate over this sequence\n",
    "            for c, (mname, (m, s)) in enumerate(modelsCam.items(), start=1):\n",
    "                # Set `cam, p` = ladder_gradcam(m, s, i, l)\n",
    "                cam, p = ladder_gradcam(m, s, i, l)\n",
    "                # Draw or configure plot elements\n",
    "                axes[r, c].imshow(rgb)\n",
    "                # Draw or configure plot elements\n",
    "                axes[r, c].imshow(cam, cmap=\"inferno\", alpha=0.5, vmin=0, vmax=1)\n",
    "                # Draw or configure plot elements\n",
    "                axes[r, c].set_xlabel(f\"p = {p:.2f}\", fontsize=13, color=deckCam[\"text\"])\n",
    "                # Conditional branch\n",
    "                if r == 0: axes[r, c].set_title(mname, fontsize=15, color=deckCam[\"text\"])\n",
    "            # Conditional branch\n",
    "            if r == 0: axes[r, 0].set_title(\"chip\", fontsize=15, color=deckCam[\"text\"])\n",
    "            # Iterate over this sequence\n",
    "            for ax in axes[r]:\n",
    "                # Draw or configure plot elements\n",
    "                ax.set_xticks([]); ax.set_yticks([])\n",
    "                # Iterate over this sequence\n",
    "                for sp_ in ax.spines.values(): sp_.set_visible(False)\n",
    "            # Print status / metrics to the notebook\n",
    "            print(f\"row {r + 1}: chip {i} ({namesCam[i]}), label {l}, {kind}\")\n",
    "        # Run this pipeline step\n",
    "        fig.tight_layout()\n",
    "        # Ensure output directory exists\n",
    "        os.makedirs(f\"{ladderRuns}/eval\", exist_ok=True)\n",
    "        # Save, show, and close the figure\n",
    "        fig.savefig(f\"{ladderRuns}/eval/deck_gradcam.png\"); plt.show(); plt.close()\n"
   ]
  },
