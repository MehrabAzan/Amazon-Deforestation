    "    # Dict entry for key `\"F\"`\n",
    "    \"F\": (\"F_scratch_nir\",      dict(arch=\"scratch\", chans=[0, 1, 2, 3],    lr=3e-3)),\n",
    "}\n",
    "\n",
    "# Set `seed, batch, epochs, out` = seedBd, batchSize, epochsBd, runs\n",
    "seed, batch, epochs, out = seedBd, batchSize, epochsBd, runs\n",
    "# Set `oversample, tta` = True, True\n",
    "oversample, tta = True, True\n",
    "\n",
    "# Iterate over this sequence\n",
    "for key in exps:\n",
    "    # Set `name, cfg` = EXPS[key]\n",
    "    name, cfg = EXPS[key]\n",
    "    # Set `cfg` = {**cfg, \"pretrained\": not noPretrained}\n",
    "    cfg = {**cfg, \"pretrained\": not noPretrained}\n",
    "    # Conditional branch\n",
    "    if os.path.exists(f\"{runs}/{name}_probs.npz\"):\n",
