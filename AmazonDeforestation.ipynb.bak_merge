   "source": [
    "# Set `weather` = [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in label…\n",
    "weather = [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in labels]\n",
    "# Set `rows` = []\n",
    "rows = []\n",
    "# Iterate over this sequence\n",
    "for n in expChans:\n",
    "    # Set `wrong` = (data[n][\"pred\"].astype(int) != y).mean(1)\n",
    "    wrong = (data[n][\"pred\"].astype(int) != y).mean(1)\n",
    "    # Iterate over this sequence\n",
    "    for w in weather:\n",
    "        # Set `m` = y[:, labels.index(w)] == 1\n",
    "        m = y[:, labels.index(w)] == 1\n",
    "        # Set `rows.append(dict(model` = n, weather=w, tiles=int(m.sum())\n",
    "        rows.append(dict(model=n, weather=w, tiles=int(m.sum()),\n",
    "                         # Keyword/field `mean_label_error`\n",
    "                         mean_label_error=float(wrong[m].mean())))\n",
    "# Set `err` = pd.DataFrame(rows)\n",
    "err = pd.DataFrame(rows)\n",
    "# Export a metrics/label table as CSV\n",
    "err.to_csv(f\"{figDir}/error_by_weather.csv\", index=False)\n",
    "# Set `pv` = err.pivot(index=\"weather\", columns=\"model\", values=\"mean_label_error\")…\n",
    "pv = err.pivot(index=\"weather\", columns=\"model\", values=\"mean_label_error\").loc[weather]\n",
    "# Set `colors` = [\"#9DB5A6\", \"#FF8A3D\"][: len(pv.columns)]\n",
    "colors = [\"#9DB5A6\", \"#FF8A3D\"][: len(pv.columns)]\n",
    "# Set `pv.plot.bar(figsize` = (7, 4), color=colors)\n",
    "pv.plot.bar(figsize=(7, 4), color=colors)\n",
    "# Run this pipeline step\n",
    "plt.ylabel(\"share of the 17 labels predicted wrong\")\n",
    "# Run this pipeline step\n",
    "plt.title(\"Error by weather condition (test set)\")\n",
