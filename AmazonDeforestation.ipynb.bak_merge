    "# Define function `build_resnet`\n",
    "def build_resnet(cIn):\n",
    "    # Set `m` = torchvision.models.resnet34(weights=None)\n",
    "    m = torchvision.models.resnet34(weights=None)\n",
    "    # Set `m.conv1` = nn.Conv2d(cIn, 64, 7, 2, 3, bias=False)\n",
    "    m.conv1 = nn.Conv2d(cIn, 64, 7, 2, 3, bias=False)\n",
    "    # Set `m.fc` = nn.Linear(m.fc.in_features, nLabels)\n",
    "    m.fc = nn.Linear(m.fc.in_features, nLabels)\n",
    "    # Return result to caller\n",
    "    return m\n",
    "\n",
    "# Set `models, data` = {}, {}\n",
    "models, data = {}, {}\n",
    "# Iterate over this sequence\n",
    "for n, ch in expChans.items():\n",
    "    # Set `m` = build_resnet(len(ch))\n",
    "    m = build_resnet(len(ch))\n",
    "    # Try block — catch failures below\n",
    "    try:\n",
    "        # Set `state` = torch.load(f\"{runs}/{n}.pt\", map_location=\"cpu\", weights_only=True)\n",
    "        state = torch.load(f\"{runs}/{n}.pt\", map_location=\"cpu\", weights_only=True)\n",
    "    # Handle exception from the try block\n",
    "    except TypeError:\n",
    "        # Set `state` = torch.load(f\"{runs}/{n}.pt\", map_location=\"cpu\")\n",
    "        state = torch.load(f\"{runs}/{n}.pt\", map_location=\"cpu\")\n",
    "    # Run this pipeline step\n",
    "    m.load_state_dict(state)\n",
    "    # Set `models[n]` = m.to(device).eval()\n",
    "    models[n] = m.to(device).eval()\n",
    "    # Load NumPy array (often memory-mapped)\n",
    "    d = np.load(f\"{runs}/{n}_probs.npz\")\n",
    "    # Load JSON metadata from disk\n",
    "    thr = np.array([json.load(open(f\"{runs}/thresholds_{n}.json\"))[l] for l in labels])\n",
    "    # Set `data[n]` = dict(pred=d[\"test_probs\"] >= thr[None, :], y=d[\"test_y\"], idx=d[\"test_…\n",
    "    data[n] = dict(pred=d[\"test_probs\"] >= thr[None, :], y=d[\"test_y\"], idx=d[\"test_idx\"])\n",
    "\n",
    "# Set `ref` = \"C_resnet_rgb\" if \"C_resnet_rgb\" in data else next(iter(data))\n",
    "ref = \"C_resnet_rgb\" if \"C_resnet_rgb\" in data else next(iter(data))\n",
    "# Set `testIdx` = data[ref][\"idx\"]\n",
    "testIdx = data[ref][\"idx\"]\n",
    "# Set `y` = data[ref][\"y\"]\n",
    "y = data[ref][\"y\"]\n",
    "# Conditional branch\n",
    "if \"C_resnet_rgb\" in data and \"D_resnet_nir_ndvi\" in data:\n",
    "    # Assert an invariant (fail fast if violated)\n",
    "    assert (data[\"C_resnet_rgb\"][\"idx\"] == data[\"D_resnet_nir_ndvi\"][\"idx\"]).all()\n"
   ]
  },
