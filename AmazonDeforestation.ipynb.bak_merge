    "# Slide figure: rare labels at 256 px vs resized 128 px (needs AMAZON_ROOT_256 cache)\n",
    "# Set `resLabels` = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"blow_down\", \"conventional_mine\"] if l in Leda]\n",
    "resLabels = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"blow_down\", \"conventional_mine\"] if l in Leda]\n",
    "# Set `perLabel` = 2\n",
    "perLabel = 2\n",
    "# Set `win` = 64\n",
    "win = 64\n",
    "\n",
    "# Define function `stretch_rgb`\n",
    "def stretch_rgb(img, ref=None):\n",
    "    # Set `ref` = img if ref is None else ref\n",
    "    ref = img if ref is None else ref\n",
    "    # Set `out` = np.empty_like(img, dtype=np.float32)\n",
    "    out = np.empty_like(img, dtype=np.float32)\n",
    "    # Iterate over this sequence\n",
    "    for c in range(3):\n",
    "        # Set `a, b` = np.percentile(ref[..., c], [2, 98])\n",
    "        a, b = np.percentile(ref[..., c], [2, 98])\n",
    "        # Run this pipeline step\n",
    "        out[..., c] = np.clip((img[..., c] - a) / (b - a + 1e-6), 0, 1)\n",
    "    # Return result to caller\n",
    "    return out\n",
    "\n",
    "# Define function `detail_window`\n",
    "def detail_window(big, small):\n",
    "    # Set `gBig, gSmall` = big.mean(-1), small.mean(-1)\n",
    "    gBig, gSmall = big.mean(-1), small.mean(-1)\n",
    "    # Set `up` = cv2.resize(gSmall, (256, 256), interpolation=cv2.INTER_LI...\n",
    "    up = cv2.resize(gSmall, (256, 256), interpolation=cv2.INTER_LINEAR)\n",
    "    # Set `lossMap` = (gBig - up) ** 2\n",
    "    lossMap = (gBig - up) ** 2\n",
    "    # Set `lost` = lossMap.sum() / (((gBig - gBig.mean()) ** 2).sum() + 1e-9)\n",
    "    lost = lossMap.sum() / (((gBig - gBig.mean()) ** 2).sum() + 1e-9)\n",
    "    # Set `s` = cv2.blur(lossMap, (win, win))[win // 2: 256 - win // 2 + ...\n",
    "    s = cv2.blur(lossMap, (win, win))[win // 2: 256 - win // 2 + 1, win // 2: 256 - win // 2 + 1]\n",
    "    # Set `y0, x0` = np.unravel_index(np.argmax(s), s.shape)\n",
    "    y0, x0 = np.unravel_index(np.argmax(s), s.shape)\n",
    "    # Return result to caller\n",
    "    return y0, x0, lost\n",
    "\n",
    "# Define function `pick_clear`\n",
    "def pick_clear(l, n=1):\n",
    "    # Set `pos` = np.where(Yeda[:, Leda[l]] == 1)[0]\n",
    "    pos = np.where(Yeda[:, Leda[l]] == 1)[0]\n",
    "    # Conditional branch\n",
    "    if \"clear\" in Leda and l not in WEATHER_EDA:\n",
    "        # Set `clear` = pos[Yeda[pos, Leda[\"clear\"]] == 1]\n",
    "        clear = pos[Yeda[pos, Leda[\"clear\"]] == 1]\n",
    "        # Set `pos` = clear if len(clear) >= n else pos\n",
    "        pos = clear if len(clear) >= n else pos\n",
    "    # Return result to caller\n",
    "    return np.random.RandomState(42).choice(pos, min(n, len(pos)), replace=False)\n",
    "\n",
    "# Conditional branch\n",
    "if not has256:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(f\"No 256 px cache at {edaRoot256}/cache/X.npy — skip resolution figures.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Set `Xeda256` = np.load(f\"{edaRoot256}/cache/X.npy\", mmap_mode=\"r\")\n",
    "    Xeda256 = np.load(f\"{edaRoot256}/cache/X.npy\", mmap_mode=\"r\")\n",
    "    # Run this pipeline step\n",
    "    deck_style()\n",
    "    # Set `picks` = [(l, int(i)) for l in resLabels for i in pick_clear(l, pe...\n",
    "    picks = [(l, int(i)) for l in resLabels for i in pick_clear(l, perLabel)]\n",
    "    # Assign `fig, axes` ← plt.subplots(len(picks), 4, figsize=(15, 3.9 * max(len(pi...\n",
    "    fig, axes = plt.subplots(len(picks), 4, figsize=(15, 3.9 * max(len(picks), 1)))\n",
    "    # Set `axes` = np.atleast_2d(axes)\n",
    "    axes = np.atleast_2d(axes)\n",
    "    # Iterate over this sequence\n",
    "    for r, (l, i) in enumerate(picks):\n",
    "        # Set `big, small` = rgb_chip(Xeda256[i]), rgb_chip(Xeda[i])\n",
    "        big, small = rgb_chip(Xeda256[i]), rgb_chip(Xeda[i])\n",
    "        # If 256 cache is RGB-only shape mismatch is fine; if same tile size, still compare\n",
    "        if big.shape[0] != 256:\n",
    "            # Set `big` = cv2.resize(big, (256, 256), interpolation=cv2.INTER_LINEAR)\n",
    "            big = cv2.resize(big, (256, 256), interpolation=cv2.INTER_LINEAR)\n",
    "        # Conditional branch\n",
    "        if small.shape[0] != 128:\n",
    "            # Set `small` = cv2.resize(small, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "            small = cv2.resize(small, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "        # Set `y0, x0, lost` = detail_window(big, small)\n",
    "        y0, x0, lost = detail_window(big, small)\n",
    "        # Set `bigS, smallS` = stretch_rgb(big), stretch_rgb(small, big)\n",
    "        bigS, smallS = stretch_rgb(big), stretch_rgb(small, big)\n",
    "        # Draw or configure plot elements\n",
    "        axes[r, 0].imshow(bigS); axes[r, 1].imshow(smallS, interpolation=\"nearest\")\n",
    "        # Draw or configure plot elements\n",
    "        axes[r, 2].imshow(bigS[y0:y0 + win, x0:x0 + win], interpolation=\"nearest\")\n",
    "        # Draw or configure plot elements\n",
    "        axes[r, 3].imshow(smallS[y0 // 2:(y0 + win) // 2, x0 // 2:(x0 + win) // 2], interpolation=\"nearest\")\n",
    "        # Iterate over this sequence\n",
    "        for c, scale in ((0, 1), (1, 0.5)):\n",
    "            # Draw or configure plot elements\n",
    "            axes[r, c].add_patch(mpl.patches.Rectangle(\n",
    "                # Continuation of the multi-line expression\n",
    "                (x0 * scale - 0.5, y0 * scale - 0.5), win * scale, win * scale,\n",
    "                # Set `fill` = False, ec=\"yellow\", lw=2))\n",
    "                fill=False, ec=\"yellow\", lw=2))\n",
    "        # Draw or configure plot elements\n",
    "        axes[r, 0].set_ylabel(f\"{l}\\n{namesEda[i]}\", fontsize=11, fontweight=\"bold\")\n",
    "        # Set `titles` = [\"256 px original\", f\"128 px (detail lost {lost:.0%})\", \"...\n",
    "        titles = [\"256 px original\", f\"128 px (detail lost {lost:.0%})\", \"zoom: 256 px\", \"zoom: 128 px\"]\n",
    "        # Iterate over this sequence\n",
    "        for c in range(4):\n",
    "            # Draw or configure plot elements\n",
    "            axes[r, c].set_title(titles[c]); axes[r, c].set_xticks([]); axes[r, c].set_yticks([])\n",
    "    # Run this pipeline step\n",
    "    fig.suptitle(\"Rare labels at original resolution vs after resizing to 128 px\", y=1.0)\n",
    "    # Save, show, and close the figure\n",
    "    plt.tight_layout(); save_eda(fig, \"08_resolution_rare_labels.png\"); plt.show(); plt.close()\n",
    "\n",
    "    # Single-slide selective_logging version\n",
    "    if \"selective_logging\" in Leda:\n",
    "        # Set `i` = int(pick_clear(\"selective_logging\")[0])\n",
    "        i = int(pick_clear(\"selective_logging\")[0])\n",
    "        # Set `big, small` = rgb_chip(Xeda256[i]), rgb_chip(Xeda[i])\n",
    "        big, small = rgb_chip(Xeda256[i]), rgb_chip(Xeda[i])\n",
    "        # Conditional branch\n",
    "        if big.shape[0] != 256:\n",
    "            # Set `big` = cv2.resize(big, (256, 256), interpolation=cv2.INTER_LINEAR)\n",
    "            big = cv2.resize(big, (256, 256), interpolation=cv2.INTER_LINEAR)\n",
    "        # Conditional branch\n",
    "        if small.shape[0] != 128:\n",
    "            # Set `small` = cv2.resize(small, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "            small = cv2.resize(small, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "        # Set `y0, x0, lost` = detail_window(big, small)\n",
    "        y0, x0, lost = detail_window(big, small)\n",
    "        # Set `bigS, smallS` = stretch_rgb(big), stretch_rgb(small, big)\n",
    "        bigS, smallS = stretch_rgb(big), stretch_rgb(small, big)\n",
    "        # Assign `fig, axes` ← plt.subplots(1, 4, figsize=(18, 4.8))\n",
    "        fig, axes = plt.subplots(1, 4, figsize=(18, 4.8))\n",
    "        # Set `panels` = [(bigS, \"Original 256 px\"), (smallS, f\"Resized 128 px ({l...\n",
    "        panels = [(bigS, \"Original 256 px\"), (smallS, f\"Resized 128 px ({lost:.0%} of detail lost)\"),\n",
    "                  # Continuation of the multi-line expression\n",
    "                  (bigS[y0:y0 + win, x0:x0 + win], \"Zoom: original\"),\n",
    "                  # Continuation of the multi-line expression\n",
    "                  (smallS[y0 // 2:(y0 + win) // 2, x0 // 2:(x0 + win) // 2], \"Zoom: resized\")]\n",
    "        # Iterate over this sequence\n",
    "        for ax, (img, t) in zip(axes, panels):\n",
    "            # Draw or configure plot elements\n",
    "            ax.imshow(img, interpolation=\"nearest\"); ax.set_title(t); ax.set_xticks([]); ax.set_yticks([])\n",
    "        # Iterate over this sequence\n",
    "        for c, scale in ((0, 1), (1, 0.5)):\n",
    "            # Draw or configure plot elements\n",
    "            axes[c].add_patch(mpl.patches.Rectangle(\n",
    "                # Continuation of the multi-line expression\n",
    "                (x0 * scale - 0.5, y0 * scale - 0.5), win * scale, win * scale,\n",
    "                # Set `fill` = False, ec=\"yellow\", lw=2))\n",
