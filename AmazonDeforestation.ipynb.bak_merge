    "# Assign `fig, ax` ← plt.subplots(figsize=(11, 7.5))\n",
    "fig, ax = plt.subplots(figsize=(11, 7.5))\n",
    "# Set `bars` = ax.barh([l.replace(\"_\", \" \") for l in order], [freqEda[Le...\n",
    "bars = ax.barh([l.replace(\"_\", \" \") for l in order], [freqEda[Leda[l]] for l in order],\n",
    "               # Keyword/field `color`\n",
