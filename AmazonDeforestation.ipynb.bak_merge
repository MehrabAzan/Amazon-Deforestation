   "source": [
    "# Verify 128 and 256 caches line up (same names/splits; 256 pooled ≈ 128)\n",
    "# Set `c128` = f\"{cacheRoot128}/cache\"\n",
    "c128 = f\"{cacheRoot128}/cache\"\n",
    "# Set `c256` = f\"{cacheRoot256}/cache\"\n",
    "c256 = f\"{cacheRoot256}/cache\"\n",
    "# Conditional branch\n",
    "if not (os.path.exists(f\"{c128}/X.npy\") and os.path.exists(f\"{c256}/X.npy\")):\n",
    "    # Print status / metrics to the notebook\n",
    "    print(f\"Caches not both present yet:\\n  {c128}/X.npy\\n  {c256}/X.npy\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Iterate over this sequence\n",
