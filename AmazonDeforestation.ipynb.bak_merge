    "# Import: import matplotlib.cm as cm\n",
    "import matplotlib.cm as cm\n",
    "\n",
    "# Read path/config from environment\n",
    "root = os.environ.get(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")\n",
    "\n",
    "# Set `cache, out` = f\"{root}/cache\", f\"{root}/figs/real\"\n",
    "cache, out = f\"{root}/cache\", f\"{root}/figs/real\"\n",
    "# Ensure output directory exists\n",
    "os.makedirs(out, exist_ok=True)\n",
    "# Load JSON metadata from disk\n",
    "paths = json.load(open(f\"{root}/paths.json\"))\n",
    "# Set `imageExt` = paths.get(\"image_ext\", \".tif\").lower()\n",
    "imageExt = paths.get(\"image_ext\", \".tif\").lower()\n",
    "# Load JSON metadata from disk\n",
    "jpgMode = imageExt in (\".jpg\", \".jpeg\") or json.load(open(f\"{cache}/order.json\")).get(\"jpg_mode\", False)\n",
    "# Load JSON metadata from disk\n",
    "labels = json.load(open(f\"{cache}/labels.json\"))\n",
    "# Load JSON metadata from disk\n",
    "names = json.load(open(f\"{cache}/names.json\"))\n",
    "# Load NumPy array (often memory-mapped)\n",
    "y = np.load(f\"{cache}/Y.npy\")\n",
    "# Load JSON metadata from disk\n",
    "bandMap = json.load(open(f\"{cache}/order.json\"))\n",
    "# Load JSON metadata from disk\n",
    "bandStats = json.load(open(f\"{cache}/band_stats.json\"))\n",
    "# Set `lo, hi` = np.array(bandStats[\"lo\"]), np.array(bandStats[\"hi\"])\n",
    "lo, hi = np.array(bandStats[\"lo\"]), np.array(bandStats[\"hi\"])\n",
    "# Fix RNG seed for reproducibility\n",
    "rng = np.random.RandomState(7)\n",
    "\n",
    "# Define function `read_image`\n",
    "def read_image(n):\n",
    "    # Set `path` = os.path.join(paths[\"tif_dir\"], n + imageExt)\n",
    "    path = os.path.join(paths[\"tif_dir\"], n + imageExt)\n",
    "    # Conditional branch\n",
    "    if jpgMode:\n",
    "        # OpenCV image operation\n",
    "        bgr = cv2.imread(path, cv2.IMREAD_COLOR)\n",
    "        # Conditional branch\n",
    "        if bgr is None:\n",
    "            # Stop with an error when setup/data is invalid\n",
    "            raise FileNotFoundError(path)\n",
    "        # Return result to caller\n",
    "        return cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB).astype(np.float32)\n",
    "    # Use tifffile for GeoTIFF I/O\n",
    "    a = tifffile.imread(path).astype(np.float32)\n",
    "    # Conditional branch\n",
    "    if a.ndim == 3 and a.shape[0] == 4 and a.shape[-1] != 4:\n",
    "        # Set `a` = np.transpose(a, (1, 2, 0))\n",
    "        a = np.transpose(a, (1, 2, 0))\n",
    "    # Return result to caller\n",
    "    return a\n",
    "\n",
    "# Define function `stretch`\n",
    "def stretch(a, band):\n",
    "    # Return result to caller\n",
    "    return np.clip((a[..., band] - lo[band]) / (hi[band] - lo[band] + 1e-6), 0, 1)\n",
    "\n",
    "# Define function `rgb`\n",
    "def rgb(a, gamma=0.8):\n",
    "    # Conditional branch\n",
    "    if jpgMode:\n",
    "        # Set `img` = np.stack([stretch(a, 0), stretch(a, 1), stretch(a, 2)], -1)\n",
    "        img = np.stack([stretch(a, 0), stretch(a, 1), stretch(a, 2)], -1)\n",
    "    # Fallback when earlier conditions were false\n",
    "    else:\n",
    "        # Set `img` = np.stack([stretch(a, bandMap[\"r\"]), stretch(a, bandMap[\"g\"]), stretch(…\n",
    "        img = np.stack([stretch(a, bandMap[\"r\"]), stretch(a, bandMap[\"g\"]), stretch(a, bandMap[\"b\"])], -1)\n",
    "    # Return result to caller\n",
    "    return (255 * img ** gamma).astype(np.uint8)\n",
    "\n",
    "# Define function `save`\n",
    "def save(img, name, size=512):\n",
    "    # OpenCV image operation\n",
    "    img = cv2.resize(img, (size, size), interpolation=cv2.INTER_CUBIC)\n",
    "    # OpenCV image operation\n",
    "    cv2.imwrite(f\"{out}/{name}.png\", cv2.cvtColor(img, cv2.COLOR_RGB2BGR))\n",
    "\n",
    "# Define function `pick`\n",
    "def pick(label, maxTags=None):\n",
    "    # Set `j` = labels.index(label)\n",
    "    j = labels.index(label)\n",
    "    # Set `cand` = np.where(y[:, j] == 1)[0]\n",
    "    cand = np.where(y[:, j] == 1)[0]\n",
    "    # Set `cand` = cand[np.argsort(y[cand].sum(1))]\n",
    "    cand = cand[np.argsort(y[cand].sum(1))]\n",
    "    # Conditional branch\n",
    "    if maxTags:\n",
    "        # Set `cand` = cand[y[cand].sum(1) <= maxTags]\n",
    "        cand = cand[y[cand].sum(1) <= maxTags]\n",
    "    # Return result to caller\n",
    "    return int(rng.choice(cand[: max(10, len(cand) // 10)]))\n"
   ]
