    }
   ],
   "source": [
    "# Import: from sklearn.metrics import hamming_loss, recall_score, precision_recall_curve, multilabel_confusion_matrix, average_precision_score\n",
    "from sklearn.metrics import hamming_loss, recall_score, precision_recall_curve, multilabel_confusion_matrix, average_precision_score\n",
    "\n",
    "# Read path/config from environment\n",
    "root = os.environ.get(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")\n",
    "\n",
    "# Set `cache, runs, figDir` = f\"{root}/cache\", f\"{root}/runs\", f\"{root}/figs\"\n",
    "cache, runs, figDir = f\"{root}/cache\", f\"{root}/runs\", f\"{root}/figs\"\n",
    "# Ensure output directory exists\n",
    "os.makedirs(figDir, exist_ok=True)\n",
    "# Ensure output directory exists\n",
    "os.makedirs(f\"{root}/results\", exist_ok=True)\n",
    "# Load JSON metadata from disk\n",
    "labels = json.load(open(f\"{cache}/labels.json\"))\n",
    "# Set `expNames` = [\"A_scratch_rgb\", \"B_scratch_nir_ndvi\", \"C_resnet_rgb\", \"D_resnet_nir_…\n",
    "expNames = [\"A_scratch_rgb\", \"B_scratch_nir_ndvi\", \"C_resnet_rgb\", \"D_resnet_nir_ndvi\"]\n",
    "# Check that this path exists\n",
    "expNames = [n for n in expNames if os.path.exists(f\"{runs}/{n}_probs.npz\")]\n",
    "# Set `rare` = [l for l in [\"artisinal_mine\", \"artisanal_mine\", \"conventional_mine\"\n",
    "rare = [l for l in [\"artisinal_mine\", \"artisanal_mine\", \"conventional_mine\",\n",
    "                    # Continuation of the multi-line expression\n",
    "                    \"selective_logging\", \"slash_burn\"] if l in labels]\n",
    "# Set `rareIdx` = [labels.index(l) for l in rare]\n",
    "rareIdx = [labels.index(l) for l in rare]\n",
    "# Print status / metrics to the notebook\n",
    "print(\"Experiments found:\", expNames, \"| rare labels:\", rare)\n",
    "# Conditional branch\n",
    "if not expNames:\n",
    "    # Stop with an error when setup/data is invalid\n",
    "    raise SystemExit(\"No *_probs.npz found in runs/. Train with 04_train_models first.\")\n"
   ]
