   "source": [
    "# Seed variability + cloudy rule + simple ensemble (ladder eval extras)\n",
    "if \"ORDER\" in dir() and ORDER:\n",
    "    # Define `seed_groups`\n",
    "    def seed_groups():\n",
    "        # Execute: \"\"\"Group runs that differ only by a _sN seed suffix.\"\"\"\n",
    "        \"\"\"Group runs that differ only by a _sN seed suffix.\"\"\"\n",
    "        # Assign `groups` ← {}\n",
    "        groups = {}\n",
    "        # Loop over items\n",
    "        for n in ORDER:\n",
    "            # Assign `base` ← re.sub(r\"_s\\d+$\", \"\", n)\n",
    "            base = re.sub(r\"_s\\d+$\", \"\", n)\n",
    "            # Execute: groups.setdefault(base, []).append(n)\n",
    "            groups.setdefault(base, []).append(n)\n",
    "        # Return value to caller\n",
    "        return {b: ns for b, ns in groups.items() if len(ns) > 1 and b in RUN}\n",
    "\n",
    "    # Define `seed_summary`\n",
    "    def seed_summary():\n",
    "        # Assign `rows` ← []\n",
    "        rows = []\n",
    "        # Loop over items\n",
    "        for base, ns in seed_groups().items():\n",
    "            # Assign `row` ← {\"configuration\": base, \"seeds\": len(ns)}\n",
    "            row = {\"configuration\": base, \"seeds\": len(ns)}\n",
    "            # Loop over items\n",
    "            for split in (\"val\", \"test\"):\n",
    "                # Loop over items\n",
    "                for k in (\"defor_F2\", \"macro_F2\"):\n",
    "                    # Assign `v` ← np.array([evaluate(n)[split][k] for n in ns])\n",
    "                    v = np.array([evaluate(n)[split][k] for n in ns])\n",
    "                    # Assign `row[f\"{split}_{k}\"]` ← f\"{v.mean():.3f} ± {v.std(ddof=1):.3f}\"\n",
    "                    row[f\"{split}_{k}\"] = f\"{v.mean():.3f} ± {v.std(ddof=1):.3f}\"\n",
    "            # Execute: rows.append(row)\n",
    "            rows.append(row)\n",
    "        # Return value to caller\n",
    "        return pd.DataFrame(rows).set_index(\"configuration\") if rows else pd.DataFrame()\n",
    "\n",
    "    # Assign `seeds` ← seed_summary()\n",
    "    seeds = seed_summary()\n",
    "    # If-branch\n",
    "    if len(seeds):\n",
    "        # Execute: seeds.to_csv(f\"{evalOut}/seed_summary.csv\")\n",
    "        seeds.to_csv(f\"{evalOut}/seed_summary.csv\")\n",
    "        # Show rich output in Jupyter\n",
    "        display(seeds)\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Log to notebook output\n",
    "        print(\"No multi-seed groups yet.\")\n",
    "\n",
    "    # Define `cloudy_rule`\n",
    "    def cloudy_rule(pred):\n",
    "        # Execute: \"\"\"If cloudy is predicted, zero out all land labels (dataset logic).\"\"\"\n",
    "        \"\"\"If cloudy is predicted, zero out all land labels (dataset logic).\"\"\"\n",
    "        # Assign `out` ← pred.copy()\n",
    "        out = pred.copy()\n",
    "        # If-branch\n",
    "        if \"cloudy\" not in labelsEv:\n",
    "            # Return value to caller\n",
    "            return out\n",
    "        # Assign `ci` ← labelsEv.index(\"cloudy\")\n",
    "        ci = labelsEv.index(\"cloudy\")\n",
    "        # Assign `cloudy` ← out[:, ci]\n",
    "        cloudy = out[:, ci]\n",
    "        # Assign `out[cloudy]` ← False\n",
    "        out[cloudy] = False\n",
    "        # Assign `out[cloudy, ci]` ← True\n",
    "        out[cloudy, ci] = True\n",
    "        # Return value to caller\n",
    "        return out\n",
    "\n",
    "    # Demonstrate cloudy rule on FINAL if present\n",
    "    if FINAL in RUN:\n",
    "        # Assign `e0` ← evaluate(FINAL)\n",
    "        e0 = evaluate(FINAL)\n",
    "        # Assign `pred0` ← e0[\"pred\"][\"test\"]\n",
    "        pred0 = e0[\"pred\"][\"test\"]\n",
    "        # Assign `pred1` ← cloudy_rule(pred0)\n",
    "        pred1 = cloudy_rule(pred0)\n",
    "        # Assign `m0` ← metrics_ev(RUN[FINAL][\"ty\"], RUN[FINAL][\"tp\"], pred0)\n",
    "        m0 = metrics_ev(RUN[FINAL][\"ty\"], RUN[FINAL][\"tp\"], pred0)\n",
    "        # Assign `m1` ← metrics_ev(RUN[FINAL][\"ty\"], RUN[FINAL][\"tp\"], pred1)\n",
    "        m1 = metrics_ev(RUN[FINAL][\"ty\"], RUN[FINAL][\"tp\"], pred1)\n",
    "        # Log to notebook output\n",
    "        print(\"FINAL without cloudy rule:\", {k: round(m0[k], 4) for k in (\"macro_F2\", \"defor_F2\", \"samples_F2\")})\n",
    "        # Log to notebook output\n",
    "        print(\"FINAL with cloudy rule:   \", {k: round(m1[k], 4) for k in (\"macro_F2\", \"defor_F2\", \"samples_F2\")})\n",
    "\n",
    "    # Logit-average ensemble of available members\n",
    "    MEMBERS = [n for n in [\"r18_imnet_rgb_prog3\", \"r18_s2_rgb_s2rgb\", \"r18_imnet_rgb\"] if n in RUN]\n",
    "    # If-branch\n",
    "    if len(MEMBERS) >= 2:\n",
    "        # Average test probabilities across members (same test_idx assumed)\n",
    "        tp = np.mean([RUN[n][\"tp\"] for n in MEMBERS], axis=0)\n",
    "        # Assign `vp` ← np.mean([RUN[n][\"vp\"] for n in MEMBERS], axis=0)\n",
    "        vp = np.mean([RUN[n][\"vp\"] for n in MEMBERS], axis=0)\n",
    "        # Assign `thr` ← tune(RUN[MEMBERS[0]][\"vy\"], vp)\n",
    "        thr = tune(RUN[MEMBERS[0]][\"vy\"], vp)\n",
    "        # Assign `pred` ← predict(tp, thr)\n",
    "        pred = predict(tp, thr)\n",
    "        # Log to notebook output\n",
    "        print(\"Ensemble\", MEMBERS, \"->\", metrics_ev(RUN[MEMBERS[0]][\"ty\"], tp, pred))\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Log to notebook output\n",
    "        print(\"Need ≥2 of the ensemble members trained to build the ensemble.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Log to notebook output\n",
    "    print(\"Ladder eval load cell did not find runs — skip extras.\")\n"
   ]
  },
