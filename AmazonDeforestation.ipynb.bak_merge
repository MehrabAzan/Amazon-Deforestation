    "                h.remove()\n",
    "                # Set `w` = grads[0].mean((2, 3), keepdim=True)\n",
    "                w = grads[0].mean((2, 3), keepdim=True)\n",
    "                # Set `cam` = F.relu((w * acts[0]).sum(1, keepdim=True))\n",
    "                cam = F.relu((w * acts[0]).sum(1, keepdim=True))\n",
    "                # Set `cam` = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=F…\n",
    "                cam = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=False)[0, 0]\n",
    "                # Set `cam` = cam - cam.min()\n",
    "                cam = cam - cam.min()\n",
    "                # Return result to caller\n",
    "                return (cam / (cam.max() + 1e-8)).detach().cpu().numpy()\n",
    "        # Set `expChans` = {EXPS[k][0]: EXPS[k][1][\"chans\"] for k in EXPS if EXPS[k][1][\"arch\"] =…\n",
