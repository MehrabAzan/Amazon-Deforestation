   "source": [
    "# Conditional branch\n",
    "if makeFigs and expNames:\n",
    "    # Try block — catch failures below\n",
    "    try:\n",
    "        # Create matplotlib figure/axes\n",
    "        fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "        # Set `x` = np.arange(len(expNames))\n",
    "        x = np.arange(len(expNames))\n",
    "        # Draw or configure plot elements\n",
    "        ax.bar(x - 0.2, [res[n][\"macro_F2\"] for n in expNames], 0.4, label=\"Macro F2\", color=\"#3FB6A8\")\n",
    "        # Draw or configure plot elements\n",
    "        ax.bar(x + 0.2, [res[n][\"samples_F2 (Kaggle metric)\"] for n in expNames], 0.4,\n",
    "               # Keyword/field `label`\n",
    "               label=\"Kaggle-style F2\", color=\"#7EE081\")\n",
    "        # Draw or configure plot elements\n",
    "        ax.axhline(0.85, color=\"#FF8A3D\", ls=\"--\", label=\"Target 0.85\")\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xticks(x)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xticklabels([n.split(\"_\", 1)[0] for n in expNames])\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_ylim(0, 1)\n",
    "        # Draw or configure plot elements\n",
    "        ax.legend()\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_title(\"Test results by experiment\")\n",
    "        # Run this pipeline step\n",
    "        plt.tight_layout()\n",
    "        # Save figure PNG for the report/deck\n",
    "        plt.savefig(f\"{figDir}/fig_results.png\", dpi=200)\n",
    "        # Render the figure in the notebook UI\n",
    "        plt.show()\n",
    "        # Close figure to release memory\n",
    "        plt.close()\n",
    "\n",
    "        # Set `bestN` = max(expNames, key=lambda n: res[n][\"macro_F2\"])\n",
    "        bestN = max(expNames, key=lambda n: res[n][\"macro_F2\"])\n",
    "        # Set `f2l` = f2_per_label(store[bestN][\"y\"], store[bestN][\"pred\"])\n",
    "        f2l = f2_per_label(store[bestN][\"y\"], store[bestN][\"pred\"])\n",
    "        # Set `order` = np.argsort(f2l)\n",
    "        order = np.argsort(f2l)\n",
    "        # Create matplotlib figure/axes\n",
