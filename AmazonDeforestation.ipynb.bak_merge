   "source": [
    "# Package matched results into a zip for the deck (Fix kit step 6)\n",
    "import zipfile  # stdlib zip writer\n",
    "\n",
    "# Output zip path next to the matched project root\n",
    "zipOut = f\"{matchedRoot}/matched_results_for_deck.zip\"\n",
    "# Open context manager\n",
    "with zipfile.ZipFile(zipOut, \"w\", zipfile.ZIP_DEFLATED) as z:\n",
    "    # Files to include: paste text, JSON summary, and all figures\n",
    "    for f in [f\"{matchedRoot}/results_to_paste.txt\", f\"{matchedRoot}/results.json\"] + glob.glob(f\"{matchedRoot}/figs/*\"):\n",
    "        # If-branch\n",
    "        if os.path.exists(f):\n",
    "            # Store each file with a path relative to matchedRoot\n",
    "            z.write(f, os.path.relpath(f, matchedRoot))\n",
    "# Log to notebook output\n",
    "print(\"Send this file back:\", zipOut, f\"({os.path.getsize(zipOut)/1e6:.1f} MB)\" if os.path.exists(zipOut) else \"\")\n"
   ]
  },
