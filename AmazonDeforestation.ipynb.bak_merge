   "source": [
    "# Show matched figures and results_to_paste.txt (Fix kit step 5)\n",
    "from IPython.display import Image, display  # inline image display in Jupyter\n",
    "\n",
    "# Path to the human-readable results dump written by the matched section / run_matched.py\n",
    "pastePath = f\"{matchedRoot}/results_to_paste.txt\"\n",
    "# If-branch\n",
    "if os.path.exists(pastePath):\n",
    "    # Read the full paste file\n",
    "    txt = open(pastePath).read()\n",
    "    # Warn if this still looks like a JPG-reuse run (comparisons would be contaminated)\n",
    "    if \"reused from your JPG\" in txt or \"JPG notebook run\" in txt:\n",
    "        # Log to notebook output\n",
    "        print(\"WARNING: results still look like a JPG-reuse run. Re-run matched TIF A/C/E without allowJpgReuse.\")\n",
    "    # Log to notebook output\n",
    "    print(txt)\n",
    "# Else branch\n",
    "else:\n",
    "    # Log to notebook output\n",
    "    print(\"No results_to_paste.txt yet — run the matched TIF section first.\")\n",
    "\n",
    "# Display every fig_*.png produced by the matched evaluation\n",
    "figsFix = sorted(glob.glob(f\"{matchedRoot}/figs/fig_*.png\"))\n",
    "# Loop over items\n",
    "for f in figsFix:\n",
    "    # Log to notebook output\n",
    "    print(os.path.basename(f))\n",
    "    # Show rich output in Jupyter\n",
    "    display(Image(filename=f, width=900))\n"
   ]
  },
