   "source": [
    "# Find matching files under the data root\n",
    "tifs = glob.glob(f\"{raw}/**/*.tif\", recursive=True)\n",
    "# Find matching files under the data root\n",
    "jpgs = glob.glob(f\"{raw}/**/train-jpg/*.jpg\", recursive=True)\n",
    "# Conditional branch\n",
    "if not jpgs:\n",
    "    # Find matching files under the data root\n",
    "    jpgs = glob.glob(f\"{raw}/**/*.jpg\", recursive=True)\n",
    "\n",
    "# Set `csvCandidates` = [\n",
    "csvCandidates = [\n",
    "    # Continuation of the multi-line expression\n",
    "    p for p in (\n",
    "        # Keyword/field `glob.glob(f\"{raw}/**/train_classes.csv\", recursive`\n",
    "        glob.glob(f\"{raw}/**/train_classes.csv\", recursive=True)\n",
    "        # Keyword/field `+ glob.glob(f\"{raw}/**/train_v2.csv\", recursive`\n",
    "        + glob.glob(f\"{raw}/**/train_v2.csv\", recursive=True)\n",
    "        # Keyword/field `+ glob.glob(f\"{raw}/**/labels_train_v2.csv\", recursive`\n",
    "        + glob.glob(f\"{raw}/**/labels_train_v2.csv\", recursive=True)\n",
    "    )\n",
    "    # Continuation of the multi-line expression\n",
    "    if os.path.isfile(p)\n",
    "]\n",
    "\n",
    "# Conditional branch\n",
    "if len(tifs) > 1000 and csvCandidates:\n",
    "    # Set `paths` = {\n",
    "    paths = {\n",
    "        # Dict entry for key `\"tif_dir\"`\n",
    "        \"tif_dir\": os.path.dirname(tifs[0]),\n",
    "        # Dict entry for key `\"csv\"`\n",
    "        \"csv\": csvCandidates[0],\n",
    "        # String entry in this collection\n",
    "        \"image_ext\": \".tif\",\n",
    "    }\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"TIF files found:\", len(tifs))\n",
    "# Alternate conditional branch\n",
    "elif len(jpgs) > 1000 and csvCandidates:\n",
    "    # Set `jpgDir` = os.path.dirname(jpgs[0])\n",
    "    jpgDir = os.path.dirname(jpgs[0])\n",
    "    # Set `csvNear` = os.path.join(os.path.dirname(jpgDir), \"train_classes.csv\")\n",
    "    csvNear = os.path.join(os.path.dirname(jpgDir), \"train_classes.csv\")\n",
    "    # Check that this path exists\n",
    "    csvPath = csvNear if os.path.exists(csvNear) else csvCandidates[0]\n",
    "    # Set `paths` = {\n",
    "    paths = {\n",
    "        # Dict entry for key `\"tif_dir\"`\n",
    "        \"tif_dir\": jpgDir,\n",
    "        # Dict entry for key `\"csv\"`\n",
    "        \"csv\": csvPath,\n",
    "        # String entry in this collection\n",
    "        \"image_ext\": \".jpg\",\n",
    "    }\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"JPG files found:\", len(jpgs), \"(TIF torrent unavailable — RGB-only pipeline)\")\n",
    "# Fallback when earlier conditions were false\n",
    "else:\n",
    "    # Stop with an error when setup/data is invalid\n",
    "    raise SystemExit(\n",
    "        # String entry in this collection\n",
    "        f\"Setup incomplete: tifs={len(tifs)} jpgs={len(jpgs)} csvs={len(csvCandidates)}. \"\n",
    "        # String entry in this collection\n",
    "        f\"Place data under AMAZON_RAW ({raw}) or set AMAZON_RAW / AMAZON_ROOT and re-run from the top.\")\n",
    "\n",
    "# Enter a context manager (auto-closes resources)\n",
    "with open(f\"{root}/paths.json\", \"w\") as f:\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump(paths, f, indent=2)\n"
   ]
  },
