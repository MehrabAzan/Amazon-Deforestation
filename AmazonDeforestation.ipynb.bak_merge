    "        same = open(f\"{c128}/{f}\").read() == open(f\"{c256}/{f}\").read()\n",
    "        # Print status / metrics to the notebook\n",
    "        print(f\"{f:<16} identical:\", same)\n",
    "    # Set `s1, s2` = np.load(f\"{c128}/splits.npz\"), np.load(f\"{c256}/splits.npz\")\n",
    "    s1, s2 = np.load(f\"{c128}/splits.npz\"), np.load(f\"{c256}/splits.npz\")\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"splits.npz       identical:\", all((s1[k] == s2[k]).all() for k in s1.files))\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"leak-free scaling:\", json.load(open(f\"{c128}/band_stats.json\")).get(\"leak_free\"))\n",
    "    # Set `x128` = np.load(f\"{c128}/X.npy\", mmap_mode=\"r\")\n",
    "    x128 = np.load(f\"{c128}/X.npy\", mmap_mode=\"r\")\n",
    "    # Set `x256` = np.load(f\"{c256}/X.npy\", mmap_mode=\"r\")\n",
    "    x256 = np.load(f\"{c256}/X.npy\", mmap_mode=\"r\")\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"shapes:\", x128.shape, x256.shape)\n",
    "    # Set `rows` = np.arange(0, len(x128), 4000)\n",
    "    rows = np.arange(0, len(x128), 4000)\n",
    "    # Set `k` = x256.shape[1]\n",
    "    k = x256.shape[1]\n",
    "    # Set `a` = np.asarray(x256[rows]).astype(np.float32)\n",
    "    a = np.asarray(x256[rows]).astype(np.float32)\n",
    "    # Set `pooled` = a.reshape(len(rows), k, 128, 2, 128, 2).mean((3, 5))\n",
    "    pooled = a.reshape(len(rows), k, 128, 2, 128, 2).mean((3, 5))\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"max |pooled 256 - 128|:\", float(np.abs(pooled - np.asarray(x128[rows, :k]).astype(np.float32)).max()))\n"
   ]
