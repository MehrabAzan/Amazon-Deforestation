    "# Save figure PNG for the report/deck\n",
    "plt.savefig(f\"{figDir}/fig_band_check.png\", dpi=150)\n",
    "# Render the figure in the notebook UI\n",
    "plt.show()\n",
    "# Close figure to release memory\n",
    "plt.close()\n",
    "# Delete large temporary object to free RAM\n",
    "del raw\n"
