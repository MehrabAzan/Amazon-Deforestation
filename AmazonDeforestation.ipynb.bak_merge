   "source": [
    "# Extended EDA setup — reuse the unified notebook cache\n",
    "# Prefer TIF cache (128) when present; fall back to AMAZON_ROOT (JPG/shared)\n",
    "edaRootTif = os.environ.get(\"AMAZON_ROOT_TIF\", \"/mnt/c/Users/legen/amazon_project_tif\")\n",
    "edaRootJpg = os.environ.get(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")\n",
    "edaRoot = edaRootTif if os.path.exists(f\"{edaRootTif}/cache/Y.npy\") else edaRootJpg\n",
    "# Assign `edaCache` ← f\"{edaRoot}/cache\"\n",
    "edaCache = f\"{edaRoot}/cache\"\n",
    "# Assign `edaOut` ← f\"{edaRoot}/figs/eda\"\n",
    "edaOut = f\"{edaRoot}/figs/eda\"\n",
    "# Assign `os.makedirs(edaOut, exist_ok` ← True)\n",
    "os.makedirs(edaOut, exist_ok=True)\n",
    "\n",
    "# Optional 256 px cache (ladder / resolution figures); skip quietly if missing\n",
    "edaRoot256 = os.environ.get(\"AMAZON_ROOT_256\", f\"{edaRoot}_256\")\n",
    "# Assign `has256` ← os.path.exists(f\"{edaRoot256}/cache/X.npy\")\n",
    "has256 = os.path.exists(f\"{edaRoot256}/cache/X.npy\")\n",
    "\n",
    "# Deck color palette for presentation-style figures\n",
    "DECK = dict(bg=\"#15301B\", panel=\"#1F4426\", text=\"#E8EDE3\", muted=\"#A9BBA3\", grid=\"#3A5E40\",\n",
    "            moss=\"#97BC62\", orange=\"#E8923A\", sky=\"#8FB8C9\", sand=\"#D8C9A3\")\n",
    "\n",
    "# Define `deck_style`\n",
    "def deck_style():\n",
    "    # Execute: \"\"\"Dark background, light text — readable when projected.\"\"\"\n",
    "    \"\"\"Dark background, light text — readable when projected.\"\"\"\n",
    "    # Import dependency: import matplotlib as mpl\n",
    "    import matplotlib as mpl\n",
    "    # Execute: mpl.rcParams.update({\n",
    "    mpl.rcParams.update({\n",
    "        # Continues prior expression: \"figure.facecolor\": DECK[\"bg\"], \"axes.facecolor\": DECK[\"bg\"], \"savefig.facecolor\n",
    "        \"figure.facecolor\": DECK[\"bg\"], \"axes.facecolor\": DECK[\"bg\"], \"savefig.facecolor\": DECK[\"bg\"],\n",
    "        # Continues prior expression: \"text.color\": DECK[\"text\"], \"axes.labelcolor\": DECK[\"text\"], \"axes.edgecolor\": D\n",
    "        \"text.color\": DECK[\"text\"], \"axes.labelcolor\": DECK[\"text\"], \"axes.edgecolor\": DECK[\"muted\"],\n",
    "        # Continues prior expression: \"xtick.color\": DECK[\"text\"], \"ytick.color\": DECK[\"text\"], \"axes.titlecolor\": DEC\n",
    "        \"xtick.color\": DECK[\"text\"], \"ytick.color\": DECK[\"text\"], \"axes.titlecolor\": DECK[\"text\"],\n",
    "        # Continues prior expression: \"grid.color\": DECK[\"grid\"], \"font.size\": 15, \"axes.titlesize\": 17\n",
    "        \"grid.color\": DECK[\"grid\"], \"font.size\": 15, \"axes.titlesize\": 17,\n",
    "        # Continues prior expression: \"axes.spines.top\": False, \"axes.spines.right\": False, \"savefig.dpi\": 200, \"savef\n",
    "        \"axes.spines.top\": False, \"axes.spines.right\": False, \"savefig.dpi\": 200, \"savefig.bbox\": \"tight\",\n",
    "    # Continues prior expression: })\n",
    "    })\n",
    "\n",
    "# Load label matrix and metadata from the shared cache\n",
    "Yeda = np.load(f\"{edaCache}/Y.npy\")\n",
    "# Assign `labelsEda` ← json.load(open(f\"{edaCache}/labels.json\"))\n",
    "labelsEda = json.load(open(f\"{edaCache}/labels.json\"))\n",
    "# Assign `namesEda` ← json.load(open(f\"{edaCache}/names.json\"))\n",
    "namesEda = json.load(open(f\"{edaCache}/names.json\"))\n",
    "# Assign `spEda` ← np.load(f\"{edaCache}/splits.npz\")\n",
    "spEda = np.load(f\"{edaCache}/splits.npz\")\n",
    "# Assign `Xeda` ← np.load(f\"{edaCache}/X.npy\", mmap_mode=\"r\")\n",
    "Xeda = np.load(f\"{edaCache}/X.npy\", mmap_mode=\"r\")\n",
    "# Assign `Neda` ← len(Yeda)\n",
    "Neda = len(Yeda)\n",
    "# Assign `Leda` ← {l: i for i, l in enumerate(labelsEda)}\n",
    "Leda = {l: i for i, l in enumerate(labelsEda)}\n",
    "# Assign `freqEda` ← Yeda.sum(0).astype(np.int64)\n",
    "freqEda = Yeda.sum(0).astype(np.int64)\n",
    "\n",
    "# Label groups used for coloring\n",
    "WEATHER_EDA = [l for l in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if l in Leda]\n",
    "# Assign `RARE_EDA` ← [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\",…\n",
    "RARE_EDA = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"conventional_mine\", \"blooming\", \"blow_down\"] if l in Leda]\n",
    "# Assign `DEFOR_EDA` ← [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\",…\n",
    "DEFOR_EDA = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"conventional_mine\"] if l in Leda]\n",
    "# Assign `COMMON_EDA` ← [l for l in labelsEda if l not in WEATHER_EDA + RARE_EDA]\n",
    "COMMON_EDA = [l for l in labelsEda if l not in WEATHER_EDA + RARE_EDA]\n",
    "GROUP_COLOR = {\"weather\": \"#7A8B99\", \"common\": \"#2C5F2D\", \"rare\": \"#D9822B\"}\n",
    "\n",
    "# Define `group_eda`\n",
    "def group_eda(l):\n",
    "    # Execute: \"\"\"Map a label name to weather / rare / common.\"\"\"\n",
    "    \"\"\"Map a label name to weather / rare / common.\"\"\"\n",
    "    # Return value to caller\n",
    "    return \"weather\" if l in WEATHER_EDA else \"rare\" if l in RARE_EDA else \"common\"\n",
    "\n",
    "# Define `save_eda`\n",
    "def save_eda(fig, name):\n",
    "    # Execute: \"\"\"Save an EDA figure under figs/eda/.\"\"\"\n",
    "    \"\"\"Save an EDA figure under figs/eda/.\"\"\"\n",
    "    # Execute: fig.savefig(os.path.join(edaOut, name))\n",
    "    fig.savefig(os.path.join(edaOut, name))\n",
    "    # Log to notebook output\n",
    "    print(\"saved\", name)\n",
    "\n",
    "# Define `rgb_chip`\n",
    "def rgb_chip(x):\n",
    "    # Execute: \"\"\"(C,H,W) cache chip -> HxWx3 RGB float array.\"\"\"\n",
    "    \"\"\"(C,H,W) cache chip -> HxWx3 RGB float array.\"\"\"\n",
    "    # Return value to caller\n",
    "    return np.transpose(np.asarray(x[:3], dtype=np.float32), (1, 2, 0))\n",
    "\n",
    "# Define `ndvi_chip`\n",
    "def ndvi_chip(x):\n",
    "    # Execute: \"\"\"Recover NDVI in [-1, 1] from the 0–1 cached NDVI channel.\"\"\"\n",
    "    \"\"\"Recover NDVI in [-1, 1] from the 0–1 cached NDVI channel.\"\"\"\n",
    "    # Return value to caller\n",
    "    return np.asarray(x[4], dtype=np.float32) * 2 - 1\n",
    "\n",
    "# Log to notebook output\n",
    "print(f\"EDA chips: {Neda}, labels: {len(labelsEda)}, 256 cache: {has256}\")\n"
   ]
  },
