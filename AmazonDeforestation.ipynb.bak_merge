    "  # Continues prior expression: + with_seeds(dict(S2, s2_weights=\"rgb\"))\n",
    "  + with_seeds(dict(S2, s2_weights=\"rgb\"))\n",
    "  # Continues prior expression: + [dict(S2, s2_weights=\"rgb\", norm=\"s2match\")]\n",
    "  + [dict(S2, s2_weights=\"rgb\", norm=\"s2match\")]\n",
    ")\n",
    "# Assign `group5` ← (\n",
    "group5 = (\n",
    "    # Continues prior expression: with_seeds(dict(IMNET, res=\"256\"))\n",
    "    with_seeds(dict(IMNET, res=\"256\"))\n",
    "  # Continues prior expression: + [dict(arch=\"efficientnet_b0\", pretrain=\"imagenet\", chans=RGB)\n",
    "  + [dict(arch=\"efficientnet_b0\", pretrain=\"imagenet\", chans=RGB),\n",
    "     # Continues prior expression: dict(arch=\"efficientnet_b0\", pretrain=\"imagenet\", chans=RGB, res=\"256\")]\n",
    "     dict(arch=\"efficientnet_b0\", pretrain=\"imagenet\", chans=RGB, res=\"256\")]\n",
    ")\n",
    "# Assign `group6` ← (\n",
    "group6 = (\n",
    "    # Continues prior expression: with_seeds(dict(IMNET, res=\"prog\", hi_epochs=3))\n",
    "    with_seeds(dict(IMNET, res=\"prog\", hi_epochs=3))\n",
    "  # Continues prior expression: + [dict(S2, s2_weights=\"rgb\", res=\"prog\", hi_epochs=3)]\n",
