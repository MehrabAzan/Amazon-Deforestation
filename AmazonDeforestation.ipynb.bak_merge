    "\n",
    "        # Set `targetsG` = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"agr…\n",
    "        targetsG = [l for l in [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"agriculture\"]\n",
