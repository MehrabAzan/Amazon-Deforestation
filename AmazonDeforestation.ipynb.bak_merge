     ]
    }
   ],
   "source": [
    "# Dual 128+256 cache build (local, adapted from 01_Build_Caches_Colab)\n",
    "# Writes both caches in one pass over the TIFs so splits/band scaling match.\n",
    "# Paths: AMAZON_RAW (TIFs+CSV), AMAZON_ROOT_TIF or AMAZON_ROOT (128), AMAZON_ROOT_256 (256).\n",
    "# Default env path if unset\n",
    "os.environ.setdefault(\"AMAZON_RAW\", \"/mnt/c/Users/legen/amazon_data\")\n",
    "# Default env path if unset\n",
    "os.environ.setdefault(\"AMAZON_ROOT\", \"/mnt/c/Users/legen/amazon_project\")\n",
    "# Default env path if unset\n",
    "os.environ.setdefault(\"AMAZON_ROOT_TIF\", \"/mnt/c/Users/legen/amazon_project_tif\")\n",
    "# Default env path if unset\n",
    "os.environ.setdefault(\"AMAZON_ROOT_256\", \"/mnt/c/Users/legen/amazon_project_tif_256\")\n",
    "\n",
    "# Set `cacheRaw` = os.environ[\"AMAZON_RAW\"]\n",
    "cacheRaw = os.environ[\"AMAZON_RAW\"]\n",
    "# Set `cacheRoot128` = os.environ.get(\"AMAZON_ROOT_TIF\", os.environ[\"AMAZON_ROOT\"])\n",
    "cacheRoot128 = os.environ.get(\"AMAZON_ROOT_TIF\", os.environ[\"AMAZON_ROOT\"])\n",
    "# Set `cacheRoot256` = os.environ[\"AMAZON_ROOT_256\"]\n",
    "cacheRoot256 = os.environ[\"AMAZON_ROOT_256\"]\n",
    "# Set True once when TIFs exist and you need (re)built caches; False keeps Run-All safe\n",
    "runCacheBuild = False\n",
    "# Set `leakFree` = True\n",
    "leakFree = True\n",
    "# Set `rgbOnly256` = False\n",
    "rgbOnly256 = False\n",
    "# Set `cacheThreads` = 8\n",
    "cacheThreads = 8\n",
    "\n",
    "# Print status / metrics to the notebook\n",
    "print(\"RAW:\", cacheRaw)\n",
    "# Print status / metrics to the notebook\n",
    "print(\"ROOT128:\", cacheRoot128)\n",
    "# Print status / metrics to the notebook\n",
    "print(\"ROOT256:\", cacheRoot256)\n",
    "# Print status / metrics to the notebook\n",
    "print(\"runCacheBuild=\", runCacheBuild, \"| leakFree=\", leakFree)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 61,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Skipped dual cache build (set runCacheBuild=True to build when TIFs are present).\n"
     ]
    }
   ],
   "source": [
    "# Build 128 px and 256 px caches in one TIF pass (skip unless runCacheBuild)\n",
    "# Import: import time\n",
    "import time\n",
    "# Import: from concurrent.futures import ThreadPoolExecutor\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "# Import dependency: from sklearn.model_selection import train_test_split\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "# Define function `build_dual_caches`\n",
    "def build_dual_caches(rawDir, root128, root256, leakFree=True, rgbOnly256=False, threads=8, seed=42):\n",
    "    # Find TIFs and label CSV (isfile filter kept intact)\n",
    "    tifs = sorted(glob.glob(f\"{rawDir}/**/*.tif\", recursive=True))\n",
    "    # Set `csvs` = [p for p in glob.glob(f\"{rawDir}/**/train_v2.csv\", recurs...\n",
    "    csvs = [p for p in glob.glob(f\"{rawDir}/**/train_v2.csv\", recursive=True) if os.path.isfile(p)]\n",
    "    # Conditional branch\n",
    "    if len(tifs) < 100 or not csvs:\n",
    "        # Stop with an error when setup/data is invalid\n",
    "        raise FileNotFoundError(\n",
    "            # Continuation of the multi-line expression\n",
    "            f\"Found {len(tifs)} TIFs and {len(csvs)} train_v2.csv under {rawDir}. Unpack data first.\")\n",
    "    # Set `tifDir` = os.path.dirname(tifs[0])\n",
    "    tifDir = os.path.dirname(tifs[0])\n",
    "    # Set `df` = pd.read_csv(csvs[0])\n",
    "    df = pd.read_csv(csvs[0])\n",
    "    # Keep only rows whose TIF is actually on disk\n",
    "    df = df[df[\"image_name\"].map(lambda n: os.path.exists(os.path.join(tifDir, n + \".tif\")))].reset_index(drop=True)\n",
    "\n",
    "    # Set `tagLists` = df[\"tags\"].str.split()\n",
    "    tagLists = df[\"tags\"].str.split()\n",
    "    # Set `labels` = sorted({t for tl in tagLists for t in tl})\n",
    "    labels = sorted({t for tl in tagLists for t in tl})\n",
    "    # Set `y` = np.zeros((len(df), len(labels)), dtype=np.uint8)\n",
    "    y = np.zeros((len(df), len(labels)), dtype=np.uint8)\n",
    "    # Iterate over this sequence\n",
    "    for i, tl in enumerate(tagLists):\n",
    "        # Iterate over this sequence\n",
    "        for t in tl:\n",
    "            # Run this pipeline step\n",
    "            y[i, labels.index(t)] = 1\n",
    "    # Set `names` = df[\"image_name\"].tolist()\n",
    "    names = df[\"image_name\"].tolist()\n",
    "    # Set `nTiles` = len(names)\n",
    "    nTiles = len(names)\n",
    "    # Print status / metrics to the notebook\n",
    "    print(f\"{nTiles} chips with a TIF, {len(labels)} labels\")\n",
    "\n",
    "    # Define function `read_tif`\n",
    "    def read_tif(n):\n",
    "        # Set `a` = tifffile.imread(os.path.join(tifDir, n + \".tif\")).astype(...\n",
    "        a = tifffile.imread(os.path.join(tifDir, n + \".tif\")).astype(np.float32)\n",
    "        # Conditional branch\n",
    "        if a.ndim == 3 and a.shape[0] == 4 and a.shape[-1] != 4:\n",
    "            # Set `a` = np.transpose(a, (1, 2, 0))\n",
    "            a = np.transpose(a, (1, 2, 0))\n",
    "        # Return result to caller\n",
    "        return a\n",
    "\n",
    "    # Stratified 70/15/15 split (same seed / rarest-label strata as matched pipeline)\n",
    "    freq = y.sum(0)\n",
    "    # Set `strata` = np.array([min(np.where(row == 1)[0], key=lambda j: freq[j...\n",
    "    strata = np.array([min(np.where(row == 1)[0], key=lambda j: freq[j]) for row in y])\n",
    "    # Set `idx` = np.arange(nTiles)\n",
    "    idx = np.arange(nTiles)\n",
    "    # Set `tr, tmp` = train_test_split(idx, test_size=0.30, stratify=strata, ra...\n",
    "    tr, tmp = train_test_split(idx, test_size=0.30, stratify=strata, random_state=seed)\n",
    "    # Set `va, te` = train_test_split(tmp, test_size=0.50, stratify=strata[tmp...\n",
    "    va, te = train_test_split(tmp, test_size=0.50, stratify=strata[tmp], random_state=seed)\n",
    "\n",
    "    # Define function `band_stats`\n",
    "    def band_stats(sampleIdx):\n",
    "        # Set `raw` = np.stack([read_tif(names[i]) for i in sampleIdx])\n",
    "        raw = np.stack([read_tif(names[i]) for i in sampleIdx])\n",
    "        # Set `ys` = y[sampleIdx]\n",
    "        ys = y[sampleIdx]\n",
    "        # Set `prim` = ys[:, labels.index(\"primary\")] == 1\n",
    "        prim = ys[:, labels.index(\"primary\")] == 1\n",
    "        # Set `open_` = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels...\n",
    "        open_ = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels.index(\"bare_ground\")] == 1)\n",
    "        # Set `prim, open_` = prim & ~open_, open_ & ~prim\n",
    "        prim, open_ = prim & ~open_, open_ & ~prim\n",
    "        # Set `tileMean` = raw.reshape(len(sampleIdx), -1, 4).mean(1)\n",
    "        tileMean = raw.reshape(len(sampleIdx), -1, 4).mean(1)\n",
    "        # Set `ratio` = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "        ratio = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "        # Set `order` = \"RGBN\" if ratio[0] > 1.15 * ratio[2] else \"BGRN\"\n",
    "        order = \"RGBN\" if ratio[0] > 1.15 * ratio[2] else \"BGRN\"\n",
    "        # Return result to caller\n",
    "        return order, np.percentile(raw.reshape(-1, 4), 1, axis=0), np.percentile(raw.reshape(-1, 4), 99, axis=0)\n",
    "\n",
    "    # Set `rng` = np.random.RandomState(seed)\n",
    "    rng = np.random.RandomState(seed)\n",
    "    # Set `sampAll` = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "    sampAll = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "    # Set `orderAll, loAll, hiAll` = band_stats(sampAll)\n",
    "    orderAll, loAll, hiAll = band_stats(sampAll)\n",
    "    # Conditional branch\n",
    "    if leakFree:\n",
    "        # Set `sampTr` = np.random.RandomState(seed + 1).choice(tr, min(600, len(t...\n",
    "        sampTr = np.random.RandomState(seed + 1).choice(tr, min(600, len(tr)), replace=False)\n",
    "        # Set `bandOrder, lo, hi` = band_stats(sampTr)\n",
    "        bandOrder, lo, hi = band_stats(sampTr)\n",
    "        # Set `rel` = np.abs(np.concatenate([lo - loAll, hi - hiAll])) / (np.co...\n",
    "        rel = np.abs(np.concatenate([lo - loAll, hi - hiAll])) / (np.concatenate([hiAll - loAll] * 2) + 1e-6)\n",
    "        # Print status / metrics to the notebook\n",
    "        print(f\"Leak-free bounds differ from all-data by at most {rel.max():.2%} \"\n",
    "              # Continuation of the multi-line expression\n",
    "              f\"(band order: {bandOrder} vs {orderAll})\")\n",
    "    # Else branch\n",
    "    else:\n",
    "        # Set `bandOrder, lo, hi` = orderAll, loAll, hiAll\n",
    "        bandOrder, lo, hi = orderAll, loAll, hiAll\n",
    "    # Set `bandMap` = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=...\n",
    "    bandMap = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=1, r=0, nir=3)}[bandOrder]\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"Band order:\", bandOrder, \"| bounds from\", \"training only\" if leakFree else \"all chips\")\n",
    "\n",
    "    # Set `caches` = {128: os.path.join(root128, \"cache\"), 256: os.path.join(r...\n",
    "    caches = {128: os.path.join(root128, \"cache\"), 256: os.path.join(root256, \"cache\")}\n",
    "    # Set `nCh` = {128: 5, 256: 3 if rgbOnly256 else 5}\n",
    "    nCh = {128: 5, 256: 3 if rgbOnly256 else 5}\n",
    "    # Set `chanNames` = [\"R\", \"G\", \"B\", \"NIR\", \"NDVI\"]\n",
    "    chanNames = [\"R\", \"G\", \"B\", \"NIR\", \"NDVI\"]\n",
    "    # Iterate over this sequence\n",
    "    for size, c in caches.items():\n",
    "        # Ensure output directory exists\n",
    "        os.makedirs(c, exist_ok=True)\n",
    "        # Ensure output directory exists\n",
    "        os.makedirs(os.path.join(os.path.dirname(c), \"runs\"), exist_ok=True)\n",
    "        # Ensure output directory exists\n",
    "        os.makedirs(os.path.join(os.path.dirname(c), \"figs\"), exist_ok=True)\n",
    "    # Set `X` = {size: np.lib.format.open_memmap(\n",
    "    X = {size: np.lib.format.open_memmap(\n",
    "            # Continuation of the multi-line expression\n",
    "            os.path.join(c, \"X.npy\"), mode=\"w+\", dtype=np.float16,\n",
    "            # Set `shape` = (nTiles, nCh[size], size, size))\n",
    "            shape=(nTiles, nCh[size], size, size))\n",
    "         # Iterate over this sequence\n",
    "         for size, c in caches.items()}\n",
    "\n",
    "    # Set `t0` = time.time()\n",
    "    t0 = time.time()\n",
    "\n",
    "    # Define function `process`\n",
    "    def process(i):\n",
    "        # Set `a` = read_tif(names[i])\n",
    "        a = read_tif(names[i])\n",
    "        # Set `red, nir` = a[..., bandMap[\"r\"]], a[..., bandMap[\"nir\"]]\n",
    "        red, nir = a[..., bandMap[\"r\"]], a[..., bandMap[\"nir\"]]\n",
    "        # Set `ndvi` = (nir - red) / (nir + red + 1e-6)\n",
    "        ndvi = (nir - red) / (nir + red + 1e-6)\n",
    "        # Set `chans` = [np.clip((a[..., src] - lo[src]) / (hi[src] - lo[src] + 1...\n",
    "        chans = [np.clip((a[..., src] - lo[src]) / (hi[src] - lo[src] + 1e-6), 0, 1)\n",
    "                 # Iterate over this sequence\n",
    "                 for src in (bandMap[\"r\"], bandMap[\"g\"], bandMap[\"b\"], bandMap[\"nir\"])]\n",
    "        # Run this pipeline step\n",
    "        chans.append((np.clip(ndvi, -1, 1) + 1) / 2)\n",
    "        # Set `full` = np.stack(chans, -1).astype(np.float32)\n",
    "        full = np.stack(chans, -1).astype(np.float32)\n",
    "        # Conditional branch\n",
    "        if full.shape[0] != 256 or full.shape[1] != 256:\n",
    "            # Set `full` = cv2.resize(full, (256, 256), interpolation=cv2.INTER_AREA)\n",
    "            full = cv2.resize(full, (256, 256), interpolation=cv2.INTER_AREA)\n",
    "        # Run this pipeline step\n",
    "        X[256][i] = np.transpose(full[..., :nCh[256]], (2, 0, 1)).astype(np.float16)\n",
    "        # Set `small` = cv2.resize(full, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "        small = cv2.resize(full, (128, 128), interpolation=cv2.INTER_AREA)\n",
    "        # Run this pipeline step\n",
    "        X[128][i] = np.transpose(small, (2, 0, 1)).astype(np.float16)\n",
    "\n",
    "    # Open context manager\n",
    "    with ThreadPoolExecutor(threads) as ex:\n",
    "        # Iterate over this sequence\n",
    "        for k, _ in enumerate(ex.map(process, range(nTiles))):\n",
    "            # Conditional branch\n",
    "            if k % 2000 == 0:\n",
    "                # Print status / metrics to the notebook\n",
    "                print(f\"  {k}/{nTiles} chips  [{time.time() - t0:.0f}s]\")\n",
    "    # Iterate over this sequence\n",
    "    for m in X.values():\n",
    "        # Run this pipeline step\n",
    "        m.flush()\n",
    "\n",
    "    # Set `pick` = np.sort(rng.choice(np.sort(tr), min(3000, len(tr)), repla...\n",
    "    pick = np.sort(rng.choice(np.sort(tr), min(3000, len(tr)), replace=False))\n",
    "    # Iterate over this sequence\n",
    "    for size, c in caches.items():\n",
    "        # Persist NumPy array(s) to the cache\n",
    "        np.save(os.path.join(c, \"Y.npy\"), y)\n",
    "        # Persist JSON metadata to the cache\n",
    "        json.dump(labels, open(os.path.join(c, \"labels.json\"), \"w\"))\n",
    "        # Persist JSON metadata to the cache\n",
    "        json.dump(names, open(os.path.join(c, \"names.json\"), \"w\"))\n",
    "        # Persist JSON metadata to the cache\n",
    "        json.dump({\"order\": bandOrder, **bandMap}, open(os.path.join(c, \"order.json\"), \"w\"))\n",
    "        # Persist JSON metadata to the cache\n",
    "        json.dump({\"lo\": lo.tolist(), \"hi\": hi.tolist(), \"leak_free\": bool(leakFree),\n",
    "                   # Continuation of the multi-line expression\n",
    "                   \"lo_alldata\": loAll.tolist(), \"hi_alldata\": hiAll.tolist()},\n",
    "                  # Run this pipeline step\n",
    "                  open(os.path.join(c, \"band_stats.json\"), \"w\"))\n",
    "        # Persist NumPy array(s) to the cache\n",
    "        np.savez(os.path.join(c, \"splits.npz\"), train=np.sort(tr), val=np.sort(va), test=np.sort(te))\n",
    "        # Set `sub` = np.asarray(np.load(os.path.join(c, \"X.npy\"), mmap_mode=\"r...\n",
    "        sub = np.asarray(np.load(os.path.join(c, \"X.npy\"), mmap_mode=\"r\")[pick]).astype(np.float32)\n",
    "        # Persist NumPy array(s) to the cache\n",
    "        np.savez(os.path.join(c, \"stats.npz\"), mean=sub.mean((0, 2, 3)), std=sub.std((0, 2, 3)) + 1e-6)\n",
    "        # Persist JSON metadata to the cache\n",
    "        json.dump({\"n\": nTiles, \"tile\": size, \"jpg_mode\": False, \"channels\": chanNames[:nCh[size]]},\n",
    "                  # Continuation of the multi-line expression\n",
    "                  open(os.path.join(c, \"cache_meta.json\"), \"w\"))\n",
    "        # Set `gb` = os.path.getsize(os.path.join(c, \"X.npy\")) / 1e9\n",
    "        gb = os.path.getsize(os.path.join(c, \"X.npy\")) / 1e9\n",
    "        # Print status / metrics to the notebook\n",
    "        print(f\"{size} px cache: {c}  ({nCh[size]} channels, {gb:.1f} GB)\")\n",
    "    # Print status / metrics to the notebook\n",
    "    print(f\"Done in {(time.time() - t0) / 60:.1f} min. train/val/test = {len(tr)}/{len(va)}/{len(te)}\")\n",
    "\n",
    "# Conditional branch\n",
    "if runCacheBuild:\n",
    "    # Run this pipeline step\n",
    "    build_dual_caches(cacheRaw, cacheRoot128, cacheRoot256,\n",
    "                      # Keyword/field `leakFree`\n",
    "                      leakFree=leakFree, rgbOnly256=rgbOnly256, threads=cacheThreads)\n",
    "# Else branch\n",
    "else:\n",
    "    # Print status / metrics to the notebook\n",
    "    print(\"Skipped dual cache build (set runCacheBuild=True to build when TIFs are present).\")\n"
   ]
  },
