   ],
   "source": [
    "# Set `metaPath` = f\"{cache}/cache_meta.json\"\n",
    "metaPath = f\"{cache}/cache_meta.json\"\n",
    "# Set `metaOk` = (\n",
    "metaOk = (\n",
    "    # Continuation of the multi-line expression\n",
    "    os.path.exists(metaPath) and not rebuildCache and os.path.exists(f\"{cache}/X.npy\")\n",
    "    # Keyword/field `and json.load(open(metaPath)).get(\"n\")`\n",
    "    and json.load(open(metaPath)).get(\"n\") == nTiles\n",
    "    # Keyword/field `and json.load(open(metaPath)).get(\"tile\")`\n",
    "    and json.load(open(metaPath)).get(\"tile\") == tileSizeBd\n",
    ")\n",
    "# Conditional branch\n",
    "if not metaOk:\n",
    "    # Fix RNG seed for reproducibility\n",
    "    rng = np.random.RandomState(seedBd)\n",
    "    # Set `samp` = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "    samp = rng.choice(nTiles, min(600, nTiles), replace=False)\n",
    "    # Set `rawSamp` = np.stack([read_tif(names[i]) for i in samp])\n",
    "    rawSamp = np.stack([read_tif(names[i]) for i in samp])\n",
    "    # Set `ys` = y[samp]\n",
    "    ys = y[samp]\n",
    "    # Set `prim` = ys[:, labels.index(\"primary\")] == 1\n",
    "    prim = ys[:, labels.index(\"primary\")] == 1\n",
    "    # Set `open_` = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels.index(\"bare_…\n",
    "    open_ = (ys[:, labels.index(\"agriculture\")] == 1) | (ys[:, labels.index(\"bare_ground\")] == 1)\n",
    "    # Set `prim, open_` = prim & ~open_, open_ & ~prim\n",
    "    prim, open_ = prim & ~open_, open_ & ~prim\n",
    "    # Set `tileMean` = rawSamp.reshape(len(samp), -1, 4).mean(1)\n",
    "    tileMean = rawSamp.reshape(len(samp), -1, 4).mean(1)\n",
    "    # Conditional branch\n",
    "    if prim.sum() and open_.sum():\n",
    "        # Set `ratio` = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "        ratio = tileMean[open_].mean(0) / tileMean[prim].mean(0)\n",
    "        # Set `bandOrder` = \"RGBN\" if ratio[0] > 1.15 * ratio[2] else \"BGRN\"\n",
    "        bandOrder = \"RGBN\" if ratio[0] > 1.15 * ratio[2] else \"BGRN\"\n",
    "    # Fallback when earlier conditions were false\n",
    "    else:\n",
    "        # Set `bandOrder` = \"BGRN\"\n",
    "        bandOrder = \"BGRN\"\n",
    "    # Set `orders` = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=1, r=0, nir=3…\n",
    "    orders = {\"BGRN\": dict(b=0, g=1, r=2, nir=3), \"RGBN\": dict(b=2, g=1, r=0, nir=3)}\n",
    "    # Set `bandMap` = orders[bandOrder]\n",
    "    bandMap = orders[bandOrder]\n",
    "    # Set `ndviT` = (tileMean[:, bandMap[\"nir\"]] - tileMean[:, bandMap[\"r\"]]) / (\n",
    "    ndviT = (tileMean[:, bandMap[\"nir\"]] - tileMean[:, bandMap[\"r\"]]) / (\n",
    "        # Dict entry for key `tileMean[`\n",
    "        tileMean[:, bandMap[\"nir\"]] + tileMean[:, bandMap[\"r\"]] + 1e-6)\n",
    "    # Iterate over this sequence\n",
    "    for labName in (\"primary\", \"agriculture\", \"water\"):\n",
    "        # Set `m` = ys[:, labels.index(labName)] == 1\n",
    "        m = ys[:, labels.index(labName)] == 1\n",
    "        # Conditional branch\n",
    "        if m.sum():\n",
    "            # Print status / metrics to the notebook\n",
    "            say(f\"mean NDVI for {labName}: {ndviT[m].mean():.3f}\")\n",
    "    # Print status / metrics to the notebook\n",
    "    say(\"Chosen band order:\", bandOrder, \"(forest NDVI should be highest, water lowest)\")\n",
    "    # Robust band min/max via percentiles\n",
    "    lo = np.percentile(rawSamp.reshape(-1, 4), 1, axis=0)\n",
    "    # Robust band min/max via percentiles\n",
    "    hi = np.percentile(rawSamp.reshape(-1, 4), 99, axis=0)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"order\": bandOrder, **bandMap}, open(f\"{cache}/order.json\", \"w\"))\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"lo\": lo.tolist(), \"hi\": hi.tolist()}, open(f\"{cache}/band_stats.json\", \"w\"))\n",
    "    # Delete large temporary object to free RAM\n",
    "    del rawSamp\n",
    "\n",
    "    # Memory-map large array without full RAM load\n",
    "    xmm = np.lib.format.open_memmap(\n",
    "        # String entry in this collection\n",
    "        f\"{cache}/X.npy\", mode=\"w+\", dtype=np.float16, shape=(nTiles, 5, tileSizeBd, tileSizeBd))\n",
    "    # Define function `process`\n",
    "    def process(i):\n",
    "        # Set `a` = read_tif(names[i])\n",
    "        a = read_tif(names[i])\n",
    "        # Set `red, nir` = a[..., bandMap[\"r\"]], a[..., bandMap[\"nir\"]]\n",
    "        red, nir = a[..., bandMap[\"r\"]], a[..., bandMap[\"nir\"]]\n",
    "        # Set `ndvi` = (nir - red) / (nir + red + 1e-6)\n",
    "        ndvi = (nir - red) / (nir + red + 1e-6)\n",
    "        # Clamp values into a valid range\n",
    "        chans = [np.clip((a[..., src] - lo[src]) / (hi[src] - lo[src] + 1e-6), 0, 1)\n",
    "                 # Continuation of the multi-line expression\n",
    "                 for src in (bandMap[\"r\"], bandMap[\"g\"], bandMap[\"b\"], bandMap[\"nir\"])]\n",
    "        # Clamp values into a valid range\n",
    "        chans.append((np.clip(ndvi, -1, 1) + 1) / 2)\n",
    "        # Set `arr` = np.stack(chans, -1).astype(np.float32)\n",
    "        arr = np.stack(chans, -1).astype(np.float32)\n",
    "        # OpenCV image operation\n",
    "        arr = cv2.resize(arr, (tileSizeBd, tileSizeBd), interpolation=cv2.INTER_AREA)\n",
    "        # Set `xmm[i]` = np.transpose(arr, (2, 0, 1)).astype(np.float16)\n",
    "        xmm[i] = np.transpose(arr, (2, 0, 1)).astype(np.float16)\n",
    "    # Enter a context manager (auto-closes resources)\n",
    "    with ThreadPoolExecutor(8) as ex:\n",
    "        # Iterate over this sequence\n",
    "        for k, _ in enumerate(ex.map(process, range(nTiles))):\n",
    "            # Conditional branch\n",
    "            if k % 2000 == 0:\n",
    "                # Print status / metrics to the notebook\n",
    "                print(f\"cached {k}/{nTiles}\")\n",
    "    # Run this pipeline step\n",
    "    xmm.flush()\n",
    "    # Persist NumPy array(s) to the cache\n",
    "    np.save(f\"{cache}/Y.npy\", y)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump(labels, open(f\"{cache}/labels.json\", \"w\"))\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump(names, open(f\"{cache}/names.json\", \"w\"))\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump({\"n\": nTiles, \"tile\": tileSizeBd, \"jpg_mode\": False,\n",
    "               # Dict entry for key `\"channels\"`\n",
    "               \"channels\": [\"R\", \"G\", \"B\", \"NIR\", \"NDVI\"]}, open(metaPath, \"w\"))\n",
    "\n",
    "    # Set `freq` = y.sum(0)\n",
    "    freq = y.sum(0)\n",
    "    # Set `strata` = np.array([min(np.where(row == 1)[0], key=lambda j: freq[j]) for row in…\n",
    "    strata = np.array([min(np.where(row == 1)[0], key=lambda j: freq[j]) for row in y])\n",
    "    # Set `idx` = np.arange(nTiles)\n",
    "    idx = np.arange(nTiles)\n",
    "    # Stratified train/val/test index split\n",
    "    tr, tmp = train_test_split(idx, test_size=0.30, stratify=strata, random_state=seedBd)\n",
    "    # Stratified train/val/test index split\n",
    "    va, te = train_test_split(tmp, test_size=0.50, stratify=strata[tmp], random_state=seedBd)\n",
    "    # Persist NumPy array(s) to the cache\n",
    "    np.savez(f\"{cache}/splits.npz\", train=np.sort(tr), val=np.sort(va), test=np.sort(te))\n",
    "    # Load NumPy array (often memory-mapped)\n",
    "    xr = np.load(f\"{cache}/X.npy\", mmap_mode=\"r\")\n",
    "    # Set `pick` = np.sort(rng.choice(np.sort(tr), min(3000, len(tr)), replace=False))\n",
    "    pick = np.sort(rng.choice(np.sort(tr), min(3000, len(tr)), replace=False))\n",
    "    # Set `sub` = np.asarray(xr[pick]).astype(np.float32)\n",
    "    sub = np.asarray(xr[pick]).astype(np.float32)\n",
    "    # Persist NumPy array(s) to the cache\n",
    "    np.savez(f\"{cache}/stats.npz\", mean=sub.mean((0, 2, 3)), std=sub.std((0, 2, 3)) + 1e-6)\n",
    "    # Print status / metrics to the notebook\n",
    "    say(\"Built TIF cache at\", cache)\n",
    "# Fallback when earlier conditions were false\n",
    "else:\n",
    "    # Print status / metrics to the notebook\n",
    "    say(\"Reusing TIF cache at\", cache)\n",
    "\n",
    "# Load NumPy array (often memory-mapped)\n",
    "xAll = np.load(f\"{cache}/X.npy\", mmap_mode=\"r\")\n",
    "# Load NumPy array (often memory-mapped)\n",
    "y = np.load(f\"{cache}/Y.npy\")\n",
    "# Load JSON metadata from disk\n",
    "labels = json.load(open(f\"{cache}/labels.json\"))\n",
    "# Set `nLabels` = len(labels)\n",
    "nLabels = len(labels)\n",
    "# Load NumPy array (often memory-mapped)\n",
    "sp = np.load(f\"{cache}/splits.npz\")\n",
    "# Set `tr, va, te` = sp[\"train\"], sp[\"val\"], sp[\"test\"]\n",
    "tr, va, te = sp[\"train\"], sp[\"val\"], sp[\"test\"]\n",
    "# Load NumPy array (often memory-mapped)\n",
    "st = np.load(f\"{cache}/stats.npz\")\n",
    "# Set `chanMean, chanStd` = st[\"mean\"], st[\"std\"]\n",
    "chanMean, chanStd = st[\"mean\"], st[\"std\"]\n",
    "# Print status / metrics to the notebook\n",
    "say(\"train/val/test:\", len(tr), len(va), len(te))\n"
   ]
