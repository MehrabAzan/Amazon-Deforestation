   "source": [
    "# Slide figure: 8 example chips (4 common land + 4 deforestation), deck style\n",
    "# Display-only per-chip stretch; cache/models unchanged.\n",
    "# Set `commonShow` = [\"primary\", \"agriculture\", \"road\", \"water\"]\n",
    "commonShow = [\"primary\", \"agriculture\", \"road\", \"water\"]\n",
    "# Set `deforShow` = [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"co...\n",
    "deforShow = [\"selective_logging\", \"slash_burn\", \"artisinal_mine\", \"conventional_mine\"]\n",
    "# Set `pickOverride` = {}\n",
    "pickOverride = {}  # e.g. {\"water\": 1234} to force a chip index\n",
    "\n",
    "# Define function `natural_rgb`\n",
    "def natural_rgb(x, lo=2, hi=98, gamma=0.9):\n",
    "    # Set `img` = rgb_chip(x)\n",
    "    img = rgb_chip(x)\n",
    "    # Set `out` = np.empty_like(img)\n",
    "    out = np.empty_like(img)\n",
    "    # Iterate over this sequence\n",
    "    for c in range(3):\n",
    "        # Set `a, b` = np.percentile(img[..., c], [lo, hi])\n",
    "        a, b = np.percentile(img[..., c], [lo, hi])\n",
    "        # Run this pipeline step\n",
    "        out[..., c] = np.clip((img[..., c] - a) / (b - a + 1e-6), 0, 1)\n",
    "    # Return result to caller\n",
    "    return out ** gamma\n",
    "\n",
    "# Define function `nice_name`\n",
    "def nice_name(l):\n",
    "    # Return result to caller\n",
    "    return {\"primary\": \"primary forest\", \"slash_burn\": \"slash-and-burn\",\n",
    "            # Continuation of the multi-line expression\n",
    "            \"artisinal_mine\": \"artisanal mine\"}.get(l, l.replace(\"_\", \" \"))\n",
    "\n",
    "# Set `prefer` = {\"primary\": {\"clear\", \"primary\"}, \"agriculture\": {\"agricu...\n",
    "prefer = {\"primary\": {\"clear\", \"primary\"}, \"agriculture\": {\"agriculture\", \"clear\", \"primary\"},\n",
    "          # Continuation of the multi-line expression\n",
    "          \"road\": {\"clear\", \"primary\", \"road\"}, \"water\": {\"clear\", \"primary\", \"water\"}}\n",
    "\n",
    "# Define function `candidates`\n",
    "def candidates(label):\n",
    "    # Set `has` = Yeda[:, Leda[label]] == 1\n",
    "    has = Yeda[:, Leda[label]] == 1\n",
    "    # Set `clear` = Yeda[:, Leda[\"clear\"]] == 1 if \"clear\" in Leda else np.on...\n",
    "    clear = Yeda[:, Leda[\"clear\"]] == 1 if \"clear\" in Leda else np.ones(Neda, dtype=bool)\n",
    "    # Conditional branch\n",
    "    if label in prefer:\n",
    "        # Set `want` = np.zeros(len(labelsEda), int)\n",
    "        want = np.zeros(len(labelsEda), int)\n",
    "        # Run this pipeline step\n",
    "        want[[Leda[l] for l in prefer[label] if l in Leda]] = 1\n",
    "        # Set `exact` = np.where((Yeda == want).all(1))[0]\n",
    "        exact = np.where((Yeda == want).all(1))[0]\n",
    "        # Conditional branch\n",
    "        if len(exact): return exact\n",
    "    # Set `cand` = np.where(has & clear & (Yeda.sum(1) <= 4))[0]\n",
    "    cand = np.where(has & clear & (Yeda.sum(1) <= 4))[0]\n",
    "    # Return result to caller\n",
    "    return cand if len(cand) else np.where(has)[0]\n",
    "\n",
    "# Define function `pick_chip`\n",
    "def pick_chip(label, seed=7):\n",
    "    # Conditional branch\n",
    "    if label in pickOverride:\n",
    "        # Return result to caller\n",
    "        return pickOverride[label]\n",
    "    # Return result to caller\n",
    "    return int(np.random.RandomState(seed).choice(candidates(label)))\n",
    "\n",
    "# Define function `tags_of`\n",
    "def tags_of(i):\n",
    "    # Return result to caller\n",
    "    return \" \".join(labelsEda[j] for j in range(len(labelsEda)) if Yeda[i, j])\n",
    "\n",
    "# Run this pipeline step\n",
    "deck_style()\n",
    "# Assign `fig, axes` ← plt.subplots(2, 4, figsize=(14, 8.2))\n",
    "fig, axes = plt.subplots(2, 4, figsize=(14, 8.2))\n",
    "# Iterate over this sequence\n",
    "for row, (show, col) in enumerate([(commonShow, DECK[\"moss\"]), (deforShow, DECK[\"orange\"])]):\n",
    "    # Iterate over this sequence\n",
    "    for ax, l in zip(axes[row], show):\n",
    "        # Conditional branch\n",
    "        if l not in Leda:\n",
    "            # Draw or configure plot elements\n",
    "            ax.axis(\"off\"); continue\n",
    "        # Set `i` = pick_chip(l)\n",
    "        i = pick_chip(l)\n",
    "        # Draw or configure plot elements\n",
    "        ax.imshow(natural_rgb(Xeda[i]))\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xticks([]); ax.set_yticks([])\n",
    "        # Iterate over this sequence\n",
    "        for sp in ax.spines.values():\n",
    "            # Run this pipeline step\n",
    "            sp.set_visible(False)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_title(nice_name(l), color=col, fontsize=18, fontweight=\"bold\", pad=8)\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_xlabel(\" · \".join(nice_name(t) if t != \"primary\" else \"primary\" for t in tags_of(i).split()),\n",
    "                      # Keyword/field `color`\n",
    "                      color=DECK[\"muted\"], fontsize=11, labelpad=6)\n",
    "        # Print status / metrics to the notebook\n",
    "        print(f\"{l:<20} chip {i}\")\n",
    "# Run this pipeline step\n",
    "fig.tight_layout(h_pad=2.5)\n",
    "# Save, show, and close the figure\n",
    "save_eda(fig, \"deck_02_example_chips.png\"); plt.show(); plt.close()\n",
    "\n",
    "# Define function `browse_label`\n",
    "def browse_label(label, n=12, seed=0):\n",
    "    # Set `cand` = candidates(label)\n",
    "    cand = candidates(label)\n",
    "    # Set `show` = np.random.RandomState(seed).choice(cand, min(n, len(cand)...\n",
    "    show = np.random.RandomState(seed).choice(cand, min(n, len(cand)), replace=False)\n",
    "    # Assign `fig, axes` ← plt.subplots(2, 6, figsize=(16, 6))\n",
    "    fig, axes = plt.subplots(2, 6, figsize=(16, 6))\n",
    "    # Iterate over this sequence\n",
    "    for ax, i in zip(axes.ravel(), show):\n",
    "        # Draw or configure plot elements\n",
    "        ax.imshow(natural_rgb(Xeda[i])); ax.set_xticks([]); ax.set_yticks([])\n",
    "        # Draw or configure plot elements\n",
    "        ax.set_title(f\"chip {i}\", fontsize=12, color=DECK[\"text\"])\n",
    "    # Iterate over this sequence\n",
    "    for ax in axes.ravel()[len(show):]:\n",
    "        # Draw or configure plot elements\n",
    "        ax.axis(\"off\")\n",
    "    # Run this pipeline step\n",
    "    fig.suptitle(f\"{nice_name(label)}: {len(cand)} candidates\", color=DECK[\"text\"])\n",
    "    # Render and close the figure\n",
    "    fig.tight_layout(); plt.show(); plt.close()\n"
   ]
