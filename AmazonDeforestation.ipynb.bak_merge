   "outputs": [],
   "source": [
    "# Define function `gradcam`\n",
    "def gradcam(model, x, labelJ):\n",
    "    # Set `acts, grads` = [], []\n",
    "    acts, grads = [], []\n",
    "    # Define function `save_act`\n",
    "    def save_act(mod, inp, out):\n",
    "        # Run this pipeline step\n",
    "        acts.append(out)\n",
    "        # Run this pipeline step\n",
    "        out.register_hook(lambda g: grads.append(g))\n",
    "    # Set `h` = model.layer4.register_forward_hook(save_act)\n",
    "    h = model.layer4.register_forward_hook(save_act)\n",
    "    # Reset gradients before the next step\n",
    "    model.zero_grad()\n",
    "    # Set `out` = model(x)\n",
    "    out = model(x)\n",
    "    # Backpropagate loss gradients\n",
    "    out[0, labelJ].backward()\n",
    "    # Run this pipeline step\n",
    "    h.remove()\n",
    "    # Set `w` = grads[0].mean((2, 3), keepdim=True)\n",
    "    w = grads[0].mean((2, 3), keepdim=True)\n",
    "    # Set `cam` = F.relu((w * acts[0]).sum(1, keepdim=True))\n",
    "    cam = F.relu((w * acts[0]).sum(1, keepdim=True))\n",
    "    # Set `cam` = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=F…\n",
    "    cam = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=False)[0, 0]\n",
    "    # Set `cam` = cam - cam.min()\n",
    "    cam = cam - cam.min()\n",
    "    # Return result to caller\n",
    "    return (cam / (cam.max() + 1e-8)).detach().cpu().numpy()\n",
    "\n",
    "# Define function `prep`\n",
    "def prep(gi, n):\n",
    "    # Set `ch` = expChans[n]\n",
    "    ch = expChans[n]\n",
    "    # Set `x` = torch.from_numpy(np.asarray(xAll[gi])[ch].astype(np.float32))[None].to…\n",
    "    x = torch.from_numpy(np.asarray(xAll[gi])[ch].astype(np.float32))[None].to(device)\n",
    "    # Set `mean` = torch.tensor(chanMean[ch], device=device).view(1, -1, 1, 1).float()\n",
    "    mean = torch.tensor(chanMean[ch], device=device).view(1, -1, 1, 1).float()\n",
    "    # Set `std` = torch.tensor(chanStd[ch], device=device).view(1, -1, 1, 1).float()\n",
    "    std = torch.tensor(chanStd[ch], device=device).view(1, -1, 1, 1).float()\n",
    "    # Return result to caller\n",
    "    return (x - mean) / std\n",
    "\n",
    "# Define function `rgb_view`\n",
    "def rgb_view(gi):\n",
    "    # Return result to caller\n",
    "    return np.clip(np.transpose(np.asarray(xAll[gi])[:3].astype(np.float32), (1, 2, 0)) ** 0.8, 0, 1)\n"
   ]
  },
