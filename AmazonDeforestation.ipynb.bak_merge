    "            rows.append({\"run\": n, \"family\": family(n),\n",
    "                         # Dict entry `\"val_defor_F2\"`\n",
    "                         \"val_defor_F2\": e[\"val\"][\"defor_F2\"], \"val_macro_F2\": e[\"val\"][\"macro_F2\"],\n",
    "                         # Dict entry `\"test_defor_F2\"`\n",
