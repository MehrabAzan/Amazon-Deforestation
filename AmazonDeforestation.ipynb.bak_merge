  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "2e149cc4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define function `best_thresholds`\n",
    "def best_thresholds(y, p, grid=np.arange(0.02, 0.81, 0.01)):\n",
    "    # Run this pipeline step\n",
    "    \"\"\"Per-label threshold that maximises F2 on the validation set.\"\"\"\n",
    "    # Set `thr` = np.zeros(y.shape[1])\n",
    "    thr = np.zeros(y.shape[1])\n",
    "    # Iterate over this sequence\n",
    "    for j in range(y.shape[1]):\n",
    "        # Set `pred` = p[:, j:j + 1] >= grid[None, :]\n",
    "        pred = p[:, j:j + 1] >= grid[None, :]\n",
    "        # Set `pos` = y[:, j:j + 1] == 1\n",
    "        pos = y[:, j:j + 1] == 1\n",
    "        # Set `tp` = (pred & pos).sum(0)\n",
    "        tp = (pred & pos).sum(0)\n",
    "        # Set `fp` = (pred & ~pos).sum(0)\n",
    "        fp = (pred & ~pos).sum(0)\n",
    "        # Set `fn` = (~pred & pos).sum(0)\n",
    "        fn = (~pred & pos).sum(0)\n",
    "        # Set `thr[j]` = grid[(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)).argmax()]\n",
    "        thr[j] = grid[(5 * tp / (5 * tp + 4 * fn + fp + 1e-9)).argmax()]\n",
    "    # Return result to caller\n",
    "    return thr\n",
    "\n",
    "# Define function `f2_per_label`\n",
    "def f2_per_label(y, pred):\n",
    "    # Set `tp` = (pred & (y == 1)).sum(0)\n",
    "    tp = (pred & (y == 1)).sum(0)\n",
    "    # Set `fp` = (pred & (y == 0)).sum(0)\n",
    "    fp = (pred & (y == 0)).sum(0)\n",
    "    # Set `fn` = (~pred & (y == 1)).sum(0)\n",
    "    fn = (~pred & (y == 1)).sum(0)\n",
    "    # Return result to caller\n",
    "    return 5 * tp / (5 * tp + 4 * fn + fp + 1e-9)\n",
    "\n",
    "# Define function `metrics`\n",
    "def metrics(y, pred):\n",
    "    # Set `rec` = recall_score(y, pred.astype(int), average=None, zero_division=0)\n",
    "    rec = recall_score(y, pred.astype(int), average=None, zero_division=0)\n",
    "    # Return result to caller\n",
    "    return {\n",
    "        # Dict entry for key `\"macro_F2\"`\n",
    "        \"macro_F2\": fbeta_score(y, pred, beta=2, average=\"macro\", zero_division=0),\n",
    "        # String entry in this collection\n",
    "        \"samples_F2 (Kaggle metric)\": fbeta_score(y, pred, beta=2, average=\"samples\",\n",
    "                                                  # Keyword/field `zero_division`\n",
    "                                                  zero_division=0),\n",
    "        # Dict entry for key `\"micro_F2\"`\n",
    "        \"micro_F2\": fbeta_score(y, pred, beta=2, average=\"micro\", zero_division=0),\n",
    "        # Dict entry for key `\"hamming_loss\"`\n",
    "        \"hamming_loss\": hamming_loss(y, pred),\n",
    "        # Dict entry for key `\"rare_recall_mean\"`\n",
    "        \"rare_recall_mean\": float(rec[rareIdx].mean()) if rareIdx else float(\"nan\"),\n",
    "        # Unpack / splat argument\n",
    "        **{f\"recall_{l}\": float(rec[labels.index(l)]) for l in rare},\n",
    "    }\n"
   ]
  },
