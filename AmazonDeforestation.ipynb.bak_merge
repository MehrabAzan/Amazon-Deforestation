    "tiles = []\n",
    "# Iterate over this sequence\n",
    "for _ in range(8 * 5):\n",
    "    # Set `pool` = agri if rng.rand() < 0.45 else prim\n",
    "    pool = agri if rng.rand() < 0.45 else prim\n",
    "    # OpenCV image operation\n",
    "    tiles.append(cv2.resize(rgb(read_image(names[int(rng.choice(pool))])), (chipSize, chipSize)))\n",
    "# Set `rows` = [np.concatenate(tiles[r * 8:(r + 1) * 8], 1) for r in range(5)]\n",
    "rows = [np.concatenate(tiles[r * 8:(r + 1) * 8], 1) for r in range(5)]\n",
    "# Set `mosaic` = np.concatenate(rows, 0)[:900]\n",
    "mosaic = np.concatenate(rows, 0)[:900]\n",
    "# OpenCV image operation\n",
    "cv2.imwrite(f\"{out}/real_mosaic.png\", cv2.cvtColor(mosaic, cv2.COLOR_RGB2BGR))\n"
