    "# Mean NDVI by label (EDA §10) — informative only when TIF/NIR cache is real\n",
    "# Detect JPG placeholder mode from cache meta\n",
    "metaEda = json.load(open(f\"{edaCache}/cache_meta.json\")) if os.path.exists(f\"{edaCache}/cache_meta.json\") else {}\n",
    "# If-branch\n",
    "if metaEda.get(\"jpg_mode\"):\n",
    "    # Log to notebook output\n",
    "    print(\"JPG cache: NIR/NDVI are placeholders — skipping NDVI-by-label figure.\")\n",
    "# Else branch\n",
    "else:\n",
    "    # Average NDVI per chip from channel 4 (stored as 0–1)\n",
    "    meanNdvi = np.empty(Neda, dtype=np.float32)\n",
    "    # Loop over items\n",
    "    for s in range(0, Neda, 2000):\n",
    "        # Assign `meanNdvi[s:s + 2000]` ← np.asarray(Xeda[s:s + 2000, 4], dtype=np.float32).mean((1, 2)) * …\n",
    "        meanNdvi[s:s + 2000] = np.asarray(Xeda[s:s + 2000, 4], dtype=np.float32).mean((1, 2)) * 2 - 1\n",
    "    # Order labels by median NDVI\n",
    "    byLabel = sorted(labelsEda, key=lambda l: np.median(meanNdvi[Yeda[:, Leda[l]] == 1]))\n",
    "    # Assign `fig, ax` ← plt.subplots(figsize=(12, 5.5))\n",
    "    fig, ax = plt.subplots(figsize=(12, 5.5))\n",
    "    # Assign `bp` ← ax.boxplot([meanNdvi[Yeda[:, Leda[l]] == 1] for l in byLabel], sh…\n",
    "    bp = ax.boxplot([meanNdvi[Yeda[:, Leda[l]] == 1] for l in byLabel], showfliers=False, patch_artist=True, widths=0.6)\n",
    "    # Loop over items\n",
    "    for patch, l in zip(bp[\"boxes\"], byLabel):\n",
    "        # Execute: patch.set_facecolor(GROUP_COLOR[group_eda(l)]); patch.set_alpha(0.75)\n",
    "        patch.set_facecolor(GROUP_COLOR[group_eda(l)]); patch.set_alpha(0.75)\n",
    "    # Loop over items\n",
    "    for m in bp[\"medians\"]:\n",
    "        # Execute: m.set_color(\"black\")\n",
    "        m.set_color(\"black\")\n",
    "    # Assign `ax.set_xticks(range(1, len(byLabel) + 1)); ax.set_xticklabels(byLabel, rotation` ← 50, ha=\"right\")\n",
    "    ax.set_xticks(range(1, len(byLabel) + 1)); ax.set_xticklabels(byLabel, rotation=50, ha=\"right\")\n",
    "    # Assign `ax.set_ylabel(\"mean NDVI of the chip\"); ax.axhline(0, color` ← \"gray\", lw=0.8, ls=\"--\")\n",
    "    ax.set_ylabel(\"mean NDVI of the chip\"); ax.axhline(0, color=\"gray\", lw=0.8, ls=\"--\")\n",
    "    # Execute: ax.set_title(\"Average NDVI per chip, by label\")\n",
    "    ax.set_title(\"Average NDVI per chip, by label\")\n",
    "    # Execute: save_eda(fig, \"eda_ndvi_by_label.png\"); plt.show(); plt.close()\n",
    "    save_eda(fig, \"eda_ndvi_by_label.png\"); plt.show(); plt.close()\n"
   ]
