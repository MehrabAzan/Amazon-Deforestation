   "source": [
    "# Define function `probs_path`\n",
    "def probs_path(n):\n",
    "    # Set `p` = f\"{runs}/{n}_probs.npz\"\n",
    "    p = f\"{runs}/{n}_probs.npz\"\n",
    "    # Conditional branch\n",
    "    if os.path.exists(p):\n",
    "        # Return result to caller\n",
    "        return p, \"TIF run\"\n",
    "    # Set `q` = f\"{jpgRoot}/runs/{n}_probs.npz\"\n",
    "    q = f\"{jpgRoot}/runs/{n}_probs.npz\"\n",
    "    # Conditional branch\n",
    "    if allowJpgReuse and os.path.exists(q):\n",
    "        # Return result to caller\n",
    "        return q, \"reused from your JPG notebook run\"\n",
    "    # Return result to caller\n",
    "    return None, None\n",
    "\n",
    "# Set `expNames, src` = [], {}\n",
    "expNames, src = [], {}\n",
    "# Iterate over this sequence\n",
    "for key in \"ABCDEF\":\n",
    "    # Set `n` = EXPS[key][0]\n",
    "    n = EXPS[key][0]\n",
    "    # Set `p, how` = probs_path(n)\n",
    "    p, how = probs_path(n)\n",
    "    # Conditional branch\n",
    "    if not p:\n",
    "        # Skip to next loop iteration\n",
    "        continue\n",
    "    # Load NumPy array (often memory-mapped)\n",
    "    d = np.load(p)\n",
    "    # Conditional branch\n",
    "    if len(d[\"test_idx\"]) != len(te) or not (d[\"test_idx\"] == te).all():\n",
    "        # Print status / metrics to the notebook\n",
    "        say(f\"NOTE: {n} from {how} uses a different test split; skipped.\")\n",
    "        # Skip to next loop iteration\n",
    "        continue\n",
    "    # Run this pipeline step\n",
    "    expNames.append(n)\n",
    "    # Set `src[n]` = how\n",
    "    src[n] = how\n",
    "# Print status / metrics to the notebook\n",
    "say(\"Experiments evaluated:\", {n: src[n] for n in expNames})\n",
    "# Conditional branch\n",
    "if not expNames:\n",
    "    # Stop with an error when setup/data is invalid\n",
    "    raise SystemExit(\n",
    "        # String entry in this collection\n",
    "        \"No trained experiments found to evaluate. \"\n",
    "        # String entry in this collection\n",
    "        \"Set exps = [\\\"A\\\", \\\"B\\\", \\\"C\\\", \\\"D\\\", \\\"E\\\"] and retrain (allowJpgReuse stays False).\"\n",
    "    )\n",
    "\n",
    "# Set `rareNames` = [l for l in [\"artisinal_mine\", \"artisanal_mine\", \"conventional_mine\"\n",
    "rareNames = [l for l in [\"artisinal_mine\", \"artisanal_mine\", \"conventional_mine\",\n",
    "                         # Continuation of the multi-line expression\n",
    "                         \"selective_logging\", \"slash_burn\"] if l in labels]\n",
    "# Set `rare` = rareNames\n",
    "rare = rareNames\n",
    "# Set `rareIdx` = [labels.index(l) for l in rare]\n",
    "rareIdx = [labels.index(l) for l in rare]\n",
    "\n",
    "# Set `res, store` = {}, {}\n",
    "res, store = {}, {}\n",
    "# Iterate over this sequence\n",
    "for n in expNames:\n",
    "    # Load NumPy array (often memory-mapped)\n",
    "    d = np.load(probs_path(n)[0])\n",
    "    # Set `thr` = best_thresholds(d[\"val_y\"], d[\"val_probs\"])\n",
    "    thr = best_thresholds(d[\"val_y\"], d[\"val_probs\"])\n",
    "    # Set `pred` = d[\"test_probs\"] >= thr[None, :]\n",
    "    pred = d[\"test_probs\"] >= thr[None, :]\n",
    "    # Set `res[n]` = metrics(d[\"test_y\"], pred)\n",
    "    res[n] = metrics(d[\"test_y\"], pred)\n",
    "    # Set `store[n]` = dict(y=d[\"test_y\"], pred=pred, probs=d[\"test_probs\"], thr=thr)\n",
    "    store[n] = dict(y=d[\"test_y\"], pred=pred, probs=d[\"test_probs\"], thr=thr)\n",
    "    # Write JSON metadata to disk\n",
    "    json.dump(dict(zip(labels, thr.tolist())), open(f\"{runs}/thresholds_{n}.json\", \"w\"))\n",
    "# Set `table` = pd.DataFrame(res).T\n",
    "table = pd.DataFrame(res).T\n",
    "# Export a metrics/label table as CSV\n",
    "table.to_csv(f\"{figDir}/results_table.csv\")\n",
    "# Print status / metrics to the notebook\n",
    "say(\"\\n===== RESULTS TABLE (test set) =====\")\n",
    "# Print status / metrics to the notebook\n",
    "say(table.round(4).to_string())\n",
    "\n",
    "# Fix RNG seed for reproducibility\n",
    "rng = np.random.RandomState(0)\n",
    "# Set `pairs` = [\n",
    "pairs = [\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"A_scratch_rgb\", \"B_scratch_nir_ndvi\", \"NDVI effect, scratch CNN (B - A)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"C_resnet_rgb\", \"D_resnet_nir_ndvi\", \"NDVI effect, ResNet (D - C)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"A_scratch_rgb\", \"C_resnet_rgb\", \"Transfer learning, RGB (C - A)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"B_scratch_nir_ndvi\", \"D_resnet_nir_ndvi\", \"Transfer learning, +NDVI (D - B)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"C_resnet_rgb\", \"E_resnet_nir\", \"NIR effect, ResNet (E - C)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"E_resnet_nir\", \"D_resnet_nir_ndvi\", \"NDVI on top of NIR, ResNet (D - E)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"A_scratch_rgb\", \"F_scratch_nir\", \"NIR effect, scratch CNN (F - A)\"),\n",
    "    # Continuation of the multi-line expression\n",
    "    (\"F_scratch_nir\", \"B_scratch_nir_ndvi\", \"NDVI on top of NIR, scratch CNN (B - F)\"),\n",
    "]\n",
    "# Set `rows` = []\n",
    "rows = []\n",
    "# Iterate over this sequence\n",
    "for a, b, lab in pairs:\n",
    "    # Conditional branch\n",
    "    if a in store and b in store:\n",
    "        # Set `m, lo_, hi_` = boot_diff(a, b)\n",
    "        m, lo_, hi_ = boot_diff(a, b)\n",
    "        # Run this pipeline step\n",
    "        rows.append(dict(\n",
    "            # Keyword/field `comparison`\n",
    "            comparison=lab, mean_macro_F2_diff=m, ci_low=lo_, ci_high=hi_,\n",
    "            # Keyword/field `verdict`\n",
    "            verdict=\"clear gain\" if lo_ > 0 else (\"clear loss\" if hi_ < 0 else \"not significant\")))\n",
    "# Set `boot` = pd.DataFrame(rows)\n",
    "boot = pd.DataFrame(rows)\n",
    "# Conditional branch\n",
    "if len(boot):\n",
    "    # Export a metrics/label table as CSV\n",
    "    boot.to_csv(f\"{figDir}/bootstrap_differences.csv\", index=False)\n",
    "    # Print status / metrics to the notebook\n",
    "    say(\"\\n===== BOOTSTRAP (1000 resamples, macro F2 difference) =====\")\n",
    "    # Print status / metrics to the notebook\n",
    "    say(boot.round(4).to_string(index=False))\n",
    "\n",
    "# Print status / metrics to the notebook\n",
    "say(\"\\n===== PER-LABEL F2 (test) =====\")\n",
    "# Set `pl` = pd.DataFrame({n: f2_per_label(store[n][\"y\"], store[n][\"pred\"]) for n i…\n",
    "pl = pd.DataFrame({n: f2_per_label(store[n][\"y\"], store[n][\"pred\"]) for n in expNames}, index=labels)\n",
    "# Export a metrics/label table as CSV\n",
    "pl.to_csv(f\"{figDir}/per_label_f2_all.csv\")\n",
    "# Print status / metrics to the notebook\n",
    "say(pl.round(3).to_string())\n",
    "\n",
    "# Print status / metrics to the notebook\n",
    "say(\"\\n===== ERROR BY WEATHER (share of the 17 labels predicted wrong) =====\")\n",
    "# Set `wx` = [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in label…\n",
    "wx = [w for w in [\"clear\", \"partly_cloudy\", \"haze\", \"cloudy\"] if w in labels]\n",
    "# Set `wrows` = []\n",
    "wrows = []\n",
    "# Iterate over this sequence\n",
    "for n in expNames:\n",
    "    # Set `wrong` = (store[n][\"pred\"].astype(int) != store[n][\"y\"]).mean(1)\n",
    "    wrong = (store[n][\"pred\"].astype(int) != store[n][\"y\"]).mean(1)\n",
    "    # Iterate over this sequence\n",
    "    for w in wx:\n",
    "        # Set `m` = store[n][\"y\"][:, labels.index(w)] == 1\n",
    "        m = store[n][\"y\"][:, labels.index(w)] == 1\n",
    "        # Set `wrows.append(dict(model` = n, weather=w, tiles=int(m.sum())\n",
    "        wrows.append(dict(model=n, weather=w, tiles=int(m.sum()),\n",
    "                          # Keyword/field `mean_label_error`\n",
    "                          mean_label_error=float(wrong[m].mean())))\n",
    "# Set `werr` = pd.DataFrame(wrows)\n",
    "werr = pd.DataFrame(wrows)\n",
    "# Export a metrics/label table as CSV\n",
    "werr.to_csv(f\"{figDir}/error_by_weather.csv\", index=False)\n",
    "# Conditional branch\n",
    "if len(wx):\n",
    "    # Print status / metrics to the notebook\n",
    "    say(werr.pivot(index=\"weather\", columns=\"model\", values=\"mean_label_error\").loc[wx].round(4).to_string())\n",
    "\n",
    "# Set `mixed` = any(\"reused\" in v for v in src.values())\n",
    "mixed = any(\"reused\" in v for v in src.values())\n",
    "# Write JSON metadata to disk\n",
    "json.dump({\n",
    "    # Dict entry for key `\"sources\"`\n",
    "    \"sources\": src,\n",
    "    # Dict entry for key `\"results\"`\n",
    "    \"results\": table.round(4).to_dict(orient=\"index\"),\n",
    "    # Dict entry for key `\"bootstrap\"`\n",
    "    \"bootstrap\": boot.round(4).to_dict(orient=\"records\") if len(boot) else [],\n",
    "    # Dict entry for key `\"per_label_f2\"`\n",
    "    \"per_label_f2\": pl.round(4).to_dict(),\n",
    "    # Dict entry for key `\"error_by_weather\"`\n",
    "    \"error_by_weather\": werr.round(4).to_dict(orient=\"records\"),\n",
    "    # Dict entry for key `\"thresholds\"`\n",
    "    \"thresholds\": {n: dict(zip(labels, store[n][\"thr\"].round(2).tolist())) for n in expNames},\n",
    "# Keyword/field `}, open(f\"{root}/results.json\", \"w\"), indent`\n",
    "}, open(f\"{root}/results.json\", \"w\"), indent=1)\n",
    "# Enter a context manager (auto-closes resources)\n",
    "with open(f\"{root}/results_to_paste.txt\", \"w\") as f:\n",
    "    # Run this pipeline step\n",
    "    f.write(\"\\n\".join(LOG))\n",
    "    # Conditional branch\n",
    "    if mixed:\n",
    "        # Run this pipeline step\n",
    "        f.write(\n",
    "            # String entry in this collection\n",
    "            \"\\n\\nNOTE: some rows were reused from the JPG notebook run, so the RGB source differs \"\n",
    "            # String entry in this collection\n",
    "            \"from the TIF-based rows. For the cleanest comparison keep allowJpgReuse = False \"\n",
    "            # Continuation of the multi-line expression\n",
    "            \"and train A/C/E on this TIF cache.\\n\")\n"
   ]
  },
